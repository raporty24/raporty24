---
const realizations = [
  {
    title: "KSeF Exporter Pro",
    label: "KSeF / księgowość",
    description:
      "Lokalna aplikacja do pobierania faktur z KSeF, podglądu pozycji i eksportu danych do Excel, CSV oraz XML.",
    icon: "fas fa-file-invoice",
    href: "/realizacje/#ksef-exporter-pro",
  },
  {
    title: "System planowania tras",
    label: "Logistyka / flota",
    description:
      "Narzędzie dobierające trasę według masy, wysokości i wymiarów pojazdu oraz ograniczeń drogowych.",
    icon: "fas fa-route",
    href: "/realizacje/#system-planowania-tras",
  },
  {
    title: "Kalkulatory produktowe",
    label: "Sprzedaż / zamówienia",
    description:
      "Kalkulatory ofertowe i zamówieniowe dla handlowców oraz klientów B2B: warianty, ilości, dodatki i cena.",
    icon: "fas fa-calculator",
    href: "/realizacje/#kalkulatory-produktowe",
  },
  {
    title: "Skrypty Python i API",
    label: "Automatyzacja / integracje",
    description:
      "Skrypty do przetwarzania plików, pobierania danych, eksportów, integracji API i prostych aplikacji dla firm.",
    icon: "fas fa-code",
    href: "/realizacje/#skrypty-python-api",
  },
];
---

<section
  id="realizacje-home"
  class="relative overflow-hidden bg-slate-950 py-24 text-white"
>
  <div class="absolute inset-0 opacity-20">
    <div
      class="absolute inset-0 bg-[radial-gradient(#1e293b_1.5px,transparent_1.5px)] [background-size:32px_32px]"
    >
    </div>
  </div>

  <div class="absolute -right-24 top-0 h-96 w-96 rounded-full bg-green-600/10 blur-[120px]"></div>
  <div class="absolute -left-24 bottom-0 h-96 w-96 rounded-full bg-cyan-500/10 blur-[120px]"></div>

  <div class="container relative z-10 mx-auto px-4">
    <div class="mb-14 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <span class="mb-4 inline-block text-xs font-black uppercase tracking-[0.25em] text-green-400">
          Realizacje
        </span>

        <h2 class="mb-6 text-4xl font-black uppercase tracking-tighter text-white md:text-6xl">
          Przykłady narzędzi, które tworzymy
        </h2>

        <p class="text-lg font-medium leading-relaxed text-slate-400 md:text-xl">
          Nie pokazujemy danych klientów, ale pokazujemy typy problemów, które rozwiązujemy:
          KSeF, planowanie tras, kalkulatory ofertowe, automatyzacje raportów, Python,
          API, Excel i Power BI.
        </p>
      </div>

      <a
        href="/realizacje/"
        class="inline-flex w-fit items-center gap-3 rounded-2xl bg-white px-8 py-4 text-sm font-black uppercase tracking-widest text-slate-950 transition-all hover:-translate-y-1 hover:bg-green-500 hover:text-white"
      >
        Zobacz wszystkie realizacje
        <i class="fas fa-arrow-right text-xs"></i>
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        realizations.map((item) => (
          <a
            href={item.href}
            class="group flex min-h-[330px] flex-col rounded-[2rem] border border-white/10 bg-white/[0.04] p-7 transition-all hover:-translate-y-1 hover:border-green-500/50 hover:bg-white/[0.08] hover:shadow-2xl hover:shadow-green-950/30"
          >
            <div class="mb-7 flex h-14 w-14 items-center justify-center rounded-2xl bg-green-500/10 text-green-400 transition-all group-hover:bg-green-600 group-hover:text-white">
              <i class={`${item.icon} text-xl`}></i>
            </div>

            <div class="mb-3 text-[10px] font-black uppercase tracking-[0.25em] text-green-400">
              {item.label}
            </div>

            <h3 class="mb-4 text-2xl font-black uppercase leading-tight tracking-tight text-white">
              {item.title}
            </h3>

            <p class="mb-8 flex-1 text-sm font-medium leading-relaxed text-slate-400">
              {item.description}
            </p>

            <span class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-white transition-colors group-hover:text-green-400">
              Zobacz przykład
              <i class="fas fa-chevron-right text-[10px]"></i>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>