---
// src/components/Panels.astro
const services = [
  {
    title: "Excel na zamówienie",
    description:
      "Automatyzacje Excel, makra VBA, Power Query, kalkulatory, formularze i pliki, które zastępują ręczne kopiowanie danych.",
    icon: "fas fa-file-excel",
    href: "/uslugi/excel-na-zamowienie/",
    tags: ["Excel", "VBA", "Power Query"],
    dark: false,
  },
  {
    title: "Dashboardy Power BI",
    description:
      "Raporty zarządcze, KPI, sprzedaż, koszty, flota i wyniki firmy w czytelnych dashboardach Power BI.",
    icon: "fas fa-chart-pie",
    href: "/uslugi/dashboardy-power-bi/",
    tags: ["Power BI", "KPI", "DAX"],
    dark: false,
  },
  {
    title: "KSeF do Excela",
    description:
      "Narzędzia do pobierania faktur z KSeF, eksportu danych do Excel, CSV i XML oraz porządkowania dokumentów dla księgowości.",
    icon: "fas fa-file-invoice",
    href: "/realizacje/#ksef-exporter-pro",
    tags: ["KSeF", "Excel", "CSV / XML"],
    dark: true,
  },
  {
    title: "Kalkulatory ofertowe",
    description:
      "Kalkulatory produktowe i zamówieniowe dla firm: warianty, ilości, dodatki, cena, podsumowanie i gotowe dane do wyceny.",
    icon: "fas fa-calculator",
   href: "/uslugi/kalkulatory-produktowe/",
    tags: ["Oferty", "B2B", "Wycena"],
    dark: false,
  },
  {
    title: "Logistyka w Excelu",
    description:
      "Planowanie tras, flota, koszty transportu, raporty operacyjne i narzędzia wspierające codzienną pracę logistyki.",
    icon: "fas fa-route",
    href: "/uslugi/logistyka-w-excelu/",
    tags: ["Trasy", "Flota", "Transport"],
    dark: false,
  },
  {
    title: "Python, API i aplikacje",
    description:
      "Skrypty Python, integracje API, przetwarzanie plików, eksporty danych i proste aplikacje desktopowe dla firm.",
    icon: "fas fa-code",
    href: "/uslugi/skrypty-python/",
    tags: ["Python", "API", "Desktop"],
    dark: true,
  },
];
---

<section id="oferta" class="bg-white py-24 text-slate-950">
  <div class="container mx-auto px-4">
    <header class="mb-16 max-w-4xl lg:mb-20">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-green-500/20 bg-green-500/10 px-3 py-1"
      >
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-green-600">
          Usługi
        </span>
      </div>

      <h2 class="mb-8 text-4xl font-black leading-tight tracking-tighter text-slate-900 lg:text-6xl">
        Automatyzacje, które zdejmują z firmy
        <span class="text-green-600">ręczną pracę.</span>
      </h2>

      <p class="max-w-3xl text-xl leading-relaxed text-slate-600">
        Tworzymy rozwiązania w Excelu, Power BI, Pythonie i API: od prostych
        automatyzacji po aplikacje desktopowe, kalkulatory ofertowe i narzędzia
        do pracy z KSeF.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
      {
        services.map((service) => (
          <a
            href={service.href}
            class={`group flex min-h-[360px] flex-col rounded-[2.5rem] border-2 p-9 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl ${
              service.dark
                ? "border-slate-800 bg-slate-950 text-white shadow-slate-900/30 hover:border-green-500/40"
                : "border-slate-100 bg-slate-50 text-slate-950 hover:border-green-500/30 hover:bg-white"
            }`}
          >
            <div
              class={`mb-8 flex h-16 w-16 items-center justify-center rounded-2xl shadow-sm transition-transform group-hover:scale-110 ${
                service.dark ? "bg-green-500/10 text-green-400" : "bg-white text-green-600"
              }`}
            >
              <i class={`${service.icon} text-3xl`}></i>
            </div>

            <h3
              class={`mb-4 text-2xl font-black uppercase tracking-tighter ${
                service.dark ? "text-white" : "text-slate-900"
              }`}
            >
              {service.title}
            </h3>

            <p
              class={`mb-8 flex-1 text-base leading-relaxed ${
                service.dark ? "text-slate-400" : "text-slate-600"
              }`}
            >
              {service.description}
            </p>

            <div class="mb-8 flex flex-wrap gap-2">
              {
                service.tags.map((tag) => (
                  <span
                    class={`rounded-lg border px-3 py-1 text-[10px] font-black uppercase tracking-widest ${
                      service.dark
                        ? "border-white/10 bg-white/5 text-slate-300"
                        : "border-slate-200 bg-white text-slate-500"
                    }`}
                  >
                    {tag}
                  </span>
                ))
              }
            </div>

            <span
              class={`inline-flex items-center gap-3 text-xs font-black uppercase tracking-widest transition-colors ${
                service.dark
                  ? "text-white group-hover:text-green-400"
                  : "text-slate-950 group-hover:text-green-600"
              }`}
            >
              Zobacz więcej
              <i class="fas fa-chevron-right text-[10px]"></i>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    content-visibility: auto;
    contain-intrinsic-size: 1px 1000px;
  }
</style>