---
// Header.astro
// Raporty24 - uporządkowana architektura usług
// Menu pokazuje najważniejsze money pages.
// Wszystkie pozostałe usługi nadal są dostępne przez /uslugi/.

const currentPath = Astro.url.pathname;

type MenuLink = {
  title: string;
  href: string;
  description?: string;
};

type ServiceGroup = {
  title: string;
  description: string;
  links: MenuLink[];
};

const serviceGroups: ServiceGroup[] = [
  {
    title: "Excel i automatyzacja",
    description: "Narzędzia, arkusze i automatyzacja pracy w Excelu.",
    links: [
      {
        title: "Excel na zamówienie",
        href: "/uslugi/excel-na-zamowienie/",
      },
      {
        title: "Power Query",
        href: "/uslugi/automatyzacja-excel-power-query/",
      },
      {
        title: "Makra VBA",
        href: "/uslugi/makra-vba/",
      },
      {
        title: "Optymalizacja Excela",
        href: "/uslugi/optymalizacja-excela/",
      },
    ],
  },

  {
    title: "Raportowanie i BI",
    description: "Automatyczne raporty, KPI i analiza danych.",
    links: [
      {
        title: "Raporty miesięczne",
        href: "/uslugi/raporty-miesieczne-automatyczne/",
      },
      {
        title: "Power BI dla firm",
        href: "/uslugi/power-bi-dla-firm/",
      },
      {
        title: "Dashboardy Power BI",
        href: "/uslugi/dashboardy-power-bi/",
      },
    ],
  },

  {
    title: "Integracje i dane",
    description: "Łączenie systemów i eliminowanie ręcznego przepisywania.",
    links: [
      {
        title: "Integracje API",
        href: "/uslugi/integracje-api/",
      },
      {
        title: "E-mail → Excel",
        href: "/uslugi/pobieranie-email-do-excela/",
      },
      {
  title: "Automatyzacja plików i procesów",
  href: "/uslugi/skrypty-python/",
},
    ],
  },

  {
    title: "Procesy biznesowe",
    description: "Narzędzia rozwiązujące konkretne problemy firmy.",
    links: [
      {
        title: "Baza klientów",
        href: "/uslugi/baza-klientow-w-excelu/",
      },
      {
        title: "CRM w Excelu",
        href: "/uslugi/crm-w-excelu/",
      },
      {
        title: "Logistyka i trasy",
        href: "/uslugi/logistyka-w-excelu/",
      },
      {
        title: "Kalkulatory produktowe",
        href: "/uslugi/kalkulatory-produktowe/",
      },
    ],
  },
];

const mainLinks: MenuLink[] = [
  {
    title: "Realizacje",
    href: "/realizacje/",
  },
  {
    title: "Cennik",
    href: "/cennik/",
  },
  {
    title: "Blog",
    href: "/blog/",
  },
  {
    title: "Stała opieka",
    href: "/subskrypcja/",
  },
];

function isActive(href: string) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
}

const servicesActive = currentPath.startsWith("/uslugi/");
---

<header
  class="fixed top-0 z-50 w-full border-b border-slate-200/60 bg-white/95 backdrop-blur-xl"
  x-data="{
    menuOpen: false,
    servicesOpen: false
  }"
  @keydown.escape.window="
    menuOpen = false;
    servicesOpen = false;
  "
>

  <!-- GŁÓWNA NAWIGACJA -->
  <nav
    class="container mx-auto flex items-center justify-between px-4 py-3 lg:py-4"
    aria-label="Główna nawigacja"
  >

    <!-- LOGO -->
    <a
      href="/"
      class="flex items-center gap-2 transition-transform hover:scale-[1.02]"
      aria-label="Raporty24 - strona główna"
    >
      <img
        src="/logo.webp"
        alt="Raporty24"
        width="160"
        height="40"
        class="w-32 md:w-40"
      />
    </a>


    <!-- DESKTOP -->
    <div
      class="hidden items-center gap-1 xl:flex"
      id="desktop-menu"
    >

      <!-- USŁUGI -->
      <div
        class="relative"
        @mouseenter="servicesOpen = true"
        @mouseleave="servicesOpen = false"
        @focusin="servicesOpen = true"
        @focusout="
          if (!$el.contains($event.relatedTarget)) {
            servicesOpen = false;
          }
        "
        @click.outside="servicesOpen = false"
      >

        <a
          href="/uslugi/"
          class:list={[
            "nav-link flex items-center gap-2",
            servicesActive && "text-green-600"
          ]}
          aria-haspopup="true"
          :aria-expanded="servicesOpen ? 'true' : 'false'"
          aria-controls="services-dropdown"
        >
          Usługi

          <i
            class="fas fa-chevron-down text-[8px] transition-transform"
            :class="servicesOpen ? 'rotate-180' : ''"
            aria-hidden="true"
          ></i>
        </a>


        <!-- MEGA MENU -->
        <div
          id="services-dropdown"
          x-show="servicesOpen"
          x-cloak
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-2"
          class="absolute left-1/2 top-full w-[920px] -translate-x-1/2 pt-4"
        >

          <div
            class="rounded-3xl border border-slate-200 bg-white p-7 shadow-2xl shadow-slate-900/10"
          >

            <!-- HEADER MENU -->
            <div
              class="mb-6 flex items-center justify-between border-b border-slate-100 pb-5"
            >

              <div>
                <p
                  class="text-xs font-black uppercase tracking-[0.16em] text-green-600"
                >
                  Automatyzacja procesów i danych
                </p>

                <p
                  class="mt-1 text-sm text-slate-500"
                >
                  Dobieramy technologię do konkretnego problemu firmy.
                </p>
              </div>

              <a
                href="/uslugi/"
                class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-slate-900 transition-colors hover:text-green-600"
              >
                Wszystkie usługi

                <i
                  class="fas fa-arrow-right text-[9px]"
                  aria-hidden="true"
                ></i>
              </a>

            </div>


            <!-- GRUPY -->
            <div
              class="grid grid-cols-4 gap-7"
            >

              {
                serviceGroups.map((group) => (
                  <div>

                    <h2
                      class="mb-2 text-sm font-black text-slate-900"
                    >
                      {group.title}
                    </h2>

                    <p
                      class="mb-4 min-h-[40px] text-xs leading-relaxed text-slate-400"
                    >
                      {group.description}
                    </p>

                    <div class="space-y-1">

                      {
                        group.links.map((service) => (
                          <a
                            href={service.href}
                            class:list={[
                              "service-menu-link",
                              isActive(service.href) &&
                                "bg-green-50 text-green-700"
                            ]}
                            aria-current={
                              isActive(service.href)
                                ? "page"
                                : undefined
                            }
                          >
                            {service.title}
                          </a>
                        ))
                      }

                    </div>

                  </div>
                ))
              }

            </div>


            <!-- DOLNY CTA -->
            <div
              class="mt-7 flex items-center justify-between rounded-2xl bg-slate-950 px-6 py-5 text-white"
            >

              <div>
                <p class="font-black">
                  Nie wiesz, jakiej technologii potrzebujesz?
                </p>

                <p
                  class="mt-1 text-xs text-slate-400"
                >
                  Opisz ręczną czynność lub proces, który chcesz usprawnić.
                </p>
              </div>

              <a
                href="/kontakt/"
                class="rounded-xl bg-green-600 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white transition-colors hover:bg-green-500"
              >
                Opisz problem
              </a>

            </div>

          </div>

        </div>
      </div>


      <!-- GŁÓWNE LINKI -->
      {
        mainLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              isActive(link.href) && "text-green-600"
            ]}
            aria-current={
              isActive(link.href)
                ? "page"
                : undefined
            }
          >
            {link.title}
          </a>
        ))
      }


      <!-- CTA -->
      <div
        class="ml-5 border-l border-slate-200 pl-5"
      >
        <a
          href="/kontakt/"
          class:list={[
            "green-btn-menu",
            isActive("/kontakt/") &&
              "ring-2 ring-green-300 ring-offset-2"
          ]}
        >
          Bezpłatna analiza
        </a>
      </div>

    </div>


    <!-- MOBILE BUTTON -->
    <button
      class="rounded-xl border border-slate-100 bg-slate-50 p-2 xl:hidden"
      type="button"
      @click="menuOpen = !menuOpen"
      :aria-expanded="menuOpen ? 'true' : 'false'"
      aria-controls="mobile-menu"
      aria-label="Otwórz lub zamknij menu"
    >

      <i
        class="fas fa-bars text-xl text-green-700"
        x-show="!menuOpen"
        aria-hidden="true"
      ></i>

      <i
        class="fas fa-times text-xl text-slate-500"
        x-show="menuOpen"
        x-cloak
        aria-hidden="true"
      ></i>

    </button>

  </nav>


  <!-- MOBILE MENU -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-[64px] max-h-[calc(100vh-64px)] overflow-y-auto border-t border-slate-100 bg-white shadow-2xl xl:hidden"
    x-show="menuOpen"
    x-cloak
    @click.outside="menuOpen = false"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
  >

    <nav
      class="flex flex-col p-5"
      aria-label="Nawigacja mobilna"
    >

      <!-- USŁUGI -->
      <div
        x-data="{ subMenuOpen: false }"
        class="border-b border-slate-100"
      >

        <button
          type="button"
          @click="subMenuOpen = !subMenuOpen"
          class:list={[
            "mobile-nav-link flex w-full items-center justify-between",
            servicesActive && "text-green-600"
          ]}
          :aria-expanded="subMenuOpen ? 'true' : 'false'"
        >

          <span>Usługi</span>

          <i
            class="fas fa-chevron-down text-xs transition-transform"
            :class="subMenuOpen ? 'rotate-180' : ''"
            aria-hidden="true"
          ></i>

        </button>


        <div
          x-show="subMenuOpen"
          x-cloak
          class="pb-4"
        >

          <a
            href="/uslugi/"
            class="mb-3 block rounded-xl bg-green-50 px-5 py-4 text-sm font-black text-green-700"
            @click="menuOpen = false"
          >
            Wszystkie usługi
          </a>


          {
            serviceGroups.map((group) => (
              <div class="mb-5">

                <p
                  class="mb-2 px-4 text-[10px] font-black uppercase tracking-[0.15em] text-slate-400"
                >
                  {group.title}
                </p>

                <div class="rounded-2xl bg-slate-50 py-1">

                  {
                    group.links.map((service) => (
                      <a
                        href={service.href}
                        class:list={[
                          "mobile-nav-sublink",
                          isActive(service.href) &&
                            "text-green-700"
                        ]}
                        aria-current={
                          isActive(service.href)
                            ? "page"
                            : undefined
                        }
                        @click="menuOpen = false"
                      >
                        {service.title}
                      </a>
                    ))
                  }

                </div>

              </div>
            ))
          }

        </div>
      </div>


      <!-- GŁÓWNE LINKI -->
      {
        mainLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "mobile-nav-link",
              isActive(link.href) && "text-green-600"
            ]}
            aria-current={
              isActive(link.href)
                ? "page"
                : undefined
            }
            @click="menuOpen = false"
          >
            {link.title}
          </a>
        ))
      }


      <!-- CTA MOBILE -->
      <div
        class="flex flex-col gap-3 pb-5 pt-7"
      >

        <a
          href="/kontakt/"
          class="rounded-2xl bg-green-600 py-4 text-center text-xs font-black uppercase tracking-widest text-white transition-colors hover:bg-green-500"
          @click="menuOpen = false"
        >
          Opisz problem
        </a>

        <a
          href="/realizacje/"
          class="rounded-2xl border border-slate-200 bg-white py-4 text-center text-xs font-black uppercase tracking-widest text-slate-700 transition-colors hover:border-slate-300"
          @click="menuOpen = false"
        >
          Zobacz realizacje
        </a>

      </div>

    </nav>

  </div>

</header>


<style>
  @reference "../styles/global.css";

  [x-cloak] {
    display: none !important;
  }

  .nav-link {
    @apply relative px-3 py-2 text-[11px] font-black uppercase tracking-widest text-slate-500 transition-all hover:text-green-600;
  }

  .service-menu-link {
    @apply block rounded-xl px-3 py-2.5 text-xs font-bold text-slate-600 transition-all hover:bg-green-50 hover:text-green-700;
  }

  .mobile-nav-link {
    @apply flex items-center border-b border-slate-100 px-3 py-4 text-sm font-bold text-slate-700 transition-colors hover:text-green-600;
  }

  .mobile-nav-sublink {
    @apply block px-5 py-3 text-sm font-bold text-slate-600 transition-colors hover:text-green-600;
  }

  .green-btn-menu {
    @apply rounded-full bg-green-600 px-6 py-3 text-[10px] font-black uppercase tracking-widest text-white transition-all hover:bg-green-500;
  }
</style>