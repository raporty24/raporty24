---
// src/components/Hero.astro
// Główny Hero Raporty24 - komunikacja oparta o efekt biznesowy

const {
  title = "AUTOMATYZACJA PROCESÓW I DANYCH DLA FIRM",
  highlight = "EXCEL • POWER BI • API • MICROSOFT 365",
} = Astro.props;
---

<section
  id="hero"
  class="relative flex min-h-[88vh] items-center overflow-hidden bg-slate-950 text-white"
>
  <!-- TŁO -->

  <div class="absolute inset-0 z-0 overflow-hidden">

    <div
      class="absolute inset-0 z-10 opacity-20"
      style="background-image: linear-gradient(#4ade8020 1px, transparent 1px), linear-gradient(90deg, #4ade8020 1px, transparent 1px); background-size: 80px 80px;"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0 z-20 overflow-hidden"
      aria-hidden="true"
    >
      <div class="scanner-line"></div>
    </div>

    <div
      class="absolute inset-0 z-0 opacity-30"
      style="background-image: radial-gradient(at 10% 20%, #16a34a 0px, transparent 65%), radial-gradient(at 80% 50%, #4ade8040 0px, transparent 60%); background-size: 100% 100%;"
    >
    </div>

  </div>


  <div
    class="absolute inset-0 z-10 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"
  >
  </div>


  <!-- TREŚĆ -->

  <div
    class="container relative z-20 mx-auto px-4 pt-20"
  >

    <div class="max-w-5xl">

      <!-- EYEBROW -->

      <div
        class="mb-10 inline-flex max-w-full flex-wrap items-center gap-2 rounded-full border border-white/10 bg-slate-900/70 px-4 py-2"
      >

        <span
          class="flex h-2.5 w-2.5 shrink-0 rounded-full bg-green-500 shadow-[0_0_15px_#22c55e] animate-pulse"
          aria-hidden="true"
        >
        </span>

        <span
          class="text-[10px] font-black uppercase tracking-[0.18em] text-green-400 sm:text-xs sm:tracking-[0.24em]"
        >
          {title}
        </span>

      </div>


      <!-- H1 -->

      <h1
        class="mb-10 max-w-5xl text-5xl font-black uppercase leading-[0.95] tracking-tighter md:text-7xl lg:text-8xl"
      >
        Mniej ręcznej pracy.
        <br />

        <span
          class="bg-gradient-to-r from-green-400 to-green-600 bg-clip-text text-transparent"
        >
          Więcej automatyzacji.
        </span>
      </h1>


      <!-- OPIS -->

      <p
        class="mb-10 max-w-3xl border-l-2 border-green-500/30 pl-6 text-lg leading-relaxed text-slate-300 sm:pl-8 md:text-2xl"
      >
        Automatyzujemy raportowanie, przepływ danych
        i powtarzalne procesy w firmach.
        Łączymy Excel, Power BI, API, SharePoint,
        pliki i systemy tak, aby ograniczyć ręczne kopiowanie,
        poprawianie i przygotowywanie danych.
      </p>


      <!-- TECHNOLOGIE JAKO DRUGI PLAN -->

      <div
        class="mb-12 flex flex-wrap gap-x-5 gap-y-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 sm:text-xs"
        aria-label="Przykładowe technologie"
      >

        {
          highlight.split(" • ").map((item) => (
            <span class="inline-flex items-center gap-2">
              <span
                class="h-1.5 w-1.5 rounded-full bg-green-500"
                aria-hidden="true"
              ></span>

              {item}
            </span>
          ))
        }

        <span class="inline-flex items-center gap-2">
          <span
            class="h-1.5 w-1.5 rounded-full bg-green-500"
            aria-hidden="true"
          ></span>

          DODATKI I APLIKACJE
        </span>

      </div>


      <!-- CTA -->

      <div
        class="flex flex-col gap-5 sm:flex-row"
      >

        <a
          href="/kontakt/#formularz"
          class="group flex items-center justify-center gap-3 rounded-2xl bg-green-600 px-10 py-5 text-center text-lg font-black tracking-tight text-white shadow-[0_20px_50px_rgba(34,197,94,0.3)] transition-all hover:-translate-y-1 hover:bg-green-500 sm:px-12 sm:py-6 sm:text-xl"
        >
          Opisz swój problem

          <i
            class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"
            aria-hidden="true"
          ></i>
        </a>


        <a
          href="/realizacje/"
          class="group flex items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/10 px-10 py-5 text-center text-lg font-black tracking-tight text-white transition-all hover:-translate-y-1 hover:bg-white hover:text-slate-950 sm:py-6"
        >
          Zobacz realizacje

          <i
            class="fas fa-laptop-code text-sm transition-transform group-hover:translate-x-1"
            aria-hidden="true"
          ></i>
        </a>

      </div>


      <!-- MAŁY KOMUNIKAT -->

      <p
        class="mt-6 text-sm leading-relaxed text-slate-500"
      >
        Od niewielkich usprawnień po większe automatyzacje i integracje.
        Nie musisz wiedzieć, jakiej technologii potrzebujesz.
      </p>

    </div>

  </div>

</section>


<style>
  .scanner-line {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 25;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      #22c55e,
      transparent
    );
    opacity: 0.5;
    animation: scan 8s linear infinite;
    will-change: transform;
  }

  @keyframes scan {
    0% {
      transform: translateY(-100px);
    }

    100% {
      transform: translateY(100vh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scanner-line {
      animation: none;
    }
  }
</style>