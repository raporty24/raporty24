---
// src/components/Hero.astro - skromny hero B2B
const {
  title = "DATA & AI CONSULTING",
  highlight = "EXCEL • POWER BI • PYTHON • API",
} = Astro.props;
---

<section
  id="hero"
  class="relative flex min-h-[88vh] items-center overflow-hidden bg-slate-950 text-white"
>
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div
      class="absolute inset-0 z-10 opacity-20"
      style="background-image: linear-gradient(#4ade8020 1px, transparent 1px), linear-gradient(90deg, #4ade8020 1px, transparent 1px); background-size: 80px 80px;"
    >
    </div>

    <div class="pointer-events-none absolute inset-0 z-20 overflow-hidden">
      <div class="scanner-line"></div>
    </div>

    <div
      class="absolute inset-0 z-0 opacity-30"
      style="background-image: radial-gradient(at 10% 20%, #16a34a 0px, transparent 65%), radial-gradient(at 80% 50%, #4ade8040 0px, transparent 60%); background-size: 100% 100%;"
    >
    </div>
  </div>

  <div class="absolute inset-0 z-10 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

  <div class="container relative z-20 mx-auto px-4 pt-20">
    <div class="max-w-5xl">
      <div
        class="mb-12 inline-flex items-center gap-3 rounded-full border border-white/10 bg-slate-900/50 px-4 py-2 backdrop-blur-sm"
      >
        <span class="flex h-3 w-3 rounded-full bg-green-500 shadow-[0_0_15px_#22c55e] animate-pulse">
        </span>

        <span class="text-xs font-black uppercase tracking-[0.3em] text-green-400">
          {title} • <span class="text-slate-300">{highlight}</span>
        </span>
      </div>

      <h1
        class="mb-10 max-w-5xl text-5xl font-black uppercase leading-[0.95] tracking-tighter md:text-8xl"
      >
        Zautomatyzuj dane. <br />
        Odzyskaj
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-green-600">
          czas w firmie.
        </span>
      </h1>

      <p
        class="mb-14 max-w-3xl border-l-2 border-green-500/30 pl-8 text-xl italic leading-relaxed text-slate-300 md:text-2xl"
      >
        Tworzymy automatyzacje Excel, dashboardy Power BI, skrypty Python i integracje API,
        które zastępują ręczne raportowanie i powtarzalną pracę z danymi.
      </p>

      <div class="flex flex-col gap-6 sm:flex-row">
        <a
          href="/kontakt/"
          class="group flex items-center justify-center gap-3 rounded-2xl bg-green-600 px-12 py-6 text-center text-xl font-black tracking-tight text-white shadow-[0_20px_50px_rgba(34,197,94,0.3)] transition-all hover:-translate-y-1 hover:bg-green-500"
        >
          Odbierz darmową wycenę
          <i class="fas fa-arrow-right text-sm transition-transform group-hover:translate-x-1"></i>
        </a>

        <a
          href="/realizacje/"
          class="group flex items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/10 px-10 py-6 text-center text-lg font-black tracking-tight text-white transition-all hover:-translate-y-1 hover:bg-white hover:text-slate-950"
        >
          Zobacz realizacje
          <i class="fas fa-laptop-code text-sm transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .scanner-line {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 25;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #22c55e, transparent);
    opacity: 0.5;
    animation: scan 8s linear infinite;
    will-change: transform;
  }

  @keyframes scan {
    0% {
      transform: translateY(-100px);
    }

    100% {
      transform: translateY(100vh);
    }
  }
</style>