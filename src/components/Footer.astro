---
// Footer.astro - Zoptymalizowany pod SEO i konwersję (Lokalizacja + Usługi)
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-white pt-24 pb-12 border-t border-white/5 relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-16 mb-20">

      <div class="lg:col-span-1">
        <div class="text-3xl font-black tracking-tighter mb-8 group cursor-default text-white">
          RAPORTY<span class="text-green-500">24</span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed mb-8 max-w-xs">
          <strong>Ekspert Excel i Power BI.</strong> Projektujemy systemy automatyzacji, które odzyskują Twój czas. Specjalizacja: <strong>makra VBA</strong>, dashboardy KPI i analityka AI.
        </p>

        <div class="flex gap-4">
          <a href="https://www.linkedin.com/in/raporty-raporty-50a8413a4/" target="_blank" rel="noopener" class="w-10 h-10 rounded-xl bg-white flex items-center justify-center hover:bg-[#0077b5] transition-all group" title="LinkedIn Raporty24">
            <i class="fab fa-linkedin-in text-slate-950 group-hover:text-white transition-colors"></i>
          </a>
          <a href="https://www.tiktok.com/@raporty24" target="_blank" rel="noopener" class="w-10 h-10 rounded-xl bg-white flex items-center justify-center hover:bg-[#ff0050] transition-all group" title="TikTok Raporty24">
            <i class="fab fa-tiktok text-slate-950 group-hover:text-white transition-colors"></i>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-black uppercase tracking-[0.3em] text-green-500 mb-8">Nasze Usługi</h4>
        <ul class="space-y-4 text-sm font-bold text-slate-400 uppercase tracking-widest">
          <li><a href="/uslugi/excel-na-zamowienie/" class="hover:text-white transition-colors underline decoration-transparent hover:decoration-green-500">Excel na zamówienie</a></li>
          <li><a href="/uslugi/dashboardy-power-bi/" class="hover:text-white transition-colors underline decoration-transparent hover:decoration-green-500">Dashboardy Power BI</a></li>
          <li><a href="/kontakt/" class="hover:text-white transition-colors underline decoration-transparent hover:decoration-green-500">Pisanie makr VBA</a></li>
          <li><a href="/kontakt/" class="hover:text-white transition-colors underline decoration-transparent hover:decoration-green-500">Pomoc w Excelu</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-black uppercase tracking-[0.3em] text-slate-500 mb-8">Nawigacja</h4>
        <ul class="space-y-4 text-sm font-bold text-slate-400 uppercase tracking-widest">
          <li><a href="/cennik/" class="hover:text-white transition-colors">Cennik usług</a></li>
          <li><a href="/kontakt/" class="hover:text-white transition-colors">Darmowa wycena</a></li>
          <li><a href="/subskrypcja/" class="hover:text-white transition-colors">Wsparcie SLA</a></li>
          <li><a href="/kontakt/" class="hover:text-white transition-colors text-green-500">Kontakt</a></li>
        </ul>
      </div>

      <div class="bg-slate-900 border border-slate-800 p-8 rounded-[2rem] relative group">
        <h4 class="font-black mb-4 text-white uppercase tracking-tight">Darmowy Audyt</h4>
        <p class="text-[11px] text-slate-500 mb-8 leading-relaxed">Podeślij nam swój plik lub screeny. W 24h zidentyfikujemy błędy i zaproponujemy model automatyzacji.</p>
        <a href="/kontakt/#formularz" class="bg-green-600 hover:bg-green-500 text-white block text-center py-4 rounded-xl font-black text-[11px] uppercase tracking-widest transition-all">
          Rozpocznij teraz
        </a>
      </div>
    </div>

    <div class="border-t border-white/5 pt-12 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="text-[10px] font-bold text-slate-600 uppercase tracking-[0.4em]">
        &copy; {currentYear} Raporty24. All rights reserved.
      </div>

      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
          <i class="fas fa-map-marker-alt text-green-500"></i>
          Obsługa zdalna: <span class="text-white">Polska, Niemcy, UK</span>
        </div>
        <div class="text-[10px] font-bold text-slate-600 uppercase tracking-widest">
          Siedziba: <span class="text-white">Katowice, Śląsk</span>
        </div>
      </div>
    </div>
  </div>
</footer>