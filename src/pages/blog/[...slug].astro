---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");

  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const currentUrl = `https://raporty24.pl/blog/${entry.slug}/`;

const formattedDate = entry.data.pubDate.toLocaleDateString("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const imageUrl = entry.data.image
  ? `https://raporty24.pl${entry.data.image}`
  : "https://raporty24.pl/biuro3.webp";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  image: imageUrl,
  datePublished: entry.data.pubDate.toISOString(),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": currentUrl,
  },
  author: {
    "@type": "Organization",
    name: "Raporty24",
    url: "https://raporty24.pl/",
  },
  publisher: {
    "@type": "Organization",
    name: "Raporty24",
    url: "https://raporty24.pl/",
  },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  url={currentUrl}
  structuredData={jsonLd}
>
  <Header />

  <main>

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section
      class="relative overflow-hidden bg-slate-950 pb-20 pt-24 text-white lg:pb-28 lg:pt-32"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_80%_20%,rgba(34,197,94,0.16),transparent_35%)]"
        aria-hidden="true"
      ></div>

      <div
        class="pointer-events-none absolute inset-0 opacity-[0.035] bg-[linear-gradient(rgba(255,255,255,.8)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.8)_1px,transparent_1px)] bg-[size:42px_42px]"
        aria-hidden="true"
      ></div>

      <div class="container relative z-10 mx-auto px-5">
        <div class="mx-auto max-w-4xl">

          <div class="mb-7 flex flex-wrap items-center gap-x-4 gap-y-3">

            <span
              class="inline-flex items-center rounded-full border border-green-500/30 bg-green-500/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-green-400"
            >
              {entry.data.category}
            </span>

            <span class="hidden text-slate-700 sm:inline">
              •
            </span>

            <time
              datetime={entry.data.pubDate.toISOString()}
              class="text-sm font-medium text-slate-400"
            >
              {formattedDate}
            </time>

          </div>

          <h1
            class="max-w-4xl text-4xl font-black leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl"
          >
            {entry.data.title}
          </h1>

          <p
            class="mt-7 max-w-3xl text-lg leading-8 text-slate-400 lg:text-xl lg:leading-9"
          >
            {entry.data.description}
          </p>

          <div
            class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm"
          >
            <span class="font-bold text-slate-300">
              Raporty24
            </span>

            <span class="text-slate-700">
              •
            </span>

            <span class="text-slate-500">
              Automatyzacja procesów i danych dla firm
            </span>
          </div>

        </div>
      </div>
    </section>


    <!-- =====================================================
         TREŚĆ
    ====================================================== -->

    <article class="bg-white py-16 lg:py-24">

      <div class="container mx-auto px-4 sm:px-5">

        <!--
          Cały obszar Content może mieć 1180 px,
          ale zwykły tekst ograniczamy CSS-em do 880 px.

          Dzięki temu screeny aplikacji mogą być szersze
          od tekstu artykułu.
        -->

        <div class="blog-content mx-auto max-w-[1180px]">
          <Content />
        </div>


        <!-- TAGI -->

        {
          entry.data.tags?.length > 0 && (
            <div
              class="mx-auto mt-16 max-w-[880px] border-t border-slate-200 pt-8"
            >
              <div class="flex flex-wrap gap-2">

                {entry.data.tags.map((tag) => (
                  <span
                    class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-500"
                  >
                    #{tag}
                  </span>
                ))}

              </div>
            </div>
          )
        }

      </div>
    </article>

  </main>


  <!-- =====================================================
       LIGHTBOX SCREENSHOTÓW
  ====================================================== -->

  <div
    id="blog-image-lightbox"
    class="blog-lightbox"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Powiększony podgląd obrazu"
  >

    <button
      id="blog-lightbox-close"
      class="blog-lightbox-close"
      type="button"
      aria-label="Zamknij podgląd"
    >
      <span aria-hidden="true">×</span>
    </button>


    <div class="blog-lightbox-inner">

      <img
        id="blog-lightbox-image"
        src=""
        alt=""
      />

      <p
        id="blog-lightbox-caption"
        class="blog-lightbox-caption"
      ></p>

    </div>

  </div>


  <Footer />


  <!-- TikTok -->

  <script
    is:inline
    async
    src="https://www.tiktok.com/embed.js"
  ></script>


  <!-- =====================================================
       OBSŁUGA POWIĘKSZANIA SCREENSHOTÓW
  ====================================================== -->

  <script is:inline>
    (() => {
      const initBlogImageZoom = () => {
        const lightbox = document.getElementById("blog-image-lightbox");
        const lightboxImage = document.getElementById("blog-lightbox-image");
        const lightboxCaption = document.getElementById("blog-lightbox-caption");
        const closeButton = document.getElementById("blog-lightbox-close");

        if (!lightbox || !lightboxImage || !lightboxCaption || !closeButton) {
          return;
        }

        const images = document.querySelectorAll(".blog-content img");

        const openLightbox = (image) => {
          const src = image.currentSrc || image.src;

          lightboxImage.src = src;
          lightboxImage.alt = image.alt || "";

          lightboxCaption.textContent = image.alt || "";

          lightbox.classList.add("is-open");
          lightbox.setAttribute("aria-hidden", "false");

          document.body.classList.add("blog-lightbox-open");

          closeButton.focus();
        };

        const closeLightbox = () => {
          lightbox.classList.remove("is-open");
          lightbox.setAttribute("aria-hidden", "true");

          document.body.classList.remove("blog-lightbox-open");

          lightboxImage.src = "";
          lightboxImage.alt = "";
          lightboxCaption.textContent = "";
        };


        images.forEach((image) => {
          image.classList.add("blog-zoom-image");

          image.setAttribute("tabindex", "0");
          image.setAttribute("role", "button");
          image.setAttribute(
            "aria-label",
            `${image.alt || "Obraz"} — kliknij, aby powiększyć`
          );

          image.addEventListener("click", () => {
            openLightbox(image);
          });

          image.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              openLightbox(image);
            }
          });
        });


        closeButton.addEventListener("click", closeLightbox);


        lightbox.addEventListener("click", (event) => {
          if (event.target === lightbox) {
            closeLightbox();
          }
        });


        document.addEventListener("keydown", (event) => {
          if (
            event.key === "Escape" &&
            lightbox.classList.contains("is-open")
          ) {
            closeLightbox();
          }
        });
      };


      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBlogImageZoom);
      } else {
        initBlogImageZoom();
      }
    })();
  </script>

</BaseLayout>


<style is:global>

  /* =========================================================
     BLOG — ZMIENNE
  ========================================================= */

  .blog-content {
    --blog-green: #16a34a;
    --blog-green-light: #22c55e;
    --blog-green-dark: #15803d;

    --blog-dark: #0f172a;
    --blog-text: #475569;
    --blog-muted: #64748b;
    --blog-border: #e2e8f0;
    --blog-soft: #f8fafc;

    width: 100%;

    color: var(--blog-text);

    font-size: 1.08rem;
    line-height: 1.85;
  }


  /* =========================================================
     SZEROKOŚĆ TEKSTU

     Blog może mieć 1180 px,
     ale tekst zostaje przy 880 px.
  ========================================================= */

  .blog-content > p:not(:has(> img)),
  .blog-content > h2,
  .blog-content > h3,
  .blog-content > h4,
  .blog-content > ul,
  .blog-content > ol,
  .blog-content > blockquote,
  .blog-content > pre,
  .blog-content > table,
  .blog-content > hr,
  .blog-content > .info-box {
    width: 100%;
    max-width: 880px;

    margin-left: auto;
    margin-right: auto;
  }


  /* =========================================================
     PARAGRAFY
  ========================================================= */

  .blog-content p {
    line-height: 1.85;
  }


  .blog-content > p:not(:has(> img)) {
    margin-top: 1.35rem;
    margin-bottom: 1.35rem;
  }


  .blog-content > p:first-child {
    margin-top: 0;

    color: #334155;

    font-size: 1.23rem;
    line-height: 1.8;
  }


  /* =========================================================
     H2
  ========================================================= */

  .blog-content h2 {
    position: relative;

    margin-top: 4.6rem;
    margin-bottom: 1.5rem;

    color: var(--blog-dark);

    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    line-height: 1.18;
    letter-spacing: -0.035em;
  }


  .blog-content h2::before {
    content: "";

    display: block;

    width: 50px;
    height: 4px;

    margin-bottom: 1rem;

    border-radius: 999px;

    background: var(--blog-green-light);
  }


  /* =========================================================
     H3 / H4
  ========================================================= */

  .blog-content h3 {
    margin-top: 3rem;
    margin-bottom: 1rem;

    color: var(--blog-dark);

    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }


  .blog-content h4 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;

    color: #1e293b;

    font-size: 1.15rem;
    font-weight: 800;
  }


  /* =========================================================
     TEKST
  ========================================================= */

  .blog-content strong {
    color: #1e293b;
    font-weight: 800;
  }


  .blog-content em {
    color: var(--blog-muted);
  }


  /* =========================================================
     LINKI
  ========================================================= */

  .blog-content a {
    color: var(--blog-green-dark);

    font-weight: 700;

    text-decoration-line: underline;
    text-decoration-color: rgba(22, 163, 74, 0.3);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;

    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }


  .blog-content a:hover {
    color: var(--blog-green);

    text-decoration-color: var(--blog-green);
  }


  /* =========================================================
     LISTY
  ========================================================= */

  .blog-content ul,
  .blog-content ol {
    padding-left: 0;
  }


  .blog-content ul {
    margin-top: 1.8rem;
    margin-bottom: 1.8rem;

    list-style: none;
  }


  .blog-content ul > li {
    position: relative;

    margin: 0.85rem 0;
    padding-left: 2.1rem;
  }


  .blog-content ul > li::before {
    content: "✓";

    position: absolute;
    top: 0.16rem;
    left: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 1.4rem;
    height: 1.4rem;

    border-radius: 999px;

    background: #dcfce7;
    color: #15803d;

    font-size: 0.72rem;
    font-weight: 900;
  }


  /* numerowane */

  .blog-content ol {
    margin-top: 1.8rem;
    margin-bottom: 1.8rem;

    list-style: none;

    counter-reset: blog-counter;
  }


  .blog-content ol > li {
    position: relative;

    min-height: 3.3rem;

    margin: 1.25rem 0;
    padding-left: 4rem;

    counter-increment: blog-counter;
  }


  .blog-content ol > li::before {
    content: counter(blog-counter);

    position: absolute;
    top: -0.2rem;
    left: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 2.8rem;
    height: 2.8rem;

    border-radius: 0.9rem;

    background: #0f172a;
    color: #4ade80;

    font-size: 0.85rem;
    font-weight: 900;

    box-shadow:
      0 8px 20px rgba(15, 23, 42, 0.12);
  }


  /* =========================================================
     SCREENSHOTY

     KLUCZOWA ZMIANA:
     1180 px zamiast 880 px.

     NIE ROZCIĄGAMY ponad naturalną wielkość.
  ========================================================= */

  .blog-content > p:has(> img) {
    width: 100%;
    max-width: 1180px;

    margin: 3.2rem auto 1rem;

    text-align: center;
  }


  .blog-content img {
    display: block;

    width: auto !important;
    max-width: 100% !important;
    height: auto !important;

    margin: 0 auto;

    border: 1px solid var(--blog-border);
    border-radius: 1.25rem;

    background: #ffffff;

    box-shadow:
      0 20px 55px rgba(15, 23, 42, 0.09),
      0 3px 10px rgba(15, 23, 42, 0.04);

    object-fit: contain;

    /*
      Wyłączamy przyspieszenie GPU ustawione
      globalnie dla obrazów.
    */

    transform: none !important;
    will-change: auto !important;
    content-visibility: visible !important;

    image-rendering: auto;

    cursor: zoom-in;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }


  .blog-content img:hover {
    border-color: #86efac;

    box-shadow:
      0 24px 70px rgba(15, 23, 42, 0.13),
      0 0 0 3px rgba(34, 197, 94, 0.08);
  }


  /* Nie skalujemy obrazka na hover.
     Dzięki temu nie traci ostrości. */


  /* =========================================================
     PODPIS ZDJĘCIA
  ========================================================= */

  .blog-content p:has(> img) + p > em:only-child {
    display: block;

    max-width: 880px;

    margin: -0.05rem auto 0;

    color: #94a3b8;

    font-size: 0.85rem;
    line-height: 1.6;
    text-align: center;
  }


  /* =========================================================
     FIGURE
  ========================================================= */

  .blog-content figure {
    width: 100%;
    max-width: 1180px;

    margin: 3.2rem auto;
  }


  .blog-content figure img {
    margin: 0 auto;
  }


  .blog-content figcaption {
    margin-top: 0.9rem;

    color: #94a3b8;

    font-size: 0.85rem;
    line-height: 1.6;
    text-align: center;
  }


  /* =========================================================
     PODPOWIEDŹ O POWIĘKSZENIU
  ========================================================= */

  .blog-content > p:has(> img)::after,
  .blog-content figure::after {
    content: "Kliknij obraz, aby powiększyć";

    display: inline-flex;

    margin-top: 0.75rem;

    color: #94a3b8;

    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }


  /* =========================================================
     INFO BOX
  ========================================================= */

  .blog-content .info-box {
    margin-top: 2.8rem;
    margin-bottom: 2.8rem;

    padding: 1.8rem;

    border: 1px solid #bbf7d0;
    border-radius: 1.4rem;

    background: #f0fdf4;

    color: #334155;
  }


  .blog-content .info-box strong {
    color: #166534;
  }


  .blog-content .info-box p:first-child {
    margin-top: 0;
  }


  .blog-content .info-box p:last-child {
    margin-bottom: 0;
  }


  /* =========================================================
     DIAGRAM PROCESU

     Może być szerszy niż tekst.
  ========================================================= */

  .blog-content .process-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;

    width: 100%;
    max-width: 1080px;

    gap: 1rem;

    margin: 3rem auto;
  }


  .blog-content .process-box {
    min-height: 160px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 1.6rem;

    border: 1px solid #e2e8f0;
    border-radius: 1.4rem;

    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f8fafc
      );

    box-shadow:
      0 12px 30px rgba(15, 23, 42, 0.04);
  }


  .blog-content .process-box span {
    display: block;

    margin-bottom: 0.8rem;

    color: #16a34a;

    font-size: 0.73rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }


  .blog-content .process-box strong {
    display: block;

    color: #0f172a;

    font-size: 1.05rem;
    line-height: 1.35;
  }


  .blog-content .process-box small {
    display: block;

    margin-top: 0.6rem;

    color: #64748b;

    font-size: 0.82rem;
    line-height: 1.55;
  }


  .blog-content .process-arrow {
    display: flex;
    align-items: center;
    justify-content: center;

    color: #22c55e;

    font-size: 1.8rem;
    font-weight: 900;
  }


  /* =========================================================
     CYTAT
  ========================================================= */

  .blog-content blockquote {
    margin-top: 2.8rem;
    margin-bottom: 2.8rem;

    padding: 1.7rem 1.8rem 1.7rem 2rem;

    border-left: 4px solid #22c55e;
    border-radius: 0 1.2rem 1.2rem 0;

    background:
      linear-gradient(
        90deg,
        rgba(34, 197, 94, 0.09),
        rgba(248, 250, 252, 0.75)
      );

    color: #334155;

    font-size: 1.08rem;
    font-weight: 600;
  }


  .blog-content blockquote p {
    margin: 0;
  }


  /* =========================================================
     HR
  ========================================================= */

  .blog-content hr {
    height: 1px;

    margin-top: 4rem;
    margin-bottom: 4rem;

    border: 0;

    background:
      linear-gradient(
        90deg,
        transparent,
        #cbd5e1,
        transparent
      );
  }


  /* =========================================================
     KOD
  ========================================================= */

  .blog-content code {
    border-radius: 0.4rem;

    background: #f1f5f9;

    padding: 0.15rem 0.4rem;

    color: #166534;

    font-size: 0.92em;
  }


  .blog-content pre {
    overflow-x: auto;

    margin-top: 2.2rem;
    margin-bottom: 2.2rem;

    padding: 1.5rem;

    border: 1px solid #1e293b;
    border-radius: 1.25rem;

    background: #020617;
    color: #e2e8f0;

    box-shadow:
      0 20px 50px rgba(15, 23, 42, 0.12);
  }


  .blog-content pre code {
    padding: 0;

    background: transparent;
    color: inherit;
  }


  /* =========================================================
     TABELA
  ========================================================= */

  .blog-content table {
    width: 100%;

    margin-top: 2.8rem;
    margin-bottom: 2.8rem;

    border-collapse: separate;
    border-spacing: 0;

    overflow: hidden;

    border: 1px solid var(--blog-border);
    border-radius: 1rem;

    background: #ffffff;

    box-shadow:
      0 10px 30px rgba(15, 23, 42, 0.04);
  }


  .blog-content th {
    padding: 1rem 1.2rem;

    background: #0f172a;

    color: #ffffff;

    font-size: 0.85rem;
    font-weight: 800;
    text-align: left;
  }


  .blog-content td {
    padding: 1rem 1.2rem;

    border-bottom: 1px solid var(--blog-border);

    background: #ffffff;
  }


  .blog-content tr:last-child td {
    border-bottom: 0;
  }


  /* =========================================================
     CTA
  ========================================================= */

  .blog-content > p:last-child {
    margin-top: 2rem;
  }


  .blog-content > p:last-child > a:only-child {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 1rem 1.6rem;

    border-radius: 0.9rem;

    background: #22c55e;
    color: #052e16;

    font-weight: 900;
    text-decoration: none;

    box-shadow:
      0 14px 35px rgba(34, 197, 94, 0.2);

    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }


  .blog-content > p:last-child > a:only-child:hover {
    transform: translateY(-2px);

    background: #4ade80;
    color: #052e16;

    box-shadow:
      0 18px 40px rgba(34, 197, 94, 0.25);
  }


  /* =========================================================
     TIKTOK
  ========================================================= */

  .blog-content .tiktok-container {
    max-width: 880px;

    margin: 3rem auto;

    padding: 2rem 1rem;

    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;

    background: #f8fafc;
  }


  /* =========================================================
     LIGHTBOX
  ========================================================= */

  .blog-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 24px;

    background: rgba(2, 6, 23, 0.94);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }


  .blog-lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }


  .blog-lightbox-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;
  }


  /*
    W lightboxie obraz jest pokazywany praktycznie
    w pełnej rozdzielczości dostępnej na ekranie.
  */

  .blog-lightbox img {
    display: block;

    width: auto !important;
    height: auto !important;

    max-width: min(96vw, 2200px) !important;
    max-height: 88vh !important;

    border-radius: 12px;

    background: white;

    box-shadow:
      0 30px 100px rgba(0, 0, 0, 0.45);

    object-fit: contain;

    transform: none !important;
    will-change: auto !important;
    content-visibility: visible !important;

    image-rendering: auto;

    cursor: default;
  }


  .blog-lightbox-caption {
    max-width: 900px;

