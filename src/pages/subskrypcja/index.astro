---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

// SEO: Przywrócone Twoje oryginalne treści nasycone frazami pod Google
const slaSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Subskrypcja (SLA) Raporty24",
      "provider": { "@type": "LocalBusiness", "name": "Raporty24" },
      "description": "Stała opieka nad Excel/Power BI, poprawki, rozwój raportów, automatyzacje i utrzymanie odświeżeń. Pakiety godzin, priorytety i jasny czas reakcji.",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "PLN",
        "description": "Model subskrypcyjny: pakiety godzin (retainer) z jasnym SLA."
      }
    }
  ]
};

const title = "Subskrypcja (SLA) | Stała Opieka Excel i Power BI | Raporty24";
const description = "Subskrypcja (SLA) Raporty24: stała opieka nad Excel/Power BI, poprawki, rozwój raportów, automatyzacje i utrzymanie odświeżeń. Pakiety godzin i jasny czas reakcji.";
---

<BaseLayout title={title} description={description} structuredData={slaSchema}>
  <div x-data="app" class="antialiased text-slate-900 bg-white">
    <Header />

    <main class="pt-20">
      <section class="relative overflow-hidden py-24 lg:py-44 bg-slate-50 text-slate-900 border-b border-slate-100">
        
        <div class="absolute inset-0 z-0 opacity-15 [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_60%,transparent_100%)]">
          <div class="absolute inset-0 bg-[linear-gradient(to_right,#e2e8f0_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f0_1px,transparent_1px)] bg-[size:40px_40px]"></div>
        </div>

        <div class="absolute inset-0 z-0 pointer-events-none">
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-emerald-100/50 rounded-full blur-[130px]"></div>
          <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-blue-100/30 rounded-full blur-[100px]"></div>
        </div>

        <div class="absolute inset-0 z-0 opacity-20">
          <div class="absolute top-0 left-1/2 w-px h-full bg-gradient-to-b from-transparent via-emerald-300 to-transparent"></div>
          <div class="absolute top-1/2 left-0 w-full h-px bg-gradient-to-r from-transparent via-emerald-300 to-transparent"></div>
        </div>

        <div class="container mx-auto px-4 relative z-10 text-center">
          <div class="max-w-5xl mx-auto">
            <span class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-700 uppercase tracking-[0.3em] mb-8 border border-emerald-100/50 shadow-sm">
              Stała współpraca
            </span>
            <h1 class="text-5xl md:text-8xl font-black leading-[1.05] tracking-tight mb-8 uppercase text-slate-950">
              Subskrypcja <span class="text-emerald-600">(SLA)</span>
            </h1>
            
            <p class="text-xl text-slate-600 max-w-4xl mx-auto leading-relaxed mb-12 font-medium">
              Dla firm, które chcą <strong>ciągłej opieki</strong>, a nie jednorazowego projektu: 
              stałe utrzymanie raportów i automatyzacji, priorytety, szybkie reakcje i rozwój zgodnie z backlogiem. 
              Model subskrypcji daje <strong>przewidywalny koszt</strong> (pakiet godzin) i jasne zasady współpracy.
            </p>
            
            <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
              <a href="/#kontakt" class="px-12 py-5 bg-emerald-600 hover:bg-emerald-500 text-white font-black rounded-xl transition-all shadow-2xl shadow-emerald-200 w-full sm:w-auto text-lg uppercase tracking-tighter">
                Zapytaj o subskrypcję
              </a>
              <a href="/cennik/" class="px-12 py-5 bg-white border-2 border-slate-200 hover:bg-slate-50 text-slate-700 font-black rounded-xl transition-all w-full sm:w-auto text-lg uppercase tracking-tighter text-sm">
                Zobacz cennik projektów
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 container mx-auto px-4 relative z-20">
        <div class="p-8 md:p-12 rounded-[2.5rem] border border-slate-200 bg-white shadow-2xl -mt-20">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center text-left">
            <div>
              <p class="text-2xl font-black text-slate-900 leading-tight uppercase tracking-tight">
                Najczęstszy scenariusz: raporty „żyją” → zmieniają się KPI, źródła danych i procesy.
              </p>
              <p class="mt-6 text-slate-600 text-lg leading-relaxed font-medium">
                W subskrypcji zajmujemy się poprawkami, rozwojem, automatyzacją i utrzymaniem odświeżeń. 
                Dostajesz stały kanał zgłoszeń, priorytety i SLA.
              </p>
            </div>
            <div class="grid grid-cols-1 gap-4 font-bold">
               {[
                 { t: "SLA i priorytety", d: "Jasny czas reakcji, priorytety P1/P2/P3, kolejka zadań i statusy postępu." },
                 { t: "Utrzymanie i stabilność", d: "Odświeżenia danych, szybka diagnoza błędów, optymalizacje, porządek w raportowaniu." },
                 { t: "Rozwój i automatyzacje", d: "Nowe raporty, Power Query/VBA, integracje danych, poprawa workflow i jakości danych." }
               ].map(item => (
                 <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 flex flex-col gap-1">
                    <p class="text-slate-950 uppercase tracking-tighter mb-1 text-base">{item.t}</p>
                    <p class="text-sm text-slate-500 font-medium leading-relaxed">{item.d}</p>
                 </div>
               ))}
            </div>
          </div>
        </div>
      </section>

      <section class="container mx-auto px-4 py-20 text-left bg-white">
        <h2 class="text-4xl font-black text-slate-950 uppercase tracking-tighter mb-4">Kiedy subskrypcja ma największy sens?</h2>
        <p class="text-slate-600 max-w-4xl text-lg font-medium">
          Subskrypcja jest stworzona do sytuacji, w których raportowanie jest procesem, a nie „jednym plikiem”. 
          Jeśli raporty wspierają decyzje biznesowe, muszą być aktualne, spójne i rozwijane razem z firmą.
        </p>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { t: "Raporty cykliczne", d: "Tygodniowe/miesięczne raporty, które zawsze muszą „wyjść na czas”.", l: ["odświeżanie danych i kontrola błędów", "szybkie poprawki „na już”", "stała jakość i spójność KPI"] },
            { t: "Zmienność danych", d: "Zmiany w ERP/SQL, nowe formaty, nowe źródła danych.", l: ["modyfikacje Power Query / integracji", "walidacje danych i porządkowanie", "rozwój modelu danych / miar"] },
            { t: "Stały rozwój BI", d: "Dashboardy rosną, KPI się zmieniają, dochodzą nowe potrzeby zespołów.", l: ["backlog z priorytetami", "nowe raporty i wizualizacje", "optymalizacja wydajności"] }
          ].map(box => (
            <div class="p-10 rounded-[2.5rem] border border-slate-100 bg-white hover:border-emerald-300 shadow-xl shadow-slate-100 hover:shadow-2xl transition-all">
              <h3 class="text-xl font-black uppercase mb-4 text-slate-950">{box.t}</h3>
              <p class="text-slate-500 text-sm mb-6 font-medium leading-relaxed">{box.d}</p>
              <ul class="space-y-3 font-bold text-slate-800 text-sm">
                {box.l.map(li => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> {li}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="py-24 bg-white border-t border-slate-100">
        <div class="container mx-auto px-4 text-left">
          <div class="text-center max-w-3xl mx-auto mb-20">
            <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tight text-slate-950">Pakiety subskrypcji</h2>
            <p class="mt-4 text-slate-600 font-medium italic">Rozliczamy się w modelu pakietów godzin (retainer). Dzięki temu znasz koszt i wiesz, co jest w zakresie.</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 text-left">
            <div class="p-10 rounded-[2.5rem] border border-slate-100 bg-white hover:border-emerald-300 transition-all flex flex-col">
              <h3 class="text-xl font-black uppercase text-slate-950">Starter</h3>
              <p class="text-emerald-600 text-[10px] font-black uppercase tracking-widest mt-2">Utrzymanie + drobne poprawki</p>
              <div class="my-10 text-5xl font-black text-slate-950 tracking-tighter">4–6 h <span class="text-lg text-slate-500 font-medium">/ mies.</span></div>
              <ul class="space-y-4 mb-10 text-sm text-slate-600 flex-grow font-medium">
                <li>• poprawki w raportach/plikach</li>
                <li>• szybka diagnostyka błędów</li>
                <li>• kontrola odświeżeń</li>
                <li>• 1 status / tydzień</li>
              </ul>
              <a href="/#kontakt" class="py-4 text-center border-2 border-slate-900 rounded-xl font-black uppercase text-xs hover:bg-slate-900 hover:text-white transition-all">Zapytaj</a>
            </div>

            <div class="p-10 rounded-[3rem] bg-emerald-600 text-white shadow-2xl flex flex-col transform lg:-translate-y-8 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
              <h3 class="text-xl font-black uppercase">Business</h3>
              <p class="text-emerald-200 text-[10px] font-black uppercase tracking-widest mt-2">Rozwój + automatyzacje</p>
              <div class="my-10 text-6xl font-black tracking-tighter">8–12 h <span class="text-lg text-emerald-300 font-medium">/ mies.</span></div>
              <ul class="space-y-4 mb-10 text-sm font-bold flex-grow text-white">
                <li>• backlog i priorytety</li>
                <li>• nowe raporty / widoki</li>
                <li>• optymalizacja wydajności</li>
                <li>• konsultacje KPI</li>
              </ul>
              <a href="/#kontakt" class="py-5 text-center bg-slate-950 text-white rounded-xl font-black uppercase text-xs hover:bg-slate-900 transition-all shadow-xl">Umów rozmowę</a>
            </div>

            <div class="p-10 rounded-[2.5rem] border border-slate-100 bg-white hover:border-emerald-300 transition-all flex flex-col">
              <h3 class="text-xl font-black uppercase text-slate-950">Pro</h3>
              <p class="text-emerald-600 text-[10px] font-black uppercase tracking-widest mt-2">SLA + Pełny rozwój</p>
              <div class="my-10 text-5xl font-black text-slate-950 tracking-tighter">16+ h <span class="text-lg text-slate-500 font-medium">/ mies.</span></div>
              <ul class="space-y-4 mb-10 text-sm text-slate-600 flex-grow font-medium">
                <li>• stała rozbudowa raportowania</li>
                <li>• integracje danych (SQL/ERP/API)</li>
                <li>• standardy i dokumentacja</li>
                <li>• priorytetowe SLA</li>
              </ul>
              <a href="/#kontakt" class="py-4 text-center border-2 border-slate-900 rounded-xl font-black uppercase text-xs hover:bg-slate-900 hover:text-white transition-all">Wycena subskrypcji</a>
            </div>
          </div>
        </div>
      </section>

      <section class="py-24 container mx-auto px-4 max-w-5xl text-left bg-white">
        <div class="mb-12">
          <h2 class="text-4xl font-black uppercase tracking-tighter text-slate-950">SLA i zasady współpracy</h2>
          <p class="text-slate-500 mt-2 font-medium italic leading-relaxed">Ustalamy priorytety i czas reakcji. Dzięki temu wiesz, czego oczekiwać, a my możemy skutecznie dowozić.</p>
        </div>

        <div class="overflow-hidden rounded-3xl border border-slate-100 shadow-sm bg-white">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-100 text-[10px] font-black uppercase tracking-widest text-slate-400">
                <th class="p-6">Priorytet</th>
                <th class="p-6">Przykład zdarzenia</th>
                <th class="p-6 text-right">Czas reakcji</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-bold text-slate-800 text-sm">
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 text-red-600 uppercase tracking-tighter">P1 (Krytyczny)</td>
                <td class="p-6 text-slate-700 font-medium leading-relaxed">Raport krytyczny nie działa / odświeżenie blokuje pracę</td>
                <td class="p-6 text-right text-slate-900 italic">4–8h</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 text-amber-500 uppercase tracking-tighter">P2 (Standard)</td>
                <td class="p-6 text-slate-700 font-medium leading-relaxed">Błąd w danych / zmiana logiki / poprawki wykresów</td>
                <td class="p-6 text-right text-slate-900 italic">1–2 dni</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-6 text-blue-600 uppercase tracking-tighter">P3 (Rozwój)</td>
                <td class="p-6 text-slate-600 font-medium leading-relaxed">Rozwój: nowe widoki, usprawnienia, dodatkowe źródła</td>
                <td class="p-6 text-right text-slate-400">Backlog</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-[10px] text-slate-400 font-bold uppercase tracking-widest">* SLA dopasowujemy do pakietu i potrzeb. W praktyce liczą się priorytety i transparentny backlog prac.</p>
      </section>

      <section class="py-24 bg-slate-50 border-y border-slate-200">
        <div class="container mx-auto px-4 text-left">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div class="bg-white p-10 lg:p-14 rounded-[2.5rem] shadow-sm border border-slate-100 hover:border-emerald-300 transition-all hover:shadow-2xl hover:shadow-slate-100">
              <h2 class="text-3xl font-black uppercase tracking-tight mb-8 text-slate-950">Co obejmuje subskrypcja?</h2>
              <ul class="space-y-4 font-bold text-sm text-slate-800">
                <li class="flex items-start gap-3"><span class="w-2 h-2 mt-1.5 bg-emerald-500 rounded-full"></span> poprawki w raportach Excel/Power BI</li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 mt-1.5 bg-emerald-500 rounded-full"></span> automatyzacje w Power Query/VBA</li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 mt-1.5 bg-emerald-500 rounded-full"></span> utrzymanie odświeżeń i diagnoza błędów</li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 mt-1.5 bg-emerald-500 rounded-full"></span> rozwój raportów (nowe widoki, KPI, wizualizacje)</li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 mt-1.5 bg-emerald-500 rounded-full"></span> optymalizacja wydajności modelu</li>
                <li class="flex items-start gap-3"><span class="w-2 h-2 mt-1.5 bg-emerald-500 rounded-full"></span> konsultacje: KPI, struktura danych</li>
              </ul>
            </div>
            <div class="bg-white p-10 lg:p-14 rounded-[2.5rem] shadow-sm border border-slate-100 hover:border-blue-300 transition-all hover:shadow-2xl hover:shadow-slate-100">
              <h2 class="text-3xl font-black uppercase tracking-tight mb-4 text-slate-950">Onboarding (start)</h2>
              <p class="text-slate-500 text-sm mb-8 font-medium leading-relaxed">Pierwsze 7–14 dni to uporządkowanie: dostęp, priorytety, lista raportów, źródła danych i szybkie „quick wins”.</p>
              <div class="space-y-4">
                {[
                  { n: "1", t: "Audyt: co działa, co jest krytyczne" },
                  { n: "2", t: "Priorytety P1/P2/P3 + kanał zgłoszeń" },
                  { n: "3", t: "Quick wins: naprawy o największym zwrocie" },
                  { n: "4", t: "Backlog rozwoju + plan na kolejne tygodnie" }
                ].map(step => (
                  <div class="flex gap-4 p-5 bg-slate-50 rounded-xl border border-slate-100 items-start">
                    <span class="text-3xl font-black text-emerald-200 tracking-tighter">{step.n}</span>
                    <span class="text-sm font-bold text-slate-800 leading-relaxed mt-1">{step.t}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-24 container mx-auto px-4 max-w-4xl bg-white text-left">
        <h2 class="text-4xl font-black text-center uppercase tracking-tight mb-16 text-slate-950">FAQ – subskrypcja</h2>
        <div class="space-y-4">
          {[
            {q: "Czy niewykorzystane godziny przechodzą na kolejny miesiąc?", a: "To ustalamy w umowie. Najczęściej część godzin może przejść (z limitem), albo zamieniamy je na prace rozwojowe lub dokumentację."},
            {q: "Czy w subskrypcji można rozwijać Power BI i Excela równolegle?", a: "Tak. Pracujemy tam, gdzie jest największy zwrot: Excel/Power Query/VBA/Power BI — zgodnie z backlogiem i priorytetami."},
            {q: "Jak wygląda komunikacja i zgłoszenia?", a: "Ustalamy jeden kanał zgłoszeń (np. e-mail/Teams) + priorytety i statusy. Dzięki temu prace są transparentne i przewidywalne."}
          ].map(faq => (
            <details class="group bg-white border border-slate-200 rounded-3xl p-8 hover:bg-slate-50 transition-all cursor-pointer">
              <summary class="list-none flex justify-between items-center font-bold text-slate-950 text-lg uppercase tracking-tight">
                {faq.q}
                <span class="text-emerald-500 group-open:rotate-180 transition-transform font-black text-2xl leading-none">↓</span>
              </summary>
              <p class="mt-6 text-slate-600 text-sm leading-relaxed border-t border-slate-100 pt-6 font-medium pt-4 border-t border-slate-100">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="py-24 bg-slate-50 border-t border-slate-100">
        <div class="container mx-auto px-4">
          <div class="p-16 lg:p-24 bg-white border border-slate-200 rounded-[3.5rem] text-center text-white relative overflow-hidden shadow-2xl shadow-slate-100">
             <div class="relative z-10">
                <h2 class="text-4xl md:text-6xl font-black mb-8 leading-tight tracking-tight uppercase text-slate-950">Chcesz stałą opiekę i szybkie reakcje?</h2>
                <p class="mt-4 text-slate-600 text-xl max-w-2xl mx-auto mb-12 font-medium">Napisz, ile raportów macie i jak często coś się zmienia. Zaproponujemy pakiet i SLA.</p>
                <div class="flex flex-col sm:flex-row justify-center gap-6">
                  <a href="/#kontakt" class="px-12 py-5 bg-emerald-600 text-white font-black text-xl rounded-2xl shadow-xl shadow-emerald-200 hover:scale-105 transition-all uppercase tracking-tighter">Wyceń subskrypcję</a>
                </div>
             </div>
             <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-100/30 rounded-full blur-[100px]"></div>
             <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-100/20 rounded-full blur-[100px]"></div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style is:global>
  html { scroll-behavior: smooth; }
  body { text-rendering: optimizeLegibility; -webkit-font-smoothing: antialiased; }
</style>