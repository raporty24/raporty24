---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Panels from "../components/Panels.astro";
import SelectedRealizations from "../components/SelectedRealizations.astro";
import Pricing from "../components/Pricing.astro";
import WhyUs from "../components/WhyUs.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title =
  "Automatyzacja procesów i danych dla firm | Raporty24";

const description =
  "Automatyzujemy procesy i pracę z danymi w firmach. Excel, Power Query, Power BI, API, SharePoint, Microsoft 365, integracje, raporty i dedykowane narzędzia.";

const image = "/biuro3.webp";

const url = "https://raporty24.pl/";
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  url={url}
>
  <div x-data="app" x-cloak>

    <Header />

    <!-- CIEMNY -->
    <Hero />

    <!-- JASNY -->
    <Panels />

    <!-- CIEMNY -->
    <SelectedRealizations />

    <!-- JASNY -->
    <Pricing />

    <!-- CIEMNY -->
    <WhyUs />

    <!-- JASNY -->
    <Contact />

    <!-- CIEMNY -->
    <Footer />

  </div>
</BaseLayout>


<style is:global>

  * {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  img {
    transform: translateZ(0);
    will-change: transform;
    content-visibility: auto;
  }

  .animate-slow-pan,
  .neon-flow {
    animation: none !important;
  }

</style>