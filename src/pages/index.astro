---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Panels from "../components/Panels.astro";
import SelectedRealizations from "../components/SelectedRealizations.astro";
import Demo from "../components/Demo.astro";
import Pricing from "../components/Pricing.astro";
import Subscription from "../components/Subscription.astro";
import WhyUs from "../components/WhyUs.astro";
import FreeAuditCTA from "../components/FreeAuditCTA.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title = "Automatyzacja Excel, Power BI, Python i API dla firm | Raporty24";
const description =
  "Tworzymy automatyzacje Excel, dashboardy Power BI, skrypty Python, integracje API, kalkulatory ofertowe i aplikacje dla firm. Darmowa wycena w 24h.";
const image = "/biuro3.webp";
const url = "https://raporty24.pl/";
---

<BaseLayout title={title} description={description} image={image} url={url}>
  <div x-data="app" x-cloak>
    <Header />
    <Hero />
    <Panels />
    <SelectedRealizations />
    <Demo />
    <Pricing />
    <Subscription />
    <WhyUs />
    <FreeAuditCTA />
    <Contact />
    <Footer />
  </div>
</BaseLayout>

<style is:global>
  * {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  img {
    transform: translateZ(0);
    will-change: transform;
    content-visibility: auto;
  }

  .animate-slow-pan,
  .neon-flow {
    animation: none !important;
  }
</style>