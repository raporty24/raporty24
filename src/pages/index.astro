---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Panels from "../components/Panels.astro";

import Technologies from "../components/Technologies.astro";
import About from "../components/About.astro";
import Demo from "../components/Demo.astro";
import Pricing from "../components/Pricing.astro";
import Subscription from "../components/Subscription.astro";
import WhyUs from "../components/WhyUs.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Firma analityczna | Dashboardy Power BI, Excel i Chatboty AI"
  description="Firma analityczna i analityka biznesowa. Tworzymy profesjonalne dashboardy Power BI, dedykowany program do zarządzania firmą oraz AI: chatboty do danych i raportów. Kompleksowe usługi dla firm excel. Szukasz wykonawcy na zlecę excel? Sprawdź!"
>
    <div x-data="app" x-cloak>
    <Header />
    <Hero />
    <Panels />

    <Technologies />
  
    <Demo />
    <Pricing />
    <Subscription />
    <WhyUs />
    <Contact />
    <Footer />
      </div>
</BaseLayout>