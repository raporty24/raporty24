---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Panels from "../components/Panels.astro";

import Technologies from "../components/Technologies.astro";
import About from "../components/About.astro";
import Demo from "../components/Demo.astro";
import Pricing from "../components/Pricing.astro";
import Subscription from "../components/Subscription.astro";
import WhyUs from "../components/WhyUs.astro";
import FreeAuditCTA from "../components/FreeAuditCTA.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

// Definiujemy dane dla strony głównej
const title = "Automatyzacja raportów i danych – Excel, Power BI, AI";
const description = "Oszczędź do 20h pracy miesięcznie. Tworzymy raporty Excel na zamówienie, makra VBA oraz dashboardy Power BI. Nowoczesna analityka biznesowa i chatboty AI do danych.";
//const title = "Firma analityczna | Dashboardy Power BI, Excel i Chatboty AI";
//const description = "Firma analityczna i analityka biznesowa. Tworzymy profesjonalne dashboardy Power BI, dedykowany program do zarządzania firmą oraz AI: chatboty do danych i raportów. Kompleksowe usługi dla firm excel. Szukasz wykonawcy na zlecę excel? Sprawdź!";
const image = "/biuro3.webp"; // Twoja główna grafika (ta z SQL)
const url = "https://raporty24.pl/";
const homeFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ile trwa wycena i od czego zależy koszt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zwykle odpisujemy w 24h w dni robocze. Koszt zależy od źródeł danych, złożoności modelu i oczekiwanego efektu (Excel „1 klik”, dashboardy KPI Power BI, integracje). Start od 400 zł."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę liczyć na wsparcie po wdrożeniu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak. Możesz działać projektowo albo w modelu subskrypcji (SLA): utrzymanie odświeżeń, poprawki, rozwój KPI i priorytety zgłoszeń."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę wysłać zanonimizowane dane do wyceny?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak. Do wyceny często wystarczą screeny lub próbka danych bez danych wrażliwych. W razie potrzeby możemy podpisać NDA."
      }
    }
  ]
};
---

<BaseLayout 
  title={title} 
  description={description} 
  image={image} 
  url={url}
  structuredData={homeFaqSchema}
>
    <div x-data="app" x-cloak>
    <Header />
    <Hero />
    <Panels />

    <Technologies />
  
    <Demo />
    <Pricing />
    <Subscription />
    <WhyUs />
<FreeAuditCTA />
    <Contact />
    <Footer />
      </div>
</BaseLayout>

<style is:global>
  /* Wyłączenie efektów, które duszą procesor graficzny */
  * {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  /* Wymuszenie płynności na zdjęciach */
  img {
    transform: translateZ(0);
    will-change: transform;
    content-visibility: auto;
  }

  /* Wyłączenie ciężkich animacji */
  .animate-slow-pan, .neon-flow {
    animation: none !important;
  }
</style>