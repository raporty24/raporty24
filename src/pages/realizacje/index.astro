      {
        title: "Integracje API",
        href: "/uslugi/integracje-api/",
      },
    ],

    accent: "AUTOMATYZACJA",
  },
];


/*
 * =========================================================
 * STRUCTURED DATA
 * =========================================================
 */

const realizationsSchema = {
  "@context": "https://schema.org",

  "@type": "ItemList",

  name:
    "Realizacje automatyzacji Raporty24",

  itemListElement: realizations.map((item, index) => ({
    "@type": "ListItem",

    position:
      index + 1,

    name:
      item.title,

    description:
      item.solution,

    url:
      `${currentUrl}#${item.slug}`,
  })),
};


const breadcrumbSchema = {
  "@context": "https://schema.org",

  "@type": "BreadcrumbList",

  itemListElement: [
    {
      "@type": "ListItem",

      position: 1,

      name:
        "Raporty24",

      item:
        "https://raporty24.pl/",
    },

    {
      "@type": "ListItem",

      position: 2,

      name:
        "Realizacje",

      item:
        currentUrl,
    },
  ],
};


const allImagesJson = JSON.stringify(
  realizations.reduce(
    (
      acc: RealizationImage[],
      item
    ) => {

      if (item.images) {
        acc.push(...item.images);
      }

      return acc;

    },
    []
  )
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  url={currentUrl}
  structuredData={[
    realizationsSchema,
    breadcrumbSchema
  ]}
>

  <div
    x-data={`{
      app: {},
      lightboxOpen: false,
      lightboxIndex: 0,
      lightboxImages: ${allImagesJson},

      openLightbox(src) {
        this.lightboxIndex =
          this.lightboxImages.findIndex(
            img => img.src === src
          );

        if (this.lightboxIndex !== -1) {
          this.lightboxOpen = true;
          document.body.style.overflow = 'hidden';
        }
      },

      closeLightbox() {
        this.lightboxOpen = false;
        document.body.style.overflow = '';
      },

      nextLightbox() {
        this.lightboxIndex =
          (this.lightboxIndex + 1)
          % this.lightboxImages.length;
      },

      prevLightbox() {
        this.lightboxIndex =
          (
            this.lightboxIndex
            - 1
            + this.lightboxImages.length
          )
          % this.lightboxImages.length;
      }
    }`}

    @keydown.escape.window="closeLightbox()"

    @keydown.arrow-right.window="
      if(lightboxOpen) nextLightbox()
    "

    @keydown.arrow-left.window="
      if(lightboxOpen) prevLightbox()
    "
  >

    <Header />


    <main>


      <!-- ================================================= -->
      <!-- HERO -->
      <!-- ================================================= -->

      <section
        class="relative overflow-hidden bg-slate-950 py-28 text-white lg:py-36"
      >

        <div
          class="absolute inset-0 opacity-20 bg-[radial-gradient(#1e293b_1.5px,transparent_1.5px)] [background-size:32px_32px]"
        ></div>


        <div
          class="absolute right-0 top-0 h-96 w-96 rounded-full bg-green-600/10 blur-[120px]"
        ></div>


        <div
          class="container relative z-10 mx-auto px-4"
        >

          <div class="max-w-5xl">

            <span
              class="mb-5 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-400"
            >
              Realizacje Raporty24
            </span>


            <h1
              class="max-w-5xl text-5xl font-black leading-[1.03] tracking-tighter md:text-7xl"
            >
              Zobacz, jak
              <span class="text-green-400">
                automatyzujemy procesy
              </span>
              w firmach.
            </h1>


            <p
              class="mt-8 max-w-3xl text-lg leading-relaxed text-slate-300 md:text-xl"
            >
              Excel, API, aplikacje, KSeF, dokumenty,
              dane i procesy firmowe.
              Technologię dobieramy do problemu,
              a nie odwrotnie.
            </p>


            <div
              class="mt-10 flex flex-col gap-4 sm:flex-row"
            >

              <a
                href="#realizacje"
                class="inline-flex items-center justify-center rounded-2xl bg-green-500 px-8 py-5 text-sm font-black uppercase tracking-widest text-slate-950 transition-all hover:-translate-y-1 hover:bg-green-400"
              >
                Zobacz realizacje
              </a>


              <a
                href="#kontakt"
                class="inline-flex items-center justify-center rounded-2xl border border-white/20 px-8 py-5 text-sm font-black uppercase tracking-widest text-white transition-all hover:-translate-y-1 hover:border-green-400"
              >
                Opisz swój proces
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- CO ROBIMY -->
      <!-- ================================================= -->

      <section
        class="bg-white py-24 text-slate-950"
      >

        <div
          class="container mx-auto px-4"
        >

          <div
            class="grid gap-16 lg:grid-cols-2 lg:items-center"
          >

            <div>

              <span
                class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
              >
                Od problemu do działającego narzędzia
              </span>


              <h2
                class="mb-7 text-4xl font-black tracking-tighter md:text-6xl"
              >
                Nie sprzedajemy technologii.
                Rozwiązujemy konkretny proces.
              </h2>


              <p
                class="mb-6 text-lg leading-relaxed text-slate-600"
              >
                Jeden projekt może wymagać tylko Excela
                i Power Query. W innym potrzebna będzie
                aplikacja, API albo dodatkowa warstwa
                automatyzacji.
              </p>


              <p
                class="text-lg leading-relaxed text-slate-600"
              >
                Dlatego w realizacjach pokazujemy najpierw
                problem biznesowy, później rozwiązanie,
                a dopiero na końcu technologie,
                których użyliśmy.
              </p>

            </div>


            <div
              class="grid gap-4 sm:grid-cols-2"
            >

              {
                [
                  {
                    title:
                      "Excel i Power Query",

                    text:
                      "Narzędzia operacyjne, raporty, kalkulatory i przetwarzanie danych."
                  },

                  {
                    title:
                      "Integracje API",

                    text:
                      "Wymiana danych pomiędzy Excelem, aplikacjami i systemami firmy."
                  },

                  {
                    title:
                      "Małe aplikacje",

                    text:
                      "Dedykowane narzędzia tam, gdzie sam arkusz przestaje wystarczać."
                  },

                  {
                    title:
                      "Automatyzacja procesów",

                    text:
                      "Połączenie kilku etapów pracy w jeden kontrolowany przepływ."
                  }
                ].map((item) => (

                  <div
                    class="rounded-2xl border border-slate-200 bg-slate-50 p-6"
                  >

                    <h3
                      class="mb-2 text-lg font-black"
                    >
                      {item.title}
                    </h3>


                    <p
                      class="text-sm leading-relaxed text-slate-600"
                    >
                      {item.text}
                    </p>

                  </div>

                ))
              }

            </div>

          </div>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- REALIZACJE -->
      <!-- ================================================= -->

      <section
        id="realizacje"
        class="bg-slate-50 py-24 text-slate-950"
      >

        <div
          class="container mx-auto max-w-6xl px-4"
        >

          <div
            class="mb-16 max-w-4xl"
          >

            <span
              class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
            >
              Case studies
            </span>


            <h2
              class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
            >
              Wybrane projekty
            </h2>


            <p
              class="text-lg leading-relaxed text-slate-600 md:text-xl"
            >
              Każdy projekt zaczynał się od konkretnego problemu
              lub powtarzalnej czynności,
              którą trzeba było uporządkować.
            </p>

          </div>


          <div
            class="space-y-16"
          >

            {
              realizations.map((item) => (

                <article
                  id={item.slug}
                  class="scroll-mt-28 overflow-hidden rounded-[2.5rem] border border-slate-200 bg-white shadow-sm"
                >


                  <!-- ================================= -->
                  <!-- GALERIA -->
                  <!-- ================================= -->

                  {
                    item.images
                    && item.images.length > 0
                    ? (

                      <div
                        class="relative border-b border-slate-100 bg-slate-50"
                        x-data={`{
                          activeIndex: 0,
                          total: ${item.images.length}
                        }`}
                      >

                        <div
                          class="relative flex h-[320px] w-full items-center justify-center overflow-hidden md:h-[480px] lg:h-[540px]"
                        >

                          {
                            item.images.map(
                              (img, idx) => (

                                <div
                                  x-show={`activeIndex === ${idx}`}
                                  x-transition:enter="transition ease-out duration-300"
                                  x-transition:enter-start="opacity-0"
                                  x-transition:enter-end="opacity-100"
                                  class="absolute inset-0 flex h-full w-full items-center justify-center p-6 md:p-10"
                                >

                                  <button
                                    type="button"

                                    @click={`openLightbox('${img.src}')`}

                                    class="group/img relative block max-h-full max-w-full cursor-zoom-in overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg"
                                  >

                                    <img
                                      src={img.src}
                                      alt={img.alt}
                                      class="max-h-[260px] h-full w-full object-contain md:max-h-[400px] lg:max-h-[440px]"
                                      loading="lazy"
                                    />


                                    <div
                                      class="absolute inset-0 flex items-center justify-center bg-slate-950/5 opacity-0 transition-opacity group-hover/img:opacity-100"
                                    >

                                      <div
                                        class="rounded-full bg-white/90 p-3 text-slate-800 shadow-md"
                                      >
                                        <i class="fas fa-search-plus"></i>
                                      </div>

                                    </div>

                                  </button>

                                </div>

                              )
                            )
                          }

                        </div>


                        {
                          item.images.length > 1 && (

                            <>

                              <button
                                type="button"

                                @click="
                                  activeIndex =
                                    activeIndex === 0
                                      ? total - 1
                                      : activeIndex - 1
                                "

                                class="absolute left-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-md transition hover:border-green-500 hover:bg-green-500 hover:text-white"
                                aria-label="Poprzednie zdjęcie"
                              >
                                <i class="fas fa-chevron-left"></i>
                              </button>


                              <button
                                type="button"

                                @click="
                                  activeIndex =
                                    activeIndex === total - 1
                                      ? 0
                                      : activeIndex + 1
                                "

                                class="absolute right-4 top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-md transition hover:border-green-500 hover:bg-green-500 hover:text-white"
                                aria-label="Następne zdjęcie"
                              >
                                <i class="fas fa-chevron-right"></i>
                              </button>


                              <div
                                class="absolute right-4 top-4 z-20 rounded-full bg-slate-950/80 px-3 py-1 text-xs font-bold tracking-wider text-white"
                              >
                                <span
                                  x-text="activeIndex + 1"
                                ></span>

                                /

                                <span
                                  x-text="total"
                                ></span>
                              </div>


                              <div
                                class="absolute bottom-4 left-1/2 z-20 max-w-[85%] -translate-x-1/2 text-center md:max-w-xl"
                              >

                                {
                                  item.images.map(
                                    (img, idx) => (

                                      <p
                                        x-show={`activeIndex === ${idx}`}
                                        class="inline-block rounded-full border border-slate-200 bg-white/95 px-4 py-2 text-xs font-medium text-slate-600 shadow-sm md:text-sm"
                                      >
                                        {img.caption}
                                      </p>

                                    )
                                  )
                                }

                              </div>

                            </>

                          )
                        }

                      </div>

                    )
                    : (

                      <div
                        class="flex min-h-[180px] items-center border-b border-slate-100 bg-slate-950 p-8 text-white md:p-12"
                      >

                        <div>

                          <span
                            class="mb-3 inline-block rounded-md bg-green-500/10 px-3 py-1 text-xs font-black uppercase tracking-wider text-green-400"
                          >
                            {item.accent || "REALIZACJA"}
                          </span>


                          <div
                            class="text-2xl font-black"
                          >
                            {item.title}
                          </div>

                        </div>

                      </div>

                    )
                  }


                  <!-- ================================= -->
                  <!-- TREŚĆ -->
                  <!-- ================================= -->

                  <div
                    class="p-8 md:p-12 lg:p-14"
                  >

                    <div
                      class="mb-9 flex flex-col gap-6 border-b border-slate-100 pb-8 md:flex-row md:items-start md:justify-between"
                    >

                      <div class="max-w-3xl">

                        <span
                          class="mb-3 block text-xs font-black uppercase tracking-[0.16em] text-green-600"
                        >
                          {item.category}
                        </span>


                        <h2
                          class="text-3xl font-black tracking-tight text-slate-950 md:text-4xl"
                        >
                          {item.title}
                        </h2>


                        <p
                          class="mt-3 text-base leading-relaxed text-slate-500"
                        >
                          {item.subtitle}
                        </p>

                      </div>


                      <div
                        class="flex max-w-md flex-wrap gap-2 md:justify-end"
                      >

                        {
                          item.technologies.map((tech) => (

                            <span
                              class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-600"
                            >
                              {tech}
                            </span>

                          ))
                        }

                      </div>

                    </div>


                    <div
                      class="grid gap-8 lg:grid-cols-3"
                    >

                      <div
                        class="rounded-2xl border border-red-100 bg-red-50/40 p-6"
                      >

                        <span
                          class="mb-3 block text-xs font-black uppercase tracking-wider text-red-600"
                        >
                          Problem
                        </span>


                        <p
                          class="text-sm leading-relaxed text-slate-600"
                        >
                          {item.problem}
                        </p>

                      </div>


                      <div
                        class="rounded-2xl border border-green-100 bg-green-50/40 p-6"
                      >

                        <span
                          class="mb-3 block text-xs font-black uppercase tracking-wider text-green-700"
                        >
                          Rozwiązanie
                        </span>


                        <p
                          class="text-sm leading-relaxed text-slate-600"
                        >
                          {item.solution}
                        </p>

                      </div>


                      <div
                        class="rounded-2xl border border-blue-100 bg-blue-50/40 p-6"
                      >

                        <span
                          class="mb-3 block text-xs font-black uppercase tracking-wider text-blue-700"
                        >
                          Efekt
                        </span>


                        <p
                          class="text-sm leading-relaxed text-slate-600"
                        >
                          {item.effect}
                        </p>

                      </div>

                    </div>


                    {
                      item.services
                      && item.services.length > 0
                      && (

                        <div
                          class="mt-8 flex flex-wrap items-center gap-4 border-t border-slate-100 pt-7"
                        >

                          <span
                            class="text-sm font-bold text-slate-500"
                          >
                            Powiązane usługi:
                          </span>


                          {
                            item.services.map((service) => (

                              <a
                                href={service.href}
                                class="text-sm font-black text-green-700 hover:text-green-600"
                              >
                                {service.title} →
                              </a>

                            ))
                          }

                        </div>

                      )
                    }

                  </div>

                </article>

              ))
            }

          </div>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- CTA -->
      <!-- ================================================= -->

      <section
        class="bg-white py-24 text-slate-950"
      >

        <div
          class="container mx-auto px-4"
        >

          <div
            class="mx-auto max-w-6xl overflow-hidden rounded-[3rem] bg-slate-950 p-8 text-white md:p-14"
          >

            <div
              class="grid gap-10 lg:grid-cols-[1.4fr_0.6fr] lg:items-center"
            >

              <div>

                <span
                  class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-400"
                >
                  Twój proces nie musi wyglądać tak samo
                </span>


                <h2
                  class="mb-5 text-4xl font-black tracking-tighter md:text-5xl"
                >
                  Masz inny problem do zautomatyzowania?
                </h2>


                <p
                  class="max-w-3xl text-lg leading-relaxed text-slate-400"
                >
                  Nie musisz wiedzieć, czy potrzebujesz
                  Excela, API, C#, Pythona, SharePoint
                  czy innej technologii.
                  Opisz sposób pracy i oczekiwany efekt.
                </p>


                <p
                  class="mt-5 text-sm font-bold text-slate-300"
                >
                  Realizujemy również mniejsze poprawki
                  i automatyzacje — nie każdy projekt
                  musi być dużym wdrożeniem.
                </p>

              </div>


              <div
                class="lg:text-right"
              >

                <a
                  href="#kontakt"
                  class="inline-flex items-center justify-center rounded-2xl bg-green-500 px-8 py-5 text-sm font-black uppercase tracking-widest text-slate-950 transition-all hover:-translate-y-1 hover:bg-green-400"
                >
                  Opisz swój proces
                </a>

              </div>

            </div>

          </div>

        </div>

      </section>


      <Contact />

    </main>


    <Footer />


    <!-- ================================================= -->
    <!-- LIGHTBOX -->
    <!-- ================================================= -->

    <div
      x-show="lightboxOpen"

      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"

      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"

      class="fixed inset-0 z-[9999] flex h-screen w-screen select-none flex-col justify-between overflow-hidden bg-slate-950/98 backdrop-blur-md"

      style="display: none;"

      @click="closeLightbox()"
    >

      <div
        class="z-30 flex w-full items-center justify-between bg-gradient-to-b from-slate-950/90 to-transparent p-4 md:p-6"
      >

        <div
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-bold tracking-wider text-slate-300"
        >
          Zdjęcie

          <span
            x-text="lightboxIndex + 1"
            class="text-green-400"
          ></span>

          z

          <span
            x-text="lightboxImages.length"
          ></span>
        </div>


        <button
          type="button"

          @click.stop="closeLightbox()"

          class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-white/10 text-white transition-all hover:bg-white/20"

          aria-label="Zamknij"
        >
          <i class="fas fa-times"></i>
        </button>

      </div>


      <div
        class="relative flex w-full flex-1 items-center justify-center overflow-hidden p-2 md:p-8"
      >

        <button
          type="button"

          @click.stop="prevLightbox()"

          class="absolute left-4 top-1/2 z-30 flex h-14 w-14 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-slate-900/60 text-white transition-all hover:bg-green-600 md:left-8"

          aria-label="Poprzednie"
        >
          <i class="fas fa-chevron-left"></i>
        </button>


        <div
          class="flex h-full w-full items-center justify-center p-4"
        >

          <img
            x-bind:src="lightboxImages[lightboxIndex]?.src"

            x-bind:alt="lightboxImages[lightboxIndex]?.alt"

            class="max-h-full max-w-full rounded-lg object-contain shadow-2xl"

            @click.stop
          />

        </div>


        <button
          type="button"

          @click.stop="nextLightbox()"

          class="absolute right-4 top-1/2 z-30 flex h-14 w-14 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-slate-900/60 text-white transition-all hover:bg-green-600 md:right-8"

          aria-label="Następne"
        >
          <i class="fas fa-chevron-right"></i>
        </button>

      </div>


      <div
        class="z-30 w-full bg-gradient-to-t from-slate-950/90 to-transparent p-6 text-center"
      >

        <p
          x-text="lightboxImages[lightboxIndex]?.caption"

          class="mx-auto inline-block max-w-3xl rounded-full border border-white/5 bg-slate-900/80 px-6 py-2.5 text-sm font-medium text-slate-200 md:text-base"
        ></p>

      </div>

    </div>

  </div>

</BaseLayout>


<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
</style>