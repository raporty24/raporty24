    ],

    accent: "KALKULATORY",
  },


  {
    slug: "automatyzacja-api-aplikacje",

    title:
      "Automatyzacja plików, API i małe aplikacje",

    subtitle:
      "Narzędzia do pobierania, przetwarzania i przekazywania danych",

    category:
      "Automatyzacja • API • aplikacje",

    problem:
      "W firmach część pracy nadal polega na ręcznym pobieraniu plików, kopiowaniu danych między systemami, poprawianiu CSV, przygotowywaniu eksportów i wykonywaniu tych samych operacji na kolejnych zestawach danych.",

    solution:
