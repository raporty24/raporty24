---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";


type RealizationImage = {
  src: string;
  alt: string;
  caption: string;
};


type ServiceLink = {
  title: string;
  href: string;
};


type Realization = {
  slug: string;
  title: string;
  subtitle: string;
  category: string;
  problem: string;
  solution: string;
  effect: string;
  technologies: string[];
  services?: ServiceLink[];
  featured?: boolean;
  accent?: string;
  images?: RealizationImage[];
};


const pageTitle =
  "Realizacje automatyzacji, Excel, API i aplikacji dla firm | Raporty24";

const pageDescription =
  "Zobacz realizacje Raporty24: automatyzacje procesów, Excel, API, KSeF, systemy magazynowe, kalkulatory, aplikacje i narzędzia do pracy z danymi.";

const ogImage =
  "/realizacje/KSEF_EXPORTER_PRO_1.webp";

const currentUrl =
  "https://raporty24.pl/realizacje/";


/*
 * =========================================================
 * REALIZACJE
 * =========================================================
 */

const realizations: Realization[] = [
  {
    slug: "ksef-exporter-pro",

    title: "KSeF Exporter Pro",

    subtitle:
      "Lokalna aplikacja do pobierania i eksportowania danych z KSeF",

    category:
      "KSeF • dokumenty • automatyzacja danych",

    problem:
      "Dane z faktur wymagają dalszej analizy i wykorzystania poza systemem źródłowym. Ręczne przeglądanie dokumentów oraz przygotowywanie zestawień utrudnia szybką pracę z większą liczbą faktur.",

    solution:
      "Powstała lokalna aplikacja Windows umożliwiająca pobieranie danych z KSeF, przeglądanie faktur i ich pozycji, filtrowanie informacji oraz eksport do formatów Excel, CSV i XML. Użytkownik może również korzystać z własnych szablonów kolumn eksportu.",

    effect:
      "Dane z faktur mogą zostać przygotowane w uporządkowanej formie do dalszej analizy, pracy w Excelu lub przekazania do kolejnego procesu bez ręcznego przepisywania informacji.",

    technologies: [
      "KSeF",
      "Python",
      "Windows",
      "Excel",
      "CSV",
      "XML",
      "aplikacja desktopowa",
    ],

    services: [
      {
        title: "Automatyzacja plików i procesów",
        href: "/uslugi/skrypty-python/",
      },

      {
        title: "Integracje API",
        href: "/uslugi/integracje-api/",
      },
    ],

    featured: true,

    images: [
      {
        src: "/realizacje/KSEF_EXPORTER_PRO_1.webp",

        alt:
