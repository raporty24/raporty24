---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

const title =
  "Lejek sprzedaży w Excelu | Pipeline i konwersja | Raporty24";

const description =
  "Lejek sprzedaży w Excelu do analizy pipeline, konwersji, wartości szans i etapów sprzedaży. Raporty dla handlowców i zarządzających dopasowane do procesu firmy.";

const ogImage = "/biuro3.webp";
const currentUrl =
  "https://raporty24.pl/uslugi/lejek-sprzedazy-w-excelu/";

export const service = {
  title: "Lejek sprzedaży w Excelu",
  order: 30,
  menu: true,
  category: "Excel",
};

const funnelMetrics = [
  {
    icon: "fas fa-percentage",
    title: "Konwersja etapów",
    description:
      "Sprawdzasz, jaki procent szans przechodzi z jednego etapu sprzedaży do kolejnego i gdzie najczęściej odpadają potencjalni klienci.",
  },
  {
    icon: "fas fa-coins",
    title: "Wartość pipeline",
    description:
      "Widzisz łączną wartość aktywnych szans sprzedażowych i możesz analizować ją według etapu, handlowca, produktu lub innego kryterium.",
  },
  {
    icon: "fas fa-hourglass-half",
    title: "Czas na etapach",
    description:
      "Możemy analizować, jak długo szanse pozostają na poszczególnych etapach i gdzie proces sprzedaży zaczyna się zatrzymywać.",
  },
  {
    icon: "fas fa-user-tie",
    title: "Wyniki handlowców",
    description:
      "Porównanie liczby szans, wartości pipeline, konwersji i innych wskaźników przypisanych do poszczególnych osób lub zespołów.",
  },
  {
    icon: "fas fa-bullhorn",
    title: "Źródła leadów",
    description:
      "Analiza tego, skąd pochodzą szanse sprzedażowe i które źródła generują wartościowe leady.",
  },
  {
    icon: "fas fa-chart-line",
    title: "Prognoza sprzedaży",
    description:
      "Możemy przygotować prognozę opartą na aktywnych szansach i ustalonych zasadach prawdopodobieństwa, jeśli taki model ma sens w Twoim procesie.",
  },
];

const faqItems = [
  {
    question: "Czym lejek sprzedaży różni się od CRM w Excelu?",
    answer:
      "CRM obejmuje szerszy proces obsługi klientów i leadów: historię kontaktów, zadania, follow-upy, handlowców i etapy sprzedaży. Lejek koncentruje się przede wszystkim na analizie pipeline, przejść między etapami, konwersji, wartości szans i wyników sprzedaży.",
  },
  {
    question: "Czy etapy lejka można dopasować do naszej sprzedaży?",
    answer:
      "Tak. Etapy mogą odpowiadać rzeczywistemu procesowi firmy, np. nowy lead, kwalifikacja, oferta, negocjacje, decyzja, wygrana lub utracona szansa.",
  },
  {
    question: "Czy można analizować konwersję pomiędzy etapami?",
    answer:
      "Tak. Jeśli dane pozwalają śledzić historię lub aktualne etapy szans, możemy przygotować wskaźniki pokazujące przejścia i konwersję w procesie sprzedaży.",
  },
  {
    question: "Czy lejek może pobierać dane z innych źródeł?",
    answer:
      "Tak. W zależności od źródła możemy wykorzystać Power Query, pliki, SharePoint, API lub inne rozwiązanie do zasilania raportu danymi.",
  },
  {
    question: "Czy potrzebuję lejka, jeśli mam już CRM?",
    answer:
      "Niekoniecznie. Jeśli CRM dostarcza wszystkie potrzebne raporty, osobne rozwiązanie może nie być potrzebne. Lejek w Excelu ma sens np. wtedy, gdy firma potrzebuje własnej analityki, dodatkowego raportowania lub danych z kilku źródeł.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Lejek sprzedaży w Excelu",
    description,
    url: currentUrl,
    provider: {
      "@type": "Organization",
      name: "Raporty24",
      url: "https://raporty24.pl/",
    },
    serviceType:
      "Analiza lejka sprzedaży, pipeline i konwersji w Excelu",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Strona główna",
        item: "https://raporty24.pl/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Usługi",
        item: "https://raporty24.pl/uslugi/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Lejek sprzedaży w Excelu",
        item: currentUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  url={currentUrl}
  structuredData={structuredData}
>
  <div x-data="app" x-cloak>
    <Header />

    <main>

      <HeroService
        eyebrow="Sprzedaż i analiza pipeline"
        title="Lejek sprzedaży"
        highlight="w Excelu"
        subtitle="Analizuj etapy sprzedaży, konwersję, wartość aktywnych szans i miejsca, w których proces zaczyna się zatrzymywać."
        ctaText="Opisz swój proces sprzedaży"
      />


      <!-- ===================================================== -->
      <!-- PO CO LEJEK -->
      <!-- ===================================================== -->

      <section
        class="bg-white py-20 text-slate-950 lg:py-28"
      >
        <div class="container mx-auto px-4">

          <div class="mx-auto max-w-6xl">

            <div class="max-w-4xl">

              <p
                class="mb-4 text-xs font-black uppercase tracking-[0.2em] text-green-600"
              >
                Więcej niż lista szans
              </p>

              <h2
                class="text-4xl font-black tracking-tighter lg:text-6xl"
              >
                Zobacz, co dzieje się
                <span class="text-green-600">
                  pomiędzy leadem a sprzedażą.
                </span>
              </h2>

              <p
                class="mt-7 max-w-3xl text-lg leading-relaxed text-slate-600"
              >
                Sama liczba klientów lub ofert niewiele mówi
                o jakości procesu sprzedaży. Lejek pozwala zobaczyć,
                ile szans znajduje się na poszczególnych etapach,
                jaka jest ich wartość i w którym miejscu
                potencjalni klienci najczęściej odpadają.
              </p>

            </div>


            <div
              class="mt-14 grid gap-6 md:grid-cols-3"
            >

              <article
                class="rounded-[2rem] border border-slate-200 bg-slate-50 p-8"
              >
                <i
                  class="fas fa-filter mb-6 text-2xl text-green-600"
                  aria-hidden="true"
                ></i>

                <h3
                  class="mb-3 text-xl font-black"
                >
                  Etapy sprzedaży
                </h3>

                <p
                  class="text-sm leading-relaxed text-slate-600"
                >
                  Pipeline może odzwierciedlać rzeczywisty proces:
                  od nowego zapytania, przez ofertę i negocjacje,
                  aż do wygranej lub utraconej szansy.
                </p>
              </article>


              <article
                class="rounded-[2rem] border border-slate-200 bg-slate-50 p-8"
              >
                <i
                  class="fas fa-chart-pie mb-6 text-2xl text-green-600"
                  aria-hidden="true"
                ></i>

                <h3
                  class="mb-3 text-xl font-black"
                >
                  Konwersja
                </h3>

                <p
                  class="text-sm leading-relaxed text-slate-600"
                >
                  Możesz analizować, jaka część szans
                  przechodzi pomiędzy kolejnymi etapami
                  i gdzie sprzedaż traci najwięcej potencjału.
                </p>
              </article>


              <article
                class="rounded-[2rem] border border-slate-200 bg-slate-50 p-8"
              >
                <i
                  class="fas fa-search-dollar mb-6 text-2xl text-green-600"
                  aria-hidden="true"
                ></i>

                <h3
                  class="mb-3 text-xl font-black"
                >
                  Wartość szans
                </h3>

                <p
                  class="text-sm leading-relaxed text-slate-600"
                >
                  Pipeline pokazuje nie tylko liczbę tematów,
                  ale również ich wartość i strukturę
                  na poszczególnych etapach procesu.
                </p>
              </article>

            </div>

          </div>

        </div>
      </section>


      <!-- ===================================================== -->
      <!-- METRYKI -->
      <!-- ===================================================== -->

      <section
        class="relative overflow-hidden bg-slate-950 py-20 text-white lg:py-28"
      >

        <div
          class="pointer-events-none absolute -right-24 top-0 h-96 w-96 rounded-full bg-green-500/10 blur-[120px]"
          aria-hidden="true"
        ></div>


        <div class="container relative z-10 mx-auto px-4">

          <div class="mx-auto max-w-6xl">

            <div class="max-w-4xl">

              <p
                class="mb-4 text-xs font-black uppercase tracking-[0.2em] text-green-400"
              >
                Analiza pipeline
              </p>

              <h2
                class="text-4xl font-black tracking-tighter lg:text-6xl"
              >
                Jakie informacje może pokazywać
                <span class="text-green-400">
                  lejek sprzedaży?
                </span>
              </h2>

              <p
                class="mt-7 max-w-3xl text-lg leading-relaxed text-slate-400"
              >
                Zakres wskaźników zależy od tego,
                jakie dane są dostępne i jak wygląda
                proces sprzedaży w Twojej firmie.
              </p>

            </div>


            <div
              class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3"
            >
              {
                funnelMetrics.map((item) => (
                  <article
                    class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-8 transition-all hover:border-green-500/30 hover:bg-white/[0.06]"
                  >
                    <div
                      class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-green-500/10 text-green-400"
                    >
                      <i
                        class={`${item.icon} text-xl`}
                        aria-hidden="true"
                      ></i>
                    </div>

                    <h3
                      class="mb-4 text-xl font-black text-white"
                    >
                      {item.title}
                    </h3>

                    <p
                      class="text-sm leading-relaxed text-slate-400"
                    >
                      {item.description}
                    </p>
                  </article>
                ))
              }
            </div>

          </div>

        </div>
      </section>


      <!-- ===================================================== -->
      <!-- LEJEK VS CRM -->
      <!-- ===================================================== -->

      <section
        class="bg-white py-20 lg:py-28"
      >
        <div class="container mx-auto px-4">

          <div class="mx-auto max-w-6xl">

            <div class="max-w-4xl">

              <p
                class="mb-4 text-xs font-black uppercase tracking-[0.2em] text-green-600"
              >
                Lejek czy CRM?
              </p>

              <h2
                class="text-4xl font-black tracking-tighter text-slate-950 lg:text-5xl"
              >
                To podobne narzędzia,
                ale mają
                <span class="text-green-600">
                  inne zadania.
                </span>
              </h2>

              <p
                class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600"
              >
                CRM pomaga prowadzić proces sprzedaży.
                Lejek koncentruje się na jego analizie.
                W praktyce oba rozwiązania mogą również
                działać razem.
              </p>

            </div>


            <div
              class="mt-12 grid gap-6 md:grid-cols-2"
            >

              <article
                class="rounded-[2rem] border border-green-500/30 bg-green-50 p-8 lg:p-10"
              >

                <span
                  class="mb-4 block text-xs font-black uppercase tracking-widest text-green-700"
                >
                  Analiza sprzedaży
                </span>

                <h3
                  class="mb-5 text-2xl font-black text-slate-950"
                >
                  Lejek sprzedaży
                </h3>

                <ul
                  class="space-y-3 text-sm leading-relaxed text-slate-700"
                >
                  <li>✓ etapy pipeline</li>
                  <li>✓ konwersja między etapami</li>
                  <li>✓ wartość aktywnych szans</li>
                  <li>✓ czas na etapach</li>
                  <li>✓ analiza wyników</li>
                </ul>

              </article>


              <article
                class="rounded-[2rem] border border-slate-200 bg-slate-50 p-8 lg:p-10"
              >

                <span
                  class="mb-4 block text-xs font-black uppercase tracking-widest text-slate-500"
                >
                  Prowadzenie sprzedaży
                </span>

                <h3
                  class="mb-5 text-2xl font-black text-slate-950"
                >
                  CRM w Excelu
                </h3>

                <ul
                  class="space-y-3 text-sm leading-relaxed text-slate-600"
                >
                  <li>✓ klienci i leady</li>
                  <li>✓ zadania handlowców</li>
                  <li>✓ follow-upy</li>
                  <li>✓ historia kontaktów</li>
                  <li>✓ cały proces sprzedaży</li>
                </ul>

                <a
                  href="/uslugi/crm-w-excelu/"
                  class="mt-7 inline-flex font-black text-green-700 hover:text-green-600"
                >
                  Zobacz CRM w Excelu →
                </a>

              </article>

            </div>

          </div>

        </div>
      </section>


      <!-- ===================================================== -->
      <!-- ŹRÓDŁA DANYCH -->
      <!-- ===================================================== -->

      <section
        class="bg-slate-50 py-20 lg:py-28"
      >
        <div class="container mx-auto px-4">

          <div
            class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1fr] lg:items-center"
          >

            <div>

              <p
                class="mb-4 text-xs font-black uppercase tracking-[0.2em] text-green-600"
              >
                Dane nie muszą być wpisywane ręcznie
              </p>

              <h2
                class="text-4xl font-black tracking-tighter text-slate-950 lg:text-5xl"
              >
                Lejek może korzystać
                <span class="text-green-600">
                  z innych źródeł danych.
                </span>
              </h2>

              <p
                class="mt-6 text-lg leading-relaxed text-slate-600"
              >
                Jeśli dane o leadach lub sprzedaży znajdują się
                w innych plikach albo systemach,
                możemy dobrać sposób ich importu i aktualizacji.
              </p>

            </div>


            <div
              class="grid gap-5 sm:grid-cols-2"
            >

              <article
                class="rounded-2xl border border-slate-200 bg-white p-7"
              >
                <i
                  class="fas fa-file-excel mb-5 text-2xl text-green-600"
                  aria-hidden="true"
                ></i>

                <h3 class="font-black text-slate-950">
                  Excel i CSV
                </h3>

                <p
                  class="mt-2 text-sm leading-relaxed text-slate-600"
                >
                  Dane z innych arkuszy,
                  eksportów i zestawień.
                </p>
              </article>


              <article
                class="rounded-2xl border border-slate-200 bg-white p-7"
              >
                <i
                  class="fas fa-sync-alt mb-5 text-2xl text-green-600"
                  aria-hidden="true"
                ></i>

                <h3 class="font-black text-slate-950">
                  Power Query
                </h3>

                <p
                  class="mt-2 text-sm leading-relaxed text-slate-600"
                >
                  Automatyczne pobieranie
                  i porządkowanie danych.
                </p>
              </article>


              <article
                class="rounded-2xl border border-slate-200 bg-white p-7"
              >
                <i
                  class="fas fa-cloud mb-5 text-2xl text-green-600"
                  aria-hidden="true"
                ></i>

                <h3 class="font-black text-slate-950">
                  SharePoint
                </h3>

                <p
                  class="mt-2 text-sm leading-relaxed text-slate-600"
                >
                  Dane i pliki wykorzystywane
                  w środowisku Microsoft 365.
                </p>
              </article>


              <article
                class="rounded-2xl border border-slate-200 bg-white p-7"
              >
                <i
                  class="fas fa-plug mb-5 text-2xl text-green-600"
                  aria-hidden="true"
                ></i>

                <h3 class="font-black text-slate-950">
                  API i systemy
                </h3>

                <p
                  class="mt-2 text-sm leading-relaxed text-slate-600"
                >
                  Integracje, jeśli dane mają
                  pochodzić z innych aplikacji.
                </p>
              </article>

            </div>

          </div>

        </div>
      </section>


      <!-- ===================================================== -->
      <!-- FAQ -->
      <!-- ===================================================== -->

      <section
        class="bg-slate-950 py-20 text-white lg:py-28"
      >
        <div class="container mx-auto px-4">

          <div class="mx-auto max-w-5xl">

            <p
              class="mb-4 text-xs font-black uppercase tracking-[0.2em] text-green-400"
            >
              FAQ
            </p>

            <h2
              class="text-4xl font-black tracking-tighter lg:text-5xl"
            >
              Najczęstsze pytania
              <span class="text-green-400">
                o lejek sprzedaży
              </span>
            </h2>


            <div
              class="mt-12 grid gap-4"
            >
              {
                faqItems.map((item) => (
                  <details
                    class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 transition-colors hover:border-green-500/30"
                  >
                    <summary
                      class="cursor-pointer text-lg font-black text-white"
                    >
                      {item.question}
                    </summary>

                    <p
                      class="mt-4 max-w-4xl text-sm leading-relaxed text-slate-400"
                    >
                      {item.answer}
                    </p>
                  </details>
                ))
              }
            </div>

          </div>

        </div>
      </section>


      <!-- ===================================================== -->
      <!-- INTERNAL LINKING -->
      <!-- ===================================================== -->

      <section
        class="bg-slate-50 py-16"
      >
        <div class="container mx-auto px-4">

          <div
            class="mx-auto max-w-5xl rounded-[2rem] border border-slate-200 bg-white p-8 md:p-10"
          >

            <h2
              class="text-2xl font-black text-slate-950"
            >
              Potrzebujesz czegoś więcej niż raport pipeline?
            </h2>

            <p
              class="mt-4 max-w-3xl leading-relaxed text-slate-600"
            >
              Możemy rozszerzyć rozwiązanie o pełny CRM,
              bazę klientów, automatyzację importu danych
              lub dodatkowe raportowanie.
            </p>


            <div
              class="mt-6 flex flex-wrap gap-x-6 gap-y-3"
            >

              <a
                href="/uslugi/crm-w-excelu/"
                class="font-bold text-green-700 hover:text-green-600"
              >
                CRM w Excelu →
              </a>

              <a
                href="/uslugi/baza-klientow-w-excelu/"
                class="font-bold text-green-700 hover:text-green-600"
              >
                Baza klientów →
              </a>

              <a
                href="/uslugi/automatyzacja-excel-power-query/"
                class="font-bold text-green-700 hover:text-green-600"
              >
                Excel i Power Query →
              </a>

              <a
                href="/uslugi/power-bi-dla-firm/"
                class="font-bold text-green-700 hover:text-green-600"
              >
                Power BI dla firm →
              </a>

            </div>

          </div>

        </div>
      </section>


      <Contact />

    </main>

    <Footer />
  </div>
</BaseLayout>