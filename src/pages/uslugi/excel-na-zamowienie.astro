---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

// SEO Setup - Zoptymalizowane pod pozycje 10-15 w GSC
const title = "Excel na zamówienie – Automatyzacja, Makra VBA i AI dla Firm";
const description = "Zleć profesjonalne arkusze Excel na zamówienie. Pisanie makr VBA, automatyzacja raportów i integracja z AI (ChatGPT). Darmowa wycena w 24h!";

const ogImage = "/biuro3.webp"; 
const currentUrl = "https://raporty24.pl/uslugi/excel-na-zamowienie/";

export const service = {
  title: "Excel na zamówienie",
  order: 10,
  menu: true,
  category: "Excel",
};
---

<BaseLayout title={title} description={description} image={ogImage} url={currentUrl}>
  <div x-data="app" x-cloak>
    <Header />
    
    <HeroService
      title="Dedykowany" 
      highlight="Excel na zamówienie" 
      subtitle="Budujemy inteligentne arkusze, które eliminują ręczną pracę. Od makr VBA po zaawansowane integracje z AI."
    />

    <section class="py-24 bg-white text-slate-900">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl font-black uppercase tracking-tighter mb-8 leading-none">
              Twój Excel wolno działa? <br/> <span class="text-green-600">Czas na automatyzację.</span>
            </h2>
            <p class="text-lg text-slate-600 mb-6 leading-relaxed">
              Ręczne przepisywanie danych to kosztowny błąd. Nasz <strong>ekspert Excel</strong> przygotuje dla Ciebie rozwiązanie, które skróci czas pracy o 80%. Oferujemy profesjonalne <strong>pisanie makr VBA</strong> oraz <strong>tworzenie raportów w Excelu</strong> dopasowanych do Twojego biznesu.
            </p>
            <p class="text-md text-slate-600 mb-8 leading-relaxed bg-slate-50 p-4 border-l-4 border-green-500 rounded-r-lg">
              <i class="fas fa-robot text-indigo-600 mr-2"></i> <strong>Nowość:</strong> Integrujemy arkusze z <strong>AI (ChatGPT)</strong>. Twój Excel może teraz sam kategoryzować dane, pisać maile i analizować teksty.
            </p>

            <ul class="space-y-4 mb-10">
              <li class="flex items-center gap-3 font-bold"><i class="fas fa-check-circle text-green-500"></i> Zero błędów w obliczeniach i bezpieczne makra</li>
              <li class="flex items-center gap-3 font-bold"><i class="fas fa-check-circle text-green-500"></i> Błyskawiczne generowanie PDF, ofert i faktur</li>
              <li class="flex items-center gap-3 font-bold"><i class="fas fa-check-circle text-green-500"></i> Pomoc w Excelu "na ratunek" dla Twoich plików</li>
            </ul>

            <div>
              <a href="#kontakt" class="inline-block bg-green-600 text-white font-black py-4 px-10 rounded-full hover:bg-green-700 hover:scale-105 transition-all shadow-xl shadow-green-500/30 text-lg uppercase tracking-tight">
                Opisz problem – Darmowa wycena
              </a>
              <span class="block text-sm text-slate-500 mt-3 font-medium">
                <i class="fas fa-bolt text-yellow-500 mr-1"></i> Odpowiadamy średnio w 4 godziny
              </span>
            </div>
          </div>

          <div class="bg-slate-50 p-8 rounded-[40px] border-2 border-slate-200">
            <h3 class="text-2xl font-black mb-4 uppercase text-slate-900">Co możemy dla Ciebie stworzyć?</h3>
            <p class="text-sm text-slate-600 mb-6 font-medium">Suche fakty: oto najczęściej wybierane rozwiązania przez naszych klientów:</p>
            
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Makra i VBA</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Automatyzacja powtarzalnych czynności jednym kliknięciem.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 490 zł netto</span>
              </div>
              
              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-indigo-600 hover:shadow-md transition-shadow ring-2 ring-indigo-50">
                <h4 class="font-bold block text-slate-800 flex items-center gap-2">Excel + AI <span class="text-[10px] bg-indigo-600 text-white px-1.5 py-0.5 rounded">NEW</span></h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Połączenie z ChatGPT do analizy danych i generowania treści.</span>
                <span class="inline-block bg-indigo-100 text-indigo-800 text-[10px] px-2 py-1 rounded font-black">Od 1200 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Generatory PDF</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Automatyczne tworzenie ofert, faktur i umów prosto z tabeli.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 600 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">CRM i Magazyn</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Dedykowane bazy klientów i stany magazynowe w Excelu.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 1500 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Power Query</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Automatyczne pobieranie danych z ERP, SQL i plików zewnętrznych.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 700 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow text-center flex flex-col justify-center">
                <h4 class="font-bold block text-slate-400 italic italic">Twoje wyzwanie?</h4>
                <span class="text-[11px] text-slate-400">Napisz do nas.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-950 text-white">
      <div class="container mx-auto px-4">
        <h2 class="text-4xl font-black uppercase tracking-tighter mb-16 text-center">Standard profesjonalnej usługi</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-code text-green-500"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Kodowanie VBA</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Piszemy czyste i szybkie makra, które działają stabilnie w środowisku korporacyjnym.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-indigo-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-brain text-indigo-400"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Integracje AI</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Łączymy Excela z API OpenAI, co pozwala na automatyczną obróbkę tekstów i analizę danych.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-shield-alt text-green-500"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Gwarancja i Bezpieczeństwo</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Twoje dane są u nas bezpieczne. Na każde wdrożenie udzielamy wsparcia i gwarancji technicznej.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-50 text-slate-900">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-black mb-12 uppercase tracking-tight border-l-4 border-green-500 pl-6">Najczęściej zadawane pytania (FAQ)</h2>
        <div class="space-y-4">
          {[
            { q: "Ile kosztuje stworzenie arkusza w Excelu na zamówienie?", a: "Proste kalkulatory zaczynają się od 490 zł netto. Bardziej złożone systemy (CRM, Magazyn, automatyzacja procesów) to koszt od 1500 zł netto w górę. Każdy projekt wyceniamy indywidualnie po darmowym audycie." },
            { q: "Jak działa integracja Excela z AI?", a: "Wykorzystujemy klucz API OpenAI (ChatGPT), który łączymy z Twoim arkuszem za pomocą makra VBA. Pozwala to np. na automatyczne podsumowywanie opinii klientów w komórkach. Koszt API zależy od zużycia, zazwyczaj to kilka dolarów miesięcznie." },
            { q: "Ile trwa realizacja zlecenia?", a: "Mniejsze poprawki w arkuszach robimy w 2-3 dni. Budowa kompletnego systemu od zera trwa zazwyczaj od 7 do 14 dni roboczych." },
            { q: "Czy plik będzie działał na MacOS?", a: "Makra VBA działają inaczej na Macu niż na Windowsie. Jeśli korzystasz z komputera Apple, poinformuj nas o tym na początku – dostosujemy kod do Twojego systemu." }
          ].map(item => (
            <div class="p-6 rounded-2xl bg-white shadow-sm border border-slate-200 hover:border-green-500/50 transition-all">
              <h4 class="font-bold text-slate-900 mb-2">{item.q}</h4>
              <p class="text-slate-600 text-sm leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
    <Footer />
  </div>
</BaseLayout>