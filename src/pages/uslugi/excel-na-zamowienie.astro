---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

const title =
  "Excel na zamówienie dla firm | Automatyzacja i integracje | Raporty24";

const description =
  "Tworzymy Excel na zamówienie dla firm: raporty, kalkulatory, Power Query, VBA, API, SharePoint, dodatki do Excela i automatyzacje procesów.";

const ogImage = "/biuro3.webp";

const currentUrl =
  "https://raporty24.pl/uslugi/excel-na-zamowienie/";

export const service = {
  title: "Excel na zamówienie",
  order: 10,
  menu: true,
  category: "Excel",
  description:
    "Dedykowane narzędzia Excel dla firm: raporty, kalkulatory, formularze, Power Query, VBA, integracje API, SharePoint i dodatki.",
};


/*
 * =========================================================
 * GŁÓWNE RODZAJE ROZWIĄZAŃ
 * =========================================================
 */

const solutions = [
  {
    title: "Dedykowane arkusze",
    description:
      "Narzędzia dopasowane do konkretnego procesu firmy zamiast uniwersalnych szablonów i ręcznego obchodzenia ograniczeń.",
    icon: "fas fa-file-excel",
  },

  {
    title: "Raporty i zestawienia",
    description:
      "Raporty operacyjne, finansowe, sprzedażowe, magazynowe i zarządcze odświeżane na podstawie aktualnych danych.",
    icon: "fas fa-chart-bar",
  },

  {
    title: "Kalkulatory i formularze",
    description:
      "Kalkulatory ofertowe, konfiguratory, formularze zamówień, wyceny i narzędzia wspierające codzienną pracę zespołu.",
    icon: "fas fa-calculator",
  },

  {
    title: "Automatyzacja danych",
    description:
      "Power Query, importy, eksporty i przetwarzanie plików zamiast ręcznego kopiowania danych pomiędzy arkuszami.",
    icon: "fas fa-database",
  },

  {
    title: "Integracje z systemami",
    description:
      "Excel może pobierać lub wysyłać dane przez API do sklepu, CRM, ERP, bazy danych lub innego systemu firmy.",
    icon: "fas fa-plug",
  },

  {
    title: "Dodatki do Excela",
    description:
      "Gdy zwykły arkusz i VBA przestają wystarczać, możemy rozszerzyć Excel o własny interfejs, funkcje i logikę biznesową.",
    icon: "fas fa-cogs",
  },
];


/*
 * =========================================================
 * TYPOWE ZASTOSOWANIA
 * =========================================================
 */

const useCases = [
  "automatyczne raporty dzienne, tygodniowe i miesięczne",

  "kalkulatory cen, marży i ofert dla handlowców",

  "bazy klientów, produktów, zamówień lub zleceń",

  "formularze do wprowadzania i kontroli danych",

  "automatyczne importowanie wielu plików Excel lub CSV",

  "łączenie Excela z API sklepu, CRM, ERP lub innego systemu",

  "pobieranie danych z SharePoint lub OneDrive",

  "generowanie PDF, ofert, zestawień i dokumentów",

  "walidacja danych przed wysłaniem ich do systemu",

  "narzędzia magazynowe, logistyczne i finansowe",

  "automatyzacja powtarzalnych czynności wykonywanych przez pracowników",

  "rozbudowa istniejącego pliku o nowe funkcje i integracje",
];


/*
 * =========================================================
 * TECHNOLOGIE
 * =========================================================
 */

const technologies = [
  {
    title: "Excel i Power Query",
    description:
      "Dobre rozwiązanie, gdy dane pochodzą z plików, folderów, SharePoint, baz lub regularnych eksportów.",
    icon: "fas fa-file-excel",
  },

  {
    title: "VBA",
    description:
      "Do automatyzacji czynności wykonywanych wewnątrz Excela, formularzy, raportów, eksportów i obsługi skoroszytu.",
    icon: "fas fa-code",
  },

  {
    title: "C# i dodatki Excel",
    description:
      "Gdy potrzebny jest własny Ribbon, bardziej rozbudowany interfejs, integracja z Windows albo logika wychodząca poza typowe możliwości VBA.",
    icon: "fas fa-desktop",
  },

  {
    title: "API",
    description:
      "Do pobierania i wysyłania danych pomiędzy Excelem a sklepami, CRM, ERP, aplikacjami i innymi systemami.",
    icon: "fas fa-plug",
  },

  {
    title: "SharePoint i Microsoft 365",
    description:
      "Excel może współpracować z bibliotekami dokumentów, listami, OneDrive, Outlookiem, Power Automate i innymi elementami środowiska Microsoft 365.",
    icon: "fas fa-cloud",
  },

  {
    title: "Power BI i inne narzędzia",
    description:
      "Jeżeli Excel nie jest najlepszym miejscem na cały proces, możemy połączyć go z Power BI, bazą danych albo innym rozwiązaniem.",
    icon: "fas fa-layer-group",
  },
];


/*
 * =========================================================
 * PROCES
 * =========================================================
 */

const process = [
  {
    step: "01",
    title: "Opisujesz proces",
    description:
      "Nie potrzebujemy gotowej specyfikacji technicznej. Wystarczy opisać, co dziś robicie ręcznie, z jakich danych korzystacie i jaki ma być efekt.",
  },

  {
    step: "02",
    title: "Projektujemy rozwiązanie",
    description:
      "Ustalamy strukturę narzędzia, źródła danych, funkcje, uprawnienia i technologię potrzebną do realizacji procesu.",
  },

  {
    step: "03",
    title: "Budujemy i testujemy",
    description:
      "Tworzymy rozwiązanie i sprawdzamy je na rzeczywistych przypadkach, w tym na błędnych lub niekompletnych danych.",
  },

  {
    step: "04",
    title: "Przekazujemy do pracy",
    description:
      "Użytkownicy otrzymują gotowe narzędzie oraz sposób obsługi dopasowany do ich codziennej pracy.",
  },
];


/*
 * =========================================================
 * FAQ
 * =========================================================
 */

const faqs = [
  {
    question:
      "Ile kosztuje Excel na zamówienie?",

    answer:
      "Cena zależy od zakresu procesu, liczby funkcji, źródeł danych i potrzebnych integracji. Prosty kalkulator i rozbudowane narzędzie połączone z API to dwa różne projekty, dlatego najpierw analizujemy wymagania i przygotowujemy wycenę.",
  },

  {
    question:
      "Czy muszę wiedzieć, czy potrzebuję VBA, Power Query, C# albo API?",

    answer:
      "Nie. Najlepiej opisać proces biznesowy i oczekiwany efekt. Technologię dobieramy dopiero po analizie sposobu pracy, źródeł danych i środowiska użytkowników.",
  },

  {
    question:
      "Czy możecie rozbudować Excel, który już mamy?",

    answer:
      "Tak. Możemy przeanalizować istniejący skoroszyt, naprawić problemy, dodać nowe funkcje, zmienić sposób pobierania danych albo przebudować najbardziej problematyczne elementy.",
  },

  {
    question:
      "Czy Excel może pobierać dane z API?",

    answer:
      "Tak. Excel może być interfejsem użytkownika, a dane mogą być pobierane lub wysyłane do sklepu, CRM, ERP albo innego systemu przez API.",
  },

  {
    question:
      "Czy tworzycie dodatki do Excela w C#?",

    answer:
      "Tak. Przy bardziej rozbudowanych rozwiązaniach możemy przygotować dodatek z własnymi przyciskami, formularzami i logiką biznesową. Dobór technologii zależy od środowiska firmy i wymaganej funkcjonalności.",
  },

  {
    question:
      "Czy Excel może współpracować z SharePoint i Microsoft 365?",

    answer:
      "Tak. Możemy pracować z danymi i plikami przechowywanymi w SharePoint lub OneDrive oraz łączyć proces z innymi elementami środowiska Microsoft 365, np. Outlookiem, Power Automate lub Power BI.",
  },

  {
    question:
      "Czy można połączyć Excel z AI?",

    answer:
      "Tak, jeśli ma to uzasadnienie biznesowe. Modele AI mogą wspierać np. klasyfikację tekstu, analizę opisów lub przetwarzanie nieustrukturyzowanych informacji. Nie dodajemy AI tam, gdzie zwykła automatyzacja jest prostsza i bardziej przewidywalna.",
  },

  {
    question:
      "Czy rozwiązania działają na Windows i macOS?",

    answer:
      "Część rozwiązań może działać na obu systemach, ale niektóre funkcje VBA, dodatki do Excela i narzędzia Microsoft mają różne możliwości na Windows i macOS. Dlatego środowisko użytkowników ustalamy przed rozpoczęciem projektu.",
  },

  {
    question:
      "Czy możemy podpisać NDA przed przekazaniem danych?",

    answer:
      "Tak. Jeżeli analiza wymaga przekazania poufnych plików lub danych firmowych, możemy wcześniej ustalić zasady poufności i podpisać NDA.",
  },
];


/*
 * =========================================================
 * STRUCTURED DATA
 * =========================================================
 */

const serviceSchema = {
  "@context": "https://schema.org",

  "@type": "Service",

  name:
    "Excel na zamówienie dla firm",

  provider: {
    "@type": "Organization",

    "@id":
      "https://raporty24.pl/#organization",

    name:
      "Raporty24",

    url:
      "https://raporty24.pl/",
  },

  areaServed: {
    "@type": "Country",
    name: "Polska",
  },

  serviceType:
    "Excel na zamówienie, automatyzacja Excel, Power Query, VBA, dodatki Excel, integracje API i SharePoint",

  url:
    currentUrl,

  description,
};


const breadcrumbSchema = {
  "@context": "https://schema.org",

  "@type": "BreadcrumbList",

  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Raporty24",
      item: "https://raporty24.pl/",
    },

    {
      "@type": "ListItem",
      position: 2,
      name: "Usługi",
      item: "https://raporty24.pl/uslugi/",
    },

    {
      "@type": "ListItem",
      position: 3,
      name: "Excel na zamówienie",
      item: currentUrl,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  url={currentUrl}
  structuredData={[
    serviceSchema,
    breadcrumbSchema
  ]}
>

  <div
    x-data="app"
    x-cloak
  >

    <Header />


    <!-- ================================================= -->
    <!-- HERO -->
    <!-- ================================================= -->

    <HeroService
      eyebrow="Dedykowane narzędzia Excel dla firm"
      title="Excel na zamówienie"
      highlight="dopasowany do Twojego procesu"
      subtitle="Tworzymy rozwiązania Excel, które nie kończą się na tabeli i kilku formułach. Raporty, kalkulatory, Power Query, VBA, API, SharePoint, dodatki do Excela i automatyzacje dopasowane do sposobu pracy firmy."
      ctaText="Opisz swój proces"
    />


    <!-- ================================================= -->
    <!-- GŁÓWNA SEKCJA -->
    <!-- ================================================= -->

    <section
      class="bg-white py-24 text-slate-950"
    >

      <div
        class="container mx-auto px-4"
      >

        <div
          class="grid gap-16 lg:grid-cols-2 lg:items-center"
        >

          <div>

            <span
              class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
            >
              Nie szablon. Narzędzie do konkretnej pracy.
            </span>


            <h2
              class="mb-8 text-4xl font-black leading-tight tracking-tighter md:text-6xl"
            >
              Excel może obsługiwać proces firmy,
              a nie tylko przechowywać dane.
            </h2>


            <div
              class="space-y-6 text-lg leading-relaxed text-slate-600"
            >

              <p>
                W wielu firmach Excel jest miejscem, do którego
                ostatecznie trafiają dane z kilku systemów,
                e-maili, plików i pracowników.
              </p>


              <p>
                Dobrze zaprojektowane narzędzie może nie tylko
                przechowywać te informacje, ale również je
                sprawdzać, przeliczać, raportować i przekazywać dalej.
              </p>


              <p>
                <strong class="text-slate-950">
                  Nie zakładamy jednak, że wszystko musi zostać
                  wykonane w samym Excelu.
                </strong>

                Jeżeli proces wymaga API, SharePoint,
                dodatkowej aplikacji albo dodatku C#,
                możemy połączyć te elementy w jedno rozwiązanie.
              </p>

            </div>


            <div
              class="mt-10 flex flex-col gap-4 sm:flex-row"
            >

              <a
                href="#kontakt"
                class="inline-flex items-center justify-center gap-3 rounded-2xl bg-green-600 px-8 py-5 text-sm font-black uppercase tracking-widest text-white transition-all hover:-translate-y-1 hover:bg-green-500"
              >
                Opisz potrzebne narzędzie

                <i
                  class="fas fa-arrow-right text-xs"
                  aria-hidden="true"
                ></i>
              </a>


              <a
                href="/realizacje/"
                class="inline-flex items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-white px-8 py-5 text-sm font-black uppercase tracking-widest text-slate-950 transition-all hover:-translate-y-1 hover:border-green-500"
              >
                Zobacz realizacje
              </a>

            </div>

          </div>


          <!-- PRZYKŁADOWY PRZEPŁYW -->
          <div
            class="rounded-[3rem] border border-slate-100 bg-slate-50 p-8 shadow-xl shadow-slate-200/60 md:p-10"
          >

            <h3
              class="mb-8 text-2xl font-black text-slate-950"
            >
              Przykładowe narzędzie
            </h3>


            <div class="space-y-4">

              <div
                class="rounded-2xl bg-white p-5 shadow-sm"
              >
                <span
                  class="mb-1 block text-[10px] font-black uppercase tracking-wider text-slate-400"
                >
                  Dane
                </span>

                <p class="font-bold text-slate-700">
                  Excel / CSV / SharePoint / API / system
                </p>
              </div>


              <div
                class="flex justify-center text-green-600"
                aria-hidden="true"
              >
                <i class="fas fa-arrow-down"></i>
              </div>


              <div
                class="rounded-2xl bg-slate-950 p-5 text-white"
              >
                <span
                  class="mb-1 block text-[10px] font-black uppercase tracking-wider text-green-400"
                >
                  Logika procesu
                </span>

                <p class="font-bold">
                  walidacja + obliczenia + automatyzacja
                </p>
              </div>


              <div
                class="flex justify-center text-green-600"
                aria-hidden="true"
              >
                <i class="fas fa-arrow-down"></i>
              </div>


              <div
                class="grid grid-cols-2 gap-3"
              >

                <div
                  class="rounded-2xl bg-white p-4 text-center shadow-sm"
                >
                  <strong class="text-sm">
                    raport
                  </strong>
                </div>

                <div
                  class="rounded-2xl bg-white p-4 text-center shadow-sm"
                >
                  <strong class="text-sm">
                    PDF
                  </strong>
                </div>

                <div
                  class="rounded-2xl bg-white p-4 text-center shadow-sm"
                >
                  <strong class="text-sm">
                    system
                  </strong>
                </div>

                <div
                  class="rounded-2xl bg-white p-4 text-center shadow-sm"
                >
                  <strong class="text-sm">
                    dashboard
                  </strong>
                </div>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- CO TWORZYMY -->
    <!-- ================================================= -->

    <section
      class="bg-slate-950 py-24 text-white"
    >

      <div class="container mx-auto px-4">

        <div
          class="mb-16 max-w-4xl"
        >

          <span
            class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-400"
          >
            Excel na zamówienie
          </span>


          <h2
            class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
          >
            Jakie rozwiązania możemy przygotować?
          </h2>


          <p
            class="text-lg leading-relaxed text-slate-400 md:text-xl"
          >
            Od prostego kalkulatora po narzędzie,
            które komunikuje się z innymi systemami firmy.
          </p>

        </div>


        <div
          class="grid gap-6 md:grid-cols-2 xl:grid-cols-3"
        >

          {
            solutions.map((item) => (

              <article
                class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-7 transition-all hover:-translate-y-1 hover:border-green-500/50 hover:bg-white/[0.08]"
              >

                <div
                  class="mb-7 flex h-14 w-14 items-center justify-center rounded-2xl bg-green-500/10 text-green-400"
                >
                  <i
                    class={`${item.icon} text-xl`}
                    aria-hidden="true"
                  ></i>
                </div>


                <h3
                  class="mb-4 text-2xl font-black leading-tight text-white"
                >
                  {item.title}
                </h3>


                <p
                  class="text-sm font-medium leading-relaxed text-slate-400"
                >
                  {item.description}
                </p>

              </article>

            ))
          }

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- PRZYKŁADY -->
    <!-- ================================================= -->

    <section
      class="bg-white py-24 text-slate-950"
    >

      <div class="container mx-auto px-4">

        <div
          class="mb-16 max-w-4xl"
        >

          <span
            class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
          >
            Przykłady zastosowań
          </span>


          <h2
            class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
          >
            Co można zrobić w Excelu dla firmy?
          </h2>


          <p
            class="text-lg leading-relaxed text-slate-600 md:text-xl"
          >
            Najlepszy projekt zaczyna się od konkretnego procesu,
            a nie od listy funkcji Excela.
          </p>

        </div>


        <div
          class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"
        >

          {
            useCases.map((item) => (

              <div
                class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-6"
              >

                <div
                  class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-950 text-[10px] text-green-400"
                >
                  <i
                    class="fas fa-check"
                    aria-hidden="true"
                  ></i>
                </div>


                <p
                  class="font-bold leading-relaxed text-slate-700"
                >
                  {item}
                </p>

              </div>

            ))
          }

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- EXCEL + INNE SYSTEMY -->
    <!-- ================================================= -->

    <section
      class="bg-slate-50 py-24 text-slate-950"
    >

      <div
        class="container mx-auto px-4"
      >

        <div
          class="grid gap-16 lg:grid-cols-2 lg:items-center"
        >

          <div>

            <span
              class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
            >
              Excel może być interfejsem
            </span>


            <h2
              class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
            >
              Pracownik zostaje w Excelu.
              Dane mogą pochodzić z innych systemów.
            </h2>


            <p
              class="mb-6 text-lg leading-relaxed text-slate-600"
            >
              Jeżeli zespół zna Excel i dobrze się w nim porusza,
              nie zawsze trzeba zmuszać użytkowników do pracy
              w zupełnie nowym programie.
            </p>


            <p
              class="text-lg leading-relaxed text-slate-600"
            >
              Excel może pozostać wygodnym interfejsem,
              a dane mogą być pobierane lub wysyłane
              automatycznie do innych systemów.
            </p>

          </div>


          <div
            class="rounded-[2.5rem] bg-slate-950 p-8 text-white md:p-10"
          >

            <h3
              class="mb-7 text-2xl font-black"
            >
              Przykład
            </h3>


            <div class="space-y-5">

              <div
                class="rounded-2xl border border-white/10 bg-white/[0.05] p-5"
              >
                <strong class="block text-green-400">
                  Pobierz
                </strong>

                <span class="text-sm text-slate-400">
                  produkty, zamówienia lub dane z systemu
                </span>
              </div>


              <div
                class="rounded-2xl border border-white/10 bg-white/[0.05] p-5"
              >
                <strong class="block text-green-400">
                  Pracuj w Excelu
                </strong>

                <span class="text-sm text-slate-400">
                  sprawdź, przelicz lub zatwierdź zmiany
                </span>
              </div>


              <div
                class="rounded-2xl border border-white/10 bg-white/[0.05] p-5"
              >
                <strong class="block text-green-400">
                  Wyślij
                </strong>

                <span class="text-sm text-slate-400">
                  zatwierdzone dane wracają do systemu przez API
                </span>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- SHAREPOINT / MICROSOFT 365 -->
    <!-- ================================================= -->

    <section
      class="bg-white py-24 text-slate-950"
    >

      <div class="container mx-auto px-4">

        <div
          class="grid gap-16 lg:grid-cols-2 lg:items-center"
        >

          <div>

            <span
              class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
            >
              Microsoft 365 i SharePoint
            </span>


            <h2
              class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
            >
              Excel może być częścią większego procesu Microsoft 365.
            </h2>


            <p
              class="mb-6 text-lg leading-relaxed text-slate-600"
            >
              Dane nie muszą znajdować się wyłącznie
              w lokalnym pliku na komputerze.
            </p>


            <p
              class="text-lg leading-relaxed text-slate-600"
            >
              Możemy połączyć Excel z SharePoint,
