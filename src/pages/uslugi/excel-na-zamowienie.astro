---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

// SEO Setup - Maksymalne podbicie pozycji i klikalności (CTR)
const title = "Excel na zamówienie – Automatyzacja, Makra VBA i AI dla Firm";
const description = "Zleć profesjonalne arkusze Excel na zamówienie. Automatyzacja raportów, pisanie makr VBA i systemy Power BI. Odzyskaj do 40h miesięcznie. Darmowa wycena w 24h!";

const ogImage = "/biuro3.webp"; 
const currentUrl = "https://raporty24.pl/uslugi/excel-na-zamowienie/";

export const service = {
  title: "Excel na zamówienie",
  order: 10,
  menu: true,
  category: "Excel",
};
---

<BaseLayout title={title} description={description} image={ogImage} url={currentUrl}>
  <div x-data="app" x-cloak>
    <Header />
    
    <HeroService
      title="Dedykowany" 
      highlight="Excel na zamówienie" 
      subtitle="Automatyzujemy arkusze, eliminując ręczną pracę i błędy. Od zaawansowanych makr VBA po systemy analityczne oparte o sztuczną inteligencję (AI)."
    />

    <section class="py-24 bg-white text-slate-900">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl font-black uppercase tracking-tighter mb-8 leading-none">
              Twój Excel wolno działa? <br/> <span class="text-green-600">Odzyskaj nawet 40h w miesiącu.</span>
            </h2>
            <p class="text-lg text-slate-600 mb-6 leading-relaxed">
              Ręczne przepisywanie danych i naprawianie wiszących formuł to kosztowny błąd Twojej firmy. Nasz <strong>ekspert Excel</strong> przygotuje dla Ciebie inteligentne rozwiązanie, które skróci czas codziennych operacji nawet o 80%. Projektujemy dedykowane <strong>systemy raportowe w Excelu</strong> oraz oferujemy profesjonalne <strong>pisanie makr VBA</strong> dopasowanych ściśle do procesów biznesowych Twojej organizacji.
            </p>
            <p class="text-md text-slate-600 mb-8 leading-relaxed bg-indigo-50/50 p-4 border-l-4 border-indigo-600 rounded-r-lg">
              <i class="fas fa-robot text-indigo-600 mr-2"></i> <strong>Automatyzacja nowej generacji:</strong> Wdrażamy bezpośrednie integracje arkuszy z <strong>AI (ChatGPT API)</strong>. Twój nowy Excel może automatycznie kategoryzować tysiące wierszy danych, samodzielnie pisać spersonalizowane maile handlowe czy masowo analizować teksty i dokumenty bez udziału człowieka.
            </p>

            <ul class="space-y-4 mb-10">
              <li class="flex items-center gap-3 font-bold text-slate-800"><i class="fas fa-shield-alt text-green-500"></i> Pełne bezpieczeństwo danych i gwarancja poufności (Podpisujemy NDA przed wdrożeniem)</li>
              <li class="flex items-center gap-3 font-bold text-slate-800"><i class="fas fa-bolt text-green-500"></i> Błyskawiczne generowanie PDF, umów, ofert i faktur jednym kliknięciem</li>
              <li class="flex items-center gap-3 font-bold text-slate-800"><i class="fas fa-check-circle text-green-500"></i> Kompleksowa pomoc w Excelu – optymalizacja i naprawa starych, wolnych plików</li>
            </ul>

            <div>
              <a href="#kontakt" class="inline-block bg-green-600 text-white font-black py-4 px-10 rounded-full hover:bg-green-700 hover:scale-105 transition-all shadow-xl shadow-green-500/30 text-lg uppercase tracking-tight">
                Odbierz darmowy audyt i wycenę w 24h
              </a>
              <span class="block text-sm text-slate-500 mt-3 font-medium">
                <i class="fas fa-lock text-slate-400 mr-1"></i> Bezpieczne przesyłanie plików – gwarancja poufności danych firmowych
              </span>
            </div>
          </div>

          <div class="bg-slate-50 p-8 rounded-[40px] border-2 border-slate-200">
            <h3 class="text-2xl font-black mb-2 uppercase text-slate-900">Systemy wysokiej marży dla biznesu</h3>
            <p class="text-sm text-slate-600 mb-6 font-medium">Wybierz gotowy kierunek zmian lub opisz nam swój własny proces:</p>
            
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-indigo-600 hover:shadow-md transition-shadow ring-2 ring-indigo-50/50">
                <h4 class="font-bold block text-slate-800 flex items-center gap-2">Excel + AI (Automatyzacja) <span class="text-[10px] bg-indigo-600 text-white px-1.5 py-0.5 rounded font-black">NAJCZĘŚCIEJ WYBIERANE</span></h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Wykorzystanie potęgi ChatGPT do autonomicznej analizy, kategoryzacji danych i automatyzacji pętli mailowych.</span>
                <span class="inline-block bg-indigo-100 text-indigo-800 text-[10px] px-2 py-1 rounded font-black">Od 1200 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Dedykowane systemy CRM i Magazyn</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Rozbudowane, zautomatyzowane bazy klientów, płatności, obieg dokumentów i stany magazynowe w jednym pliku.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 1500 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Integracje Power Query</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Automatyczne, bezpośrednie zasysanie i czyszczenie danych z systemów ERP, CRM, baz SQL oraz zewnętrznych plików.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 700 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Automatyczne Generatory PDF</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Masowe i bezbłędne tworzenie spersonalizowanych ofert, umów handlowych oraz faktur prosto z Twojej tabeli.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 600 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Makra i VBA</h4>
                <span class="text-[11px] text-slate-500 leading-relaxed block mt-1 mb-2">Przyspieszenie powtarzalnych, nudnych czynności biurowych do jednego kliknięcia dedykowanego przycisku.</span>
                <span class="inline-block bg-green-100 text-green-800 text-[10px] px-2 py-1 rounded font-black">Od 490 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-slate-400 hover:shadow-md transition-shadow text-center flex flex-col justify-center bg-slate-100/50">
                <h4 class="font-bold block text-slate-600 italic">Inny, nietypowy proces?</h4>
                <span class="text-[11px] text-slate-500">Przeanalizujemy go za darmo.</span>
                <a href="#kontakt" class="text-xs font-black text-green-600 underline mt-1 block">Opisz wyzwanie &rarr;</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-950 text-white">
      <div class="container mx-auto px-4">
        <h2 class="text-4xl font-black uppercase tracking-tighter mb-16 text-center">Standard profesjonalnej usługi B2B</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-lock text-green-500"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Gwarancja Poufności (NDA)</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Wiemy, jak wrażliwe są dane finansowe i kadrowe firm. Przed analizą procesów i plików podpisujemy prawną umowę o zachowaniu poufności.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-indigo-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-brain text-indigo-400"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Architektura Nowoczesnego AI</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Nie tworzymy tymczasowych rozwiązań. Budujemy stabilne integracje z oficjalnymi interfejsami API, gwarantując ciągłość działania systemów.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-headset text-green-500"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Wsparcie Techniczne i Gwarancja</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Po oddaniu projektu nie zostajesz sam. Każde wdrożenie objęte jest opieką po-wdrożeniową oraz pełną gwarancją techniczną na poprawne działanie.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-50 text-slate-900">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-black mb-12 uppercase tracking-tight border-l-4 border-green-500 pl-6">Najczęściej zadawane pytania (FAQ)</h2>
        <div class="space-y-4">
          {[
            { q: "Czy przed wysłaniem plików do wyceny możemy podpisać umowę o poufności (NDA)?", a: "Tak, oczywiście. Rozumiemy, że pliki zawierają strategiczne dane firmy. Na życzenie klienta wysyłamy nasz standardowy wzór umowy NDA lub podpisujemy dokument dostarczony przez Twój dział prawny jeszcze przed przekazaniem nam jakichkolwiek arkuszy do wglądu." },
            { q: "Ile kosztuje stworzenie arkusza w Excelu na zamówienie?", a: "Proste i powtarzalne kalkulatory automatyzujące pojedyncze zadania zaczynają się od 490 zł netto. Bardziej złożone systemy zintegrowane z AI, systemy CRM, panele managerskie Power BI czy automatyzacja całych procesów to koszt od 1200–1500 zł netto w górę. Każdy projekt wyceniamy indywidualnie podczas darmowego audytu." },
            { q: "Jak wygląda kwestia kosztów przy integracji Excela ze sztuczną inteligencją (AI)?", a: "Arkusz łączymy bezpośrednio z Twoim indywidualnym kluczem API OpenAI (twórców ChatGPT) przy pomocy stabilnego kodu VBA. Koszt utrzymania zależy bezpośrednio od wolumenu przetwarzanych danych przez Twoją firmę – przy standardowym, codziennym użytkowaniu biurowym są to zazwyczaj koszty rzędu kilku dolarów miesięcznie." },
            { q: "Ile trwa realizacja i wdrożenie dedykowanego rozwiązania?", a: "Szybkie poprawki optymalizacyjne w istniejących plikach realizujemy zazwyczaj w 2-4 dni robocze. Budowa kompletnego, dedykowanego systemu automatyzacji od zera trwa średnio od 7 do 14 dni roboczych, w zależności od poziomu skomplikowania procedur." },
            { q: "Czy stworzone makra i systemy będą poprawnie działać na systemach MacOS?", a: "Makra VBA posiadają pewne ograniczenia natywne w środowisku Apple w porównaniu do systemu Windows. Jeśli w Twojej firmie pracownicy korzystają z komputerów Mac, poinformuj nas o tym na samym początku – dopasujemy architekturę technologiczną kodu i narzędzi tak, aby były w pełni kompatybilne z Waszym sprzętem." }
          ].map(item => (
            <div class="p-6 rounded-2xl bg-white shadow-sm border border-slate-200 hover:border-green-500/50 transition-all">
              <h4 class="font-bold text-slate-900 mb-2">{item.q}</h4>
              <p class="text-slate-600 text-sm leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
    <Footer />
  </div>
</BaseLayout>