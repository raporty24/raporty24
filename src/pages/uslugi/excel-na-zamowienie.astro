---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

// SEO Setup
const title = "Excel na zamówienie – Tworzenie profesjonalnych arkuszy dla firm";
const description = "Zleć stworzenie dedykowanego arkusza Excel. Budujemy kalkulatory, generatory ofert i automaty VBA dopasowane do Twojego biznesu. Wyceń swój plik w 24h!";

export const service = {
  title: "Excel na zamówienie",
  order: 10,
  menu: true,
  category: "Excel", // opcjonalnie (do grupowania)
};
---

<BaseLayout title={title} description={description}>
  <div x-data="app" x-cloak>
    <Header />
    
    <HeroService
      title="Dedykowany" 
      highlight="Excel na zamówienie" 
      subtitle="Budujemy narzędzia, które pracują za Ciebie. Od prostych kalkulatorów po zaawansowane systemy automatyzacji procesów biznesowych."
    />

    <section class="py-24 bg-white text-slate-900">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl font-black uppercase tracking-tighter mb-8 leading-none">
              Twój Excel wolno działa lub <br/> <span class="text-green-600">wymaga ręcznej pracy?</span>
            </h2>
            <p class="text-lg text-slate-600 mb-6 leading-relaxed">
              Większość firm traci do 20 godzin tygodniowo na ręczne przepisywanie danych i naprawianie błędnych formuł. Nasze <strong>arkusze na zamówienie</strong> eliminują te problemy, wprowadzając automatyzację tam, gdzie do tej pory był chaos. Zajmujemy się profesjonalnym <strong>tworzeniem raportów w excelu</strong>, które oszczędzają Twój czas.
            </p>
            <p class="text-md text-slate-600 mb-8 leading-relaxed bg-slate-50 p-4 border-l-4 border-green-500 rounded-r-lg">
              <i class="fas fa-lightbulb text-green-500 mr-2"></i> <strong>Twój Excel to już za mało?</strong> Jeśli masz ogromne ilości danych, sprawdź nasze interaktywne <a href="/uslugi/dashboardy-power-bi/" class="text-green-600 font-bold underline hover:text-green-800 transition-colors">dashboardy Power BI</a>, aby wejść na wyższy poziom analityki.
            </p>

            <ul class="space-y-4 mb-10">
              <li class="flex items-center gap-3 font-bold"><i class="fas fa-check-circle text-green-500"></i> Zero błędów w obliczeniach i formułach</li>
              <li class="flex items-center gap-3 font-bold"><i class="fas fa-check-circle text-green-500"></i> Błyskawiczne generowanie dokumentów i zestawień</li>
              <li class="flex items-center gap-3 font-bold"><i class="fas fa-check-circle text-green-500"></i> Interfejs zrozumiały dla każdego pracownika</li>
            </ul>

            <div>
              <a href="#kontakt" class="inline-block bg-green-600 text-white font-bold py-4 px-8 rounded-full hover:bg-green-700 transition-colors shadow-lg shadow-green-500/30 text-lg">
                Opisz swój problem – Darmowa wycena
              </a>
              <span class="block text-sm text-slate-500 mt-3 font-medium">
                <i class="fas fa-clock mr-1"></i> Odpowiadamy w 24 godziny
              </span>
            </div>
          </div>
       <div class="bg-slate-50 p-10 rounded-[40px] border-2 border-slate-200 hover:border-green-400 transition-colors">
            <h3 class="text-2xl font-black mb-4 uppercase text-slate-900">Jakie narzędzia w Excelu tworzymy?</h3>
            <p class="text-sm text-slate-600 mb-6 font-medium">Projektujemy dedykowane arkusze, które rozwiązują konkretne problemy firm. Najczęściej wdrażane rozwiązania to:</p>
            
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Kalkulator w Excelu</h4>
                <span class="text-xs text-slate-500 leading-relaxed block mt-1 mb-2">Zautomatyzowane pliki m.in. <strong>kalkulator kredytowy w excelu</strong> czy kalkulator zyskowności. Twórz bezbłędne <strong>kosztorysy</strong> w kilka sekund bez obaw o błędy w formułach.</span>
                <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded font-bold">Wycena od: 490 zł netto</span>
              </div>
              
              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Generatory Ofert i Faktur</h4>
                <span class="text-xs text-slate-500 leading-relaxed block mt-1 mb-2">Narzędzia generujące gotowe <strong>umowy, oferty handlowe i faktury do PDF</strong> jednym kliknięciem (makra VBA). Wprowadź dane i gotowe!</span>
                <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded font-bold">Wycena od: 500 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Prosty CRM w Excelu</h4>
                <span class="text-xs text-slate-500 leading-relaxed block mt-1 mb-2">Dedykowana <strong>baza klientów</strong> z lejkami sprzedaży, historią kontaktów i przypomnieniami. Idealne do zarządzania sprzedażą w małej i średniej firmie.</span>
                <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded font-bold">Wycena od: 1500 zł netto</span>
              </div>
              
              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Program Magazynowy</h4>
                <span class="text-xs text-slate-500 leading-relaxed block mt-1 mb-2">Arkusz do śledzenia stanów magazynowych, inwentaryzacji i ewidencji towaru. Pełna kontrola nad <strong>magazynem w Excelu</strong>.</span>
                <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded font-bold">Wycena od: 1300 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Automatyzacja Emaili</h4>
                <span class="text-xs text-slate-500 leading-relaxed block mt-1 mb-2">Integracja Excela z Outlookiem. Masowa <strong>wysyłka maili z załącznikami</strong> prosto z arkusza kalkulacyjnego z dedykowanymi wiadomościami.</span>
                <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded font-bold">Wycena od: 450 zł netto</span>
              </div>

              <div class="bg-white p-4 rounded-xl shadow-sm border-l-4 border-green-500 hover:shadow-md transition-shadow">
                <h4 class="font-bold block text-slate-800">Pobieranie i Czyszczenie Danych</h4>
                <span class="text-xs text-slate-500 leading-relaxed block mt-1 mb-2">Używamy Power Query do <strong>automatycznego pobierania danych</strong> z systemów ERP, plików CSV i stron www. Następnie dane są czyszczone.</span>
                <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded font-bold">Wycena od: 700 zł netto</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-950 text-white">
      <div class="container mx-auto px-4">
        <h2 class="text-4xl font-black uppercase tracking-tighter mb-16 text-center">Standard profesjonalnego arkusza</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-code text-green-500"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Automatyzacja VBA</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Piszemy dedykowane makra, które wykonują powtarzalne czynności za kliknięciem jednego przycisku. <strong>Automatyzacja w excelu</strong> to nasza specjalność.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-filter text-green-500"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Power Query</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Łączymy dane z wielu źródeł (CSV, PDF, SQL) w jeden czysty i zawsze aktualny raport. Zapomnij o ręcznym przeklejaniu danych z różnych plików.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
            <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-6">
              <i class="fas fa-shield-alt text-green-500"></i>
            </div>
            <h4 class="text-xl font-bold mb-4">Bezpieczeństwo</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Blokujemy edycję formuł, wprowadzamy walidację danych i chronimy Twoje know-how. Twój dedykowany plik excel jest zawsze bezpieczny.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-50 text-slate-900">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-4xl font-black uppercase tracking-tighter mb-16 text-center">3 kroki do Twojego arkusza</h2>
        <div class="grid md:grid-cols-3 gap-12">
          <div class="text-center">
            <span class="text-6xl font-black text-green-200 block mb-4">01</span>
            <h5 class="font-bold text-xl mb-2">Bezpłatny Audyt</h5>
            <p class="text-slate-500 text-sm">Analizujemy Twoje potrzeby i obecne pliki. Proponujemy najlepsze rozwiązanie i od razu podajemy widełki cenowe, abyś wiedział na czym stoisz.</p>
          </div>
          <div class="text-center">
            <span class="text-6xl font-black text-green-200 block mb-4">02</span>
            <h5 class="font-bold text-xl mb-2">Budowa Narzędzia</h5>
            <p class="text-slate-500 text-sm">Rozpoczynamy <strong>tworzenie raportów w excelu</strong> na bazie wytycznych. Testujemy go na Twoich danych i wprowadzamy poprawki.</p>
          </div>
          <div class="text-center">
            <span class="text-6xl font-black text-green-200 block mb-4">03</span>
            <h5 class="font-bold text-xl mb-2">Wdrożenie i Support</h5>
            <p class="text-slate-500 text-sm">Przekazujemy gotowy plik z przejrzystą instrukcją i zapewniamy fachowe wsparcie techniczne.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-950 text-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-black mb-12 uppercase tracking-tight border-l-4 border-green-500 pl-6">Najczęściej zadawane pytania</h2>
        <div class="space-y-4">
         {[
            { q: "Ile kosztuje stworzenie arkusza w Excelu na zamówienie?", a: "Cena zależy od skomplikowania projektu. Proste kalkulatory w excelu zaczynają się od 490 zł netto. Średnie projekty (np. zautomatyzowany kosztorys w excelu czy program magazynowy) to inwestycja zazwyczaj w przedziale 1500 - 3500 zł netto. Zaawansowane systemy wyceniamy indywidualnie po darmowym audycie. Potrzebujesz tylko drobnej pomocy, naprawy formuły lub konsultacji? Oferujemy również szybkie wsparcie w modelu godzinowym (od 150 zł netto / roboczogodzina)." },
            { q: "Czy plik będzie działał na starszych wersjach Excela?", a: "Standardowo projektujemy pod Microsoft 365, ale na życzenie dostosowujemy pliki do wersji 2016, 2019 lub 2021. Ważne, aby na początku ustalić z jakiej wersji korzystasz." },
            { q: "Ile trwa tworzenie arkusza na zlecenie?", a: "Mniejsze projekty jak kosztorys w excelu realizujemy w 3-5 dni roboczych. Złożone systemy wymagają zazwyczaj od 2 do 4 tygodni." },
            { q: "Czy oferujecie wsparcie po zakończeniu zlecenia?", a: "Tak, na każdy arkusz udzielamy gwarancji technicznej i oferujemy płatną opiekę powdrożeniową (SLA). Jesteśmy partnerem technologicznym dla Twojego biznesu." }
          ].map(item => (
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-green-500/30 transition-all">
              <h4 class="font-bold text-green-400 mb-2">{item.q}</h4>
              <p class="text-slate-400 text-sm leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
    <Footer />
  </div>
</BaseLayout>