---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

// SEO Setup - celujemy w automatyzację i oszczędność czasu
const title = "Pobieranie danych z e-maili do Excela i Google Sheets | Raporty24";
const description = "Automatyzacja załączników i treści wiadomości. Oferujemy automatyczne pobieranie danych z e-mail (CSV, XLSX) do Excela. Koniec z ręcznym przepisywaniem danych!";

// 1. DODAJ TE DWIE LINIE:
const ogImage = "/biuro3.webp"; // Możesz tu dać dedykowaną grafikę bazy klientów, jeśli ją masz
const currentUrl = "https://raporty24.pl/uslugi/pobieranie-email-do-excela/"; // upewnij się, że taki jest slug tej strony

export const service = {
  title: "Automatyczne pobieranie email",
  order: 10,
  menu: true,
  category: "Excel",
};
---

<BaseLayout title={title} description={description} image={ogImage} url={currentUrl}>
  <div x-data="app" x-cloak>
    <Header />
    
    <HeroService 
      title="Automatyczne" 
      highlight="Pobieranie danych z E-maili" 
      subtitle="Zamień chaos w skrzynce odbiorczej w uporządkowany raport. Jako firma analityczna budujemy systemy, które same skanują maile, wyciągają załączniki i agregują dane w chmurze."
    />

    <section class="py-24 bg-slate-950 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl lg:text-5xl font-black uppercase tracking-tighter mb-6">Co możemy <span class="text-green-500">zautomatyzować?</span></h2>
          <p class="text-xl text-slate-400">Ręczne zapisywanie załączników to marnowanie potencjału Twoich pracowników. Jeśli chcesz <strong>zlecić excel</strong> profesjonalistom, stworzymy dla Ciebie <strong>program do zarządzania firmą</strong>, który sam „czyta” pocztę.</p>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="p-10 rounded-[3rem] bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <div class="w-14 h-14 bg-green-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-green-500 group-hover:text-white transition-all">
                <i class="fas fa-file-import text-2xl"></i>
            </div>
            <h4 class="text-2xl font-bold mb-4 text-white italic">Import załączników CSV/XLSX</h4>
            <p class="text-slate-400 leading-relaxed">System automatycznie wykrywa nowe wiadomości od dostawców, pobiera cenniki lub raporty i przez <strong>Power Query</strong> dołącza je do bazy głównej w Excelu lub <strong>Google Sheets</strong>.</p>
          </div>

          <div class="p-10 rounded-[3rem] bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <div class="w-14 h-14 bg-green-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-green-500 group-hover:text-white transition-all">
                <i class="fas fa-envelope-open-text text-2xl"></i>
            </div>
            <h4 class="text-2xl font-bold mb-4 text-white italic">Parsowanie treści wiadomości</h4>
            <p class="text-slate-400 leading-relaxed">Otrzymujesz setki powtarzalnych maili z formularzy? Wyciągniemy z nich kluczowe informacje (imię, produkt, kwota) i zamienimy je w czyste dane gotowe do <strong>analityki biznesowej</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white text-slate-900">
      <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
          <div class="lg:w-1/2">
            <h2 class="text-4xl font-black uppercase tracking-tighter mb-8 leading-none">Poczta zintegrowana <br/><span class="text-green-600 text-3xl">z Twoim arkuszem</span></h2>
            <p class="text-slate-600 mb-8 leading-relaxed">Jako <strong>firma analityczna</strong> wdrażamy rozwiązania oparte o <strong>Power Automate</strong> oraz skrypty <strong>Google Apps Script</strong>. Dzięki temu Twoje dane są zawsze aktualne, bez otwierania skrzynki pocztowej.</p>
            
            <div class="space-y-4">
                <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100 italic">
                    <i class="fas fa-check-circle text-green-600 mt-1"></i>
                    <p class="text-sm text-slate-600"><strong>Usługi dla firm excel</strong>: pełna automatyzacja raportów dziennych.</p>
                </div>
                <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100 italic">
                    <i class="fas fa-check-circle text-green-600 mt-1"></i>
                    <p class="text-sm text-slate-600">Bezpieczna praca w chmurze (SharePoint / OneDrive).</p>
                </div>
            </div>
          </div>
          
          <div class="lg:w-1/2 bg-slate-950 p-12 rounded-[50px] shadow-2xl relative">
            <div class="absolute -top-6 -left-6 bg-green-500 text-white px-6 py-3 rounded-2xl font-black uppercase text-xs tracking-widest shadow-xl">
              Efficiency Boost
            </div>
            <h3 class="text-2xl font-bold text-white mb-6">Zaoszczędzony czas</h3>
            <p class="text-slate-400 mb-8 text-sm leading-relaxed">Nasi klienci odzyskują średnio 5-10 godzin tygodniowo, które wcześniej poświęcali na ręczne „przeklejanie” danych z maili.</p>
            <div class="space-y-4">
               <div class="flex justify-between text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-1"><span>Automatyzacja procesów</span><span>100%</span></div>
               <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden"><div class="w-full h-full bg-green-500 shadow-[0_0_10px_#22c55e]"></div></div>
               <div class="flex justify-between text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-1"><span>Ryzyko błędu ludzkiego</span><span>0%</span></div>
               <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden"><div class="w-[2%] h-full bg-green-500"></div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-950 text-white border-t border-white/5">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl lg:text-4xl font-black mb-12 uppercase tracking-tight text-center italic">FAQ – Automatyzacja E-mail</h2>
        <div class="grid gap-4">
          {[
            { q: "Czy system obsługuje Outlooka i Gmaila?", a: "Tak, integrujemy się z najpopularniejszymi klientami poczty. W przypadku Microsoft 365 używamy natywnych rozwiązań chmurowych, a dla Google Sheets wykorzystujemy Apps Script." },
            { q: "Czy moje dane są bezpieczne?", a: "Absolutnie. Procesy automatyzacji działają wewnątrz Twojego środowiska firmowego. Jako firma analityczna dbamy o standardy bezpieczeństwa i RODO." },
            { q: "Czy muszę mieć włączony komputer, żeby to działało?", a: "Nie. Rozwiązania oparte na chmurze (Power Automate / Google) działają 24/7 na serwerach, nawet gdy Twój komputer jest wyłączony." },
            { q: "Co jeśli załącznik zmieni strukturę?", a: "Budujemy inteligentne mechanizmy w Power Query, które potrafią rozpoznać zmiany lub powiadomić Cię o konieczności weryfikacji danych." }
          ].map(item => (
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all group">
              <h4 class="font-bold text-green-400 mb-2 group-hover:translate-x-1 transition-transform">{item.q}</h4>
              <p class="text-slate-400 text-sm leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
    <Footer />
  </div>
</BaseLayout>