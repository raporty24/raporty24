---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

// SEO Setup - Precyzyjne uderzenie w logistykę i magazyn
const title = "Zarządzanie flotą i magazynem w Excelu | Logistyka | Raporty24";
const description = "Odzyskaj kontrolę nad transportem. Oferujemy profesjonalne zarządzanie flotą samochodową w excelu, program magazynowy oraz harmonogram produkcji. Sprawdź!";
// 1. DODAJ TE DWIE LINIE:
const ogImage = "/biuro3.webp"; // Możesz tu dać dedykowaną grafikę bazy klientów, jeśli ją masz
const currentUrl = "https://raporty24.pl/uslugi/logistyka-w-excelu/"; // upewnij się, że taki jest slug tej strony
export const service = {
  title: "Logistyka i Magazyn",
  order: 15,
  menu: true,
  category: "Excel",
};
---

<BaseLayout title={title} description={description} image={ogImage} url={currentUrl}>
  <div x-data="app" x-cloak>
    <Header />
    
    <HeroService 
      title="Dedykowany program" 
      highlight="Logistyka w Excelu" 
      subtitle="Koniec z chaosem w arkuszach i drogimi abonamentami. Jako firma analityczna budujemy zaawansowane narzędzia do zarządzania flotą, magazynem i produkcją."
    />

    <section class="py-24 bg-slate-950 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl lg:text-5xl font-black uppercase tracking-tighter mb-6">Transport i Magazyn <span class="text-green-500">bez limitów</span></h2>
          <p class="text-xl text-slate-400">Standardowe systemy TMS/WMS są sztywne i drogie. Nasze <strong>usługi dla firm excel</strong> to pełna elastyczność. Jeśli chcesz <strong>zlecić excel</strong> ekspertom, którzy rozumieją łańcuch dostaw – jesteśmy do Twojej dyspozycji.</p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <i class="fas fa-truck-moving text-3xl text-green-500 mb-6 group-hover:scale-110 transition-transform"></i>
            <h4 class="text-xl font-bold mb-4 uppercase tracking-tight">Zarządzanie Flotą</h4>
            <p class="text-slate-400 text-sm">Kompleksowe <strong>zarządzanie flotą samochodową w excelu</strong>. Automatyczne rozliczanie paliwa, kontrola kosztów eksploatacji i przypomnienia o serwisach w jednym systemie.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <i class="fas fa-warehouse text-3xl text-green-500 mb-6 group-hover:scale-110 transition-transform"></i>
            <h4 class="text-xl font-bold mb-4 uppercase tracking-tight">Program Magazynowy</h4>
            <p class="text-slate-400 text-sm">Intuicyjny <strong>program magazynowy excel</strong>. Śledzenie rotacji towaru, automatyczne generowanie dokumentów PZ/WZ i pełna kontrola nad stanami minimalnymi.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <i class="fas fa-stream text-3xl text-green-500 mb-6 group-hover:scale-110 transition-transform"></i>
            <h4 class="text-xl font-bold mb-4 uppercase tracking-tight">Planowanie Produkcji</h4>
            <p class="text-slate-400 text-sm">Dynamiczny <strong>harmonogram produkcji excel</strong>. Zarządzanie obłożeniem linii, kontrola wydajności pracowników (OEE) i eliminacja wąskich gardeł.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white text-slate-900">
      <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
          <div class="lg:w-1/2">
            <h2 class="text-4xl font-black uppercase tracking-tighter mb-8 leading-none italic">Analityka, która <br/><span class="text-green-600">optymalizuje koszty</span></h2>
            <ul class="space-y-6">
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
                    <i class="fas fa-barcode text-green-600"></i>
                </div>
                <div>
                  <h4 class="font-bold text-lg italic">Inwentaryzacja Excel</h4>
                  <p class="text-slate-500 text-sm leading-relaxed">Szybka i bezbłędna <strong>inwentaryzacja excel</strong>. Porównuj stany fizyczne z systemowymi, wyłapuj braki i generuj raporty różnic jednym kliknięciem.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
                    <i class="fas fa-route text-green-600"></i>
                </div>
                <div>
                  <h4 class="font-bold text-lg italic">Optymalizacja Tras i Paliwa</h4>
                  <p class="text-slate-500 text-sm leading-relaxed">Automatyzujemy pobieranie danych z kart paliwowych (CSV/XLS). Nasza <strong>analityka biznesowa</strong> wskaże Ci, gdzie uciekają pieniądze w Twoim transporcie.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center">
                    <i class="fas fa-microchip text-green-600"></i>
                </div>
                <div>
                  <h4 class="font-bold text-lg italic">Integracja Power Query</h4>
                  <p class="text-slate-500 text-sm leading-relaxed">Łączymy dane z Twojego ERP, GPS i plików dostawców. Tworzymy jedno, spójne źródło prawdy dla całej logistyki.</p>
                </div>
              </li>
            </ul>
          </div>
          <div class="lg:w-1/2 bg-slate-950 p-12 rounded-[50px] shadow-2xl relative overflow-hidden group">
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-green-500/10 rounded-full blur-3xl group-hover:bg-green-500/20 transition-all"></div>
            <div class="absolute -top-6 -left-6 bg-green-600 text-white px-6 py-3 rounded-2xl font-black uppercase text-xs tracking-widest shadow-xl">
              Control Tower
            </div>
            <h3 class="text-2xl font-bold text-white mb-6">Logistyczny Panel Dowodzenia</h3>
            <p class="text-slate-400 mb-8 text-sm leading-relaxed">Jako <strong>firma analityczna</strong> projektujemy kokpity, które pokazują kluczowe KPI: rentowność aut, wykorzystanie powierzchni oraz wydajność zmianową.</p>
            <div class="space-y-6">
               <div>
                  <div class="flex justify-between text-[10px] text-slate-500 font-bold uppercase tracking-[0.2em] mb-2"><span>Efektywność Floty</span><span>91%</span></div>
                  <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden"><div class="w-[91%] h-full bg-green-500 shadow-[0_0_15px_#22c55e]"></div></div>
               </div>
               <div>
                  <div class="flex justify-between text-[10px] text-slate-500 font-bold uppercase tracking-[0.2em] mb-2"><span>Optymalizacja Magazynu</span><span>78%</span></div>
                  <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden"><div class="w-[78%] h-full bg-green-400 shadow-[0_0_15px_#4ade80]"></div></div>
               </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-950 text-white border-t border-white/5">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="text-3xl lg:text-4xl font-black mb-12 uppercase tracking-tight italic">Eksperckie FAQ</h2>
        <div class="grid gap-6 text-left">
          {[
            { q: "Czy Excel poradzi sobie z dużą bazą towarową?", a: "Zdecydowanie tak. Dzięki zastosowaniu Power Query i modelu danych, Twój program magazynowy excel zachowuje pełną wydajność nawet przy tysiącach indeksów." },
            { q: "Czy mogę zintegrować arkusz z moim GPS?", a: "Tak, oferujemy automatyczne pobieranie danych z systemów telematycznych. Twoje zarządzanie flotą samochodową w excelu będzie zasilane danymi w czasie rzeczywistym." },
            { q: "Jakie są korzyści z harmonogramu produkcji w Excelu?", a: "Główną zaletą jest elastyczność. W przeciwieństwie do sztywnych systemów MES, nasz harmonogram produkcji dopasujemy do Twoich specyficznych maszyn i procesów." },
            { q: "Czy wdrożenie odbywa się zdalnie?", a: "Tak, realizujemy projekty zdalnie w całej Polsce. Oferujemy wsparcie online, szkolenia dla magazynierów oraz pełną opiekę po-wdrożeniową." }
          ].map(item => (
            <div class="p-8 rounded-[2rem] bg-white/5 border border-white/10 hover:border-green-500/30 transition-all">
              <h4 class="font-bold text-green-400 mb-3 text-lg">{item.q}</h4>
              <p class="text-slate-400 text-sm leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
    <Footer />
  </div>
</BaseLayout>