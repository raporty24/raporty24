---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

// SEO Setup - Kompletna strategia słów kluczowych
const title = "CRM w Excelu i Google Sheets – Program do zarządzania firmą | Raporty24";
const description = "Szukasz alternatywy dla drogich systemów? Budujemy dedykowany CRM w Excelu i Google Sheets. Profesjonalny program do zarządzania firmą i sprzedażą w chmurze.";

export const service = {
  title: "CRM w Excelu i Google Sheets",
  order: 10,
  menu: true,
  category: "Excel",
};
---

<BaseLayout title={title} description={description}>
  <div x-data="app" x-cloak>
    <Header />
    
    <HeroService 
      title="System CRM i program" 
      highlight="do zarządzania firmą" 
      subtitle="Zapanuj nad chaosem w danych. Jako doświadczona firma analityczna tworzymy profesjonalne systemy CRM w Excelu oraz Google Sheets, dopasowane do Twojego procesu sprzedaży."
    />

    <section class="py-24 bg-slate-950 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl lg:text-5xl font-black uppercase tracking-tighter mb-6">CRM w <span class="text-green-500">Excelu lub Google Sheets?</span></h2>
          <p class="text-xl text-slate-400">Dla wielu przedsiębiorców standardowe systemy SaaS są zbyt sztywne i kosztowne. Nasz <strong>program do zarządzania firmą</strong> to brak abonamentu i pełna kontrola. Jeśli planujesz <strong>zlecić excel</strong> ekspertom – oferujemy kompleksowe <strong>usługi dla firm</strong> w zakresie automatyzacji i baz danych.</p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <i class="fas fa-cloud text-3xl text-green-500 mb-6 group-hover:scale-110 transition-transform"></i>
            <h3 class="text-xl font-bold mb-4 italic text-white uppercase tracking-tight">Praca w chmurze</h3>
            <p class="text-slate-400 text-sm">Natywna praca online w <strong>Google Sheets</strong> lub zaawansowane <strong>zarządzanie flotą</strong> i sprzedażą w <strong>Excel SharePoint</strong>. Wieloosobowa edycja to u nas standard.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <i class="fas fa-chart-line text-3xl text-green-500 mb-6 group-hover:scale-110 transition-transform"></i>
            <h3 class="text-xl font-bold mb-4 italic text-white uppercase tracking-tight">Analityka Biznesowa</h3>
            <p class="text-slate-400 text-sm">To nie jest zwykły arkusz. To profesjonalna <strong>analityka biznesowa</strong> skrojona pod Twój lejek sprzedaży, z automatycznym raportowaniem KPI.</p>
          </div>
          <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-green-500/50 transition-all group">
            <i class="fas fa-laptop-house text-3xl text-green-500 mb-6 group-hover:scale-110 transition-transform"></i>
            <h3 class="text-xl font-bold mb-4 italic text-white uppercase tracking-tight">Zdalna współpraca</h3>
            <p class="text-slate-400 text-sm">Działamy <strong>zdalnie w całej Polsce</strong>. Twój nowy system CRM wdrażamy online, zapewniając pełne wsparcie i szkolenie dla Twojego zespołu.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white text-slate-900">
      <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
          <div class="lg:w-1/2">
            <h2 class="text-4xl font-black uppercase tracking-tighter mb-8 leading-none">Co zawiera Twój <br/><span class="text-green-600">nowy system CRM?</span></h2>
            <ul class="space-y-6">
              <li class="flex gap-4">
                <i class="fas fa-check-circle text-green-600 text-2xl"></i>
                <div>
                  <h4 class="font-bold text-lg">Centralna baza klientów i kontaktów</h4>
                  <p class="text-slate-500 text-sm">Pełna historia relacji w arkuszach Google lub Excelu. Wszystkie dane firmowe uporządkowane i bezpieczne.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <i class="fas fa-check-circle text-green-600 text-2xl"></i>
                <div>
                  <h4 class="font-bold text-lg">Lejek Sprzedaży i Pipeline</h4>
                  <p class="text-slate-500 text-sm">Zarządzaj szansami sprzedaży na każdym etapie. Widzisz konwersję i potencjalne zyski w czasie rzeczywistym.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <i class="fas fa-check-circle text-green-600 text-2xl"></i>
                <div>
                  <h4 class="font-bold text-lg">Automatyzacja Follow-up</h4>
                  <p class="text-slate-500 text-sm">Inteligentne przypomnienia o kontakcie, które pilnują, aby żadne zapytanie ofertowe nie zostało pominięte.</p>
                </div>
              </li>
            </ul>
          </div>
          <div class="lg:w-1/2 bg-slate-950 p-12 rounded-[50px] shadow-2xl relative">
            <div class="absolute -top-6 -left-6 bg-green-500 text-white px-6 py-3 rounded-2xl font-black uppercase text-xs tracking-widest shadow-xl">
              Data Intelligence
            </div>
            <h3 class="text-2xl font-bold text-white mb-6 italic">Dashboard Zarządczy</h3>
            <p class="text-slate-400 mb-8 text-sm leading-relaxed">Jako Twoja <strong>firma analityczna</strong>, projektujemy interaktywne dashboardy, które wizualizują Twoją sprzedaż bez ręcznego przepisywania danych.</p>
            <div class="space-y-4">
               <div class="flex justify-between text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-1"><span>Target kwartalny</span><span>82%</span></div>
               <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden"><div class="w-[82%] h-full bg-green-500 shadow-[0_0_10px_#22c55e]"></div></div>
               <div class="flex justify-between text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-1"><span>Realizacja leadów</span><span>60%</span></div>
               <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden"><div class="w-3/5 h-full bg-green-500"></div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-950 text-white border-t border-white/5">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl lg:text-4xl font-black mb-12 uppercase tracking-tight text-center italic">Częste pytania (FAQ)</h2>
        <div class="grid gap-4">
          {[
            { q: "Czy lepiej wybrać Excel czy Google Sheets?", a: "To zależy od specyfiki pracy. Google Sheets świetnie sprawdza się w małych, zdalnych zespołach. Excel oferuje większą wydajność przy ogromnych bazach danych i integracji z Power BI." },
            { q: "Czy wielu handlowców może pracować jednocześnie?", a: "Tak. Wykorzystując chmurę (SharePoint lub natywny dysk Google), cały zespół ma dostęp do najnowszej wersji pliku w tym samym czasie." },
            { q: "Czy moje dane są bezpieczne?", a: "Tak. Stosujemy zaawansowane walidacje i uprawnienia. Twoja baza klientów pozostaje na Twojej infrastrukturze, zgodnie z wytycznymi RODO." },
            { q: "Czy mogę zlecić excel do dalszej rozbudowy?", a: "Oczywiście. System rośnie wraz z Twoją firmą. Zapewniamy pełne wsparcie po-wdrożeniowe i rozbudowę o nowe moduły raportowe." }
          ].map(item => (
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all group">
              <h4 class="font-bold text-green-400 mb-2 group-hover:translate-x-1 transition-transform">{item.q}</h4>
              <p class="text-slate-400 text-sm leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
    <Footer />
  </div>
</BaseLayout>