---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import HeroService from "../../components/HeroService.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

const title =
  "Dashboardy Power BI dla firm | KPI i raporty zarządcze | Raporty24";

const description =
  "Tworzymy dashboardy Power BI dla firm: KPI, sprzedaż, finanse, controlling i operacje. Czytelne raporty zarządcze z danych Excel, SQL, SharePoint i systemów firmowych.";

const ogImage = "/biuro3.webp";

const currentUrl =
  "https://raporty24.pl/uslugi/dashboardy-power-bi/";

export const service = {
  title: "Dashboardy Power BI",
  order: 30,
  menu: true,
  category: "Raportowanie i BI",
  description:
    "Interaktywne dashboardy Power BI, KPI i raporty zarządcze dla sprzedaży, finansów, controllingu i procesów operacyjnych.",
};


/*
 * =========================================================
 * KORZYŚCI
 * =========================================================
 */

const benefits = [
  {
    title: "Najważniejsze KPI",
    description:
      "Kluczowe wskaźniki są zebrane w jednym miejscu i dopasowane do pytań, na które ma odpowiadać raport.",
    icon: "fas fa-chart-line",
  },

  {
    title: "Filtrowanie danych",
    description:
      "Użytkownik może analizować wynik według okresu, działu, produktu, klienta, regionu lub innych wymiarów.",
    icon: "fas fa-filter",
  },

  {
    title: "Drill-down",
    description:
      "Od wyniku ogólnego można przejść do bardziej szczegółowych danych i poszukać przyczyny zmiany wskaźnika.",
    icon: "fas fa-search",
  },

  {
    title: "Wiele źródeł",
    description:
      "Dashboard może korzystać z danych przygotowanych z Excela, SharePoint, baz danych, ERP, CRM lub innych źródeł.",
    icon: "fas fa-database",
  },

  {
    title: "Spójny raport",
    description:
      "Zamiast kilku niezależnych plików można przygotować jeden zestaw widoków oparty na wspólnym modelu danych.",
    icon: "fas fa-layer-group",
  },

  {
    title: "Wygodne udostępnianie",
    description:
      "W odpowiednio skonfigurowanym środowisku raport może być dostępny dla wybranych użytkowników bez przesyłania kolejnych wersji pliku.",
    icon: "fas fa-users",
  },
];


/*
 * =========================================================
 * OBSZARY
 * =========================================================
 */

const areas = [
  {
    title: "Sprzedaż",
    items: [
      "realizacja planu sprzedaży",
      "sprzedaż według produktu i klienta",
      "marża i rentowność",
      "sprzedaż według regionu lub handlowca",
      "dynamika okres do okresu",
      "najważniejsi klienci i produkty",
    ],
  },

  {
    title: "Finanse i controlling",
    items: [
      "przychody i koszty",
      "budżet vs wykonanie",
      "marża i rentowność",
      "należności i zobowiązania",
      "analiza kosztów",
      "wyniki według działów lub MPK",
    ],
  },

  {
    title: "Zarząd",
    items: [
      "kluczowe KPI firmy",
      "porównanie okresów",
      "odchylenia od planu",
      "wyniki poszczególnych obszarów",
      "trend najważniejszych wskaźników",
      "szybkie przejście do szczegółów",
    ],
  },

  {
    title: "Magazyn i logistyka",
    items: [
      "stany magazynowe",
      "rotacja produktów",
      "towary wolno rotujące",
      "realizacja zamówień",
      "terminowość dostaw",
      "analiza zapasów",
    ],
  },

  {
    title: "Serwis i operacje",
    items: [
      "liczba zleceń",
      "status realizacji",
      "czas obsługi",
      "obciążenie zespołu",
      "powtarzalność problemów",
      "koszty realizacji",
    ],
  },

  {
    title: "Marketing i e-commerce",
    items: [
      "sprzedaż według kanału",
      "wyniki kampanii",
      "produkty i kategorie",
      "zamówienia i klienci",
      "porównanie kanałów",
      "dane sprzedażowe i marketingowe",
    ],
  },
];


/*
 * =========================================================
 * ŹRÓDŁA
 * =========================================================
 */

const sources = [
  "Excel",
  "CSV",
  "SharePoint",
  "OneDrive",
  "SQL",
  "ERP",
  "CRM",
  "API",
];


/*
 * =========================================================
 * PROCES
 * =========================================================
 */

const process = [
  {
    step: "01",
    title: "Ustalamy odbiorcę",
    description:
      "Innego dashboardu potrzebuje zarząd, innego handlowiec, a jeszcze innego controlling. Najpierw ustalamy użytkownika i jego decyzje.",
  },

  {
    step: "02",
    title: "Wybieramy KPI",
    description:
      "Określamy wskaźniki, które rzeczywiście pomagają ocenić sytuację, zamiast umieszczać na ekranie wszystko, co znajduje się w danych.",
  },

  {
    step: "03",
    title: "Przygotowujemy dane",
    description:
      "Porządkujemy źródła, budujemy model oraz logikę potrzebną do prawidłowego liczenia KPI.",
  },

  {
    step: "04",
    title: "Projektujemy widoki",
    description:
      "Budujemy hierarchię informacji, filtry, wykresy, karty KPI i nawigację dopasowaną do użytkownika.",
  },

  {
    step: "05",
    title: "Testujemy wyniki",
    description:
      "Porównujemy obliczenia ze źródłami i sprawdzamy raport na rzeczywistych przypadkach.",
  },

  {
    step: "06",
    title: "Przekazujemy dashboard",
    description:
      "Ustalamy sposób publikacji, dostępu oraz dalszego korzystania i rozwoju raportu.",
  },
];


/*
 * =========================================================
 * FAQ
 * =========================================================
 */

const faqs = [
  {
    question:
      "Czym dashboard Power BI różni się od zwykłego raportu Excel?",

    answer:
      "Dashboard Power BI jest projektowany przede wszystkim do interaktywnej analizy, filtrowania, pracy na wspólnym modelu danych i udostępniania wyników odbiorcom. Excel nadal może pozostać źródłem danych lub narzędziem operacyjnym.",
  },

  {
    question:
      "Czy dashboard Power BI może korzystać z danych z Excela?",

    answer:
      "Tak. Excel jest jednym z najczęściej wykorzystywanych źródeł. Dashboard może korzystać z jednego pliku, wielu plików lub procesu przygotowującego dane przed ich załadowaniem.",
  },

  {
    question:
      "Czy dashboard może korzystać z SharePoint?",

    answer:
      "Tak. W odpowiednio skonfigurowanym środowisku możemy wykorzystać pliki i dane przechowywane w SharePoint lub innych usługach Microsoft 365.",
  },

  {
    question:
      "Czy dashboard może łączyć dane z kilku systemów?",

    answer:
      "Tak, jeżeli dane z tych systemów są dostępne w odpowiedniej formie. Można połączyć np. sprzedaż, klientów, koszty i magazyn pochodzące z różnych źródeł.",
  },

  {
    question:
      "Czy dashboard aktualizuje się automatycznie?",

    answer:
      "Może, ale zależy to od źródeł danych, sposobu publikacji, konfiguracji środowiska i licencji. Sposób odświeżania ustalamy podczas projektowania rozwiązania.",
  },

  {
    question:
      "Czy dashboard będzie działał na telefonie?",

    answer:
      "Raporty Power BI mogą być przeglądane również na urządzeniach mobilnych. Jeżeli mobilny sposób korzystania z raportu jest istotny, uwzględniamy go już podczas projektowania widoków.",
  },

  {
    question:
      "Czy potrzebuję Power BI Pro?",

    answer:
      "Zależy to od sposobu udostępniania raportu, środowiska Microsoft oraz modelu licencyjnego używanego w firmie. Dobieramy sposób publikacji do konkretnego przypadku zamiast zakładać jeden wariant dla każdego klienta.",
  },

  {
    question:
      "Czy możecie poprawić istniejący dashboard Power BI?",

    answer:
      "Tak. Możemy przeanalizować istniejący dashboard, układ strony, model danych, miary DAX, Power Query oraz sposób prezentacji KPI i zaproponować dalszy rozwój.",
  },

  {
    question:
      "Czy dashboard musi zawierać bardzo dużo wykresów?",

    answer:
      "Nie. Dobry dashboard powinien przede wszystkim szybko odpowiadać na najważniejsze pytania użytkownika. Często mniejsza liczba dobrze dobranych KPI i wykresów jest bardziej użyteczna niż przeładowany ekran.",
  },

  {
    question:
      "Czy dashboard Power BI zastąpi wszystkie raporty Excel?",

    answer:
      "Nie zawsze ma to sens. Excel może nadal obsługiwać proces operacyjny, kalkulacje lub wprowadzanie danych, natomiast Power BI może odpowiadać za analizę i prezentację wyników.",
  },
];


/*
 * =========================================================
 * STRUCTURED DATA
 * =========================================================
 */

const serviceSchema = {
  "@context": "https://schema.org",

  "@type": "Service",

  name:
    "Dashboardy Power BI dla firm",

  provider: {
    "@type": "Organization",

    "@id":
      "https://raporty24.pl/#organization",

    name:
      "Raporty24",

    url:
      "https://raporty24.pl/",
  },

  areaServed: {
    "@type": "Country",
    name: "Polska",
  },

  serviceType:
    "Dashboardy Power BI, KPI, raporty zarządcze i wizualizacja danych",

  url:
    currentUrl,

  description,
};


const breadcrumbSchema = {
  "@context": "https://schema.org",

  "@type": "BreadcrumbList",

  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Raporty24",
      item: "https://raporty24.pl/",
    },

    {
      "@type": "ListItem",
      position: 2,
      name: "Usługi",
      item: "https://raporty24.pl/uslugi/",
    },

    {
      "@type": "ListItem",
      position: 3,
      name: "Dashboardy Power BI",
      item: currentUrl,
    },
  ],
};


const faqSchema = {
  "@context": "https://schema.org",

  "@type": "FAQPage",

  mainEntity: faqs.map((item) => ({
    "@type": "Question",

    name: item.question,

    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  url={currentUrl}
  structuredData={[
    serviceSchema,
    breadcrumbSchema,
    faqSchema
  ]}
>

  <div
    x-data="app"
    x-cloak
  >

    <Header />


    <!-- ================================================= -->
    <!-- HERO -->
    <!-- ================================================= -->

    <HeroService
      eyebrow="KPI i raporty zarządcze"
      title="Dashboardy"
      highlight="Power BI"
      subtitle="Projektujemy interaktywne dashboardy, które pokazują najważniejsze KPI i pozwalają szybko przejść od wyniku ogólnego do szczegółów. Sprzedaż, finanse, controlling, magazyn i procesy operacyjne w jednym czytelnym środowisku raportowym."
      ctaText="Opisz dashboard"
    />


    <!-- ================================================= -->
    <!-- WPROWADZENIE -->
    <!-- ================================================= -->

    <section
      class="bg-white py-24 text-slate-950"
    >

      <div class="container mx-auto px-4">

        <div
          class="grid gap-16 lg:grid-cols-2 lg:items-center"
        >

          <div>

            <span
              class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
            >
              Dashboard zarządczy
            </span>


            <h2
              class="mb-8 text-4xl font-black leading-tight tracking-tighter md:text-6xl"
            >
              Dashboard powinien odpowiadać na pytania,
              a nie tylko prezentować wykresy.
            </h2>


            <div
              class="space-y-6 text-lg leading-relaxed text-slate-600"
            >

              <p>
                Ładna wizualizacja nie wystarczy,
                jeśli użytkownik nadal musi analizować
                kilkanaście ekranów, aby znaleźć odpowiedź.
              </p>


              <p>
                Zaczynamy więc od decyzji,
                które podejmuje odbiorca raportu
                i wskaźników potrzebnych do ich podjęcia.
              </p>


              <p>
                <strong class="text-slate-950">
                  Dopiero później wybieramy wykresy,
                  filtry i sposób prezentacji danych.
                </strong>
              </p>

            </div>


            <div
              class="mt-10 flex flex-col gap-4 sm:flex-row"
            >

              <a
                href="#kontakt"
                class="inline-flex items-center justify-center gap-3 rounded-2xl bg-green-600 px-8 py-5 text-sm font-black uppercase tracking-widest text-white transition-all hover:-translate-y-1 hover:bg-green-500"
              >
                Opisz potrzebny dashboard

                <i
                  class="fas fa-arrow-right text-xs"
                  aria-hidden="true"
                ></i>
              </a>


              <a
                href="/uslugi/power-bi-dla-firm/"
                class="inline-flex items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-white px-8 py-5 text-sm font-black uppercase tracking-widest text-slate-950 transition-all hover:-translate-y-1 hover:border-green-500"
              >
                Pełne wdrożenie Power BI
              </a>

            </div>

          </div>


          <!-- PRZYKŁADOWY DASHBOARD -->
          <div
            class="rounded-[3rem] border border-slate-100 bg-slate-50 p-8 shadow-xl shadow-slate-200/60 md:p-10"
          >

            <div
              class="mb-6 flex items-center justify-between gap-4"
            >

              <div>
                <span
                  class="text-[10px] font-black uppercase tracking-wider text-slate-400"
                >
                  Dashboard sprzedaży
                </span>

                <h3
                  class="mt-1 text-xl font-black text-slate-950"
                >
                  Wyniki firmy
                </h3>
              </div>


              <div
                class="rounded-xl bg-green-100 px-3 py-2 text-xs font-black text-green-700"
              >
                KPI
              </div>

            </div>


            <div
              class="grid grid-cols-2 gap-4"
            >

              <div
                class="rounded-2xl bg-white p-5 shadow-sm"
              >
                <span class="text-xs text-slate-400">
                  Sprzedaż
                </span>

                <strong
                  class="mt-2 block text-lg text-slate-950"
                >
                  aktualny wynik
                </strong>
              </div>


              <div
                class="rounded-2xl bg-white p-5 shadow-sm"
              >
                <span class="text-xs text-slate-400">
                  Marża
                </span>

                <strong
                  class="mt-2 block text-lg text-slate-950"
                >
                  trend
                </strong>
              </div>


              <div
                class="col-span-2 rounded-2xl bg-slate-950 p-6 text-white"
              >

                <span
                  class="text-xs text-slate-400"
                >
                  Analiza
                </span>


                <div
                  class="mt-5 flex h-28 items-end gap-3"
                  aria-hidden="true"
                >

                  <div class="h-[45%] flex-1 rounded-t bg-white/20"></div>
                  <div class="h-[65%] flex-1 rounded-t bg-white/30"></div>
                  <div class="h-[52%] flex-1 rounded-t bg-white/20"></div>
                  <div class="h-[80%] flex-1 rounded-t bg-green-500"></div>
                  <div class="h-[70%] flex-1 rounded-t bg-white/30"></div>
                  <div class="h-[90%] flex-1 rounded-t bg-green-400"></div>

                </div>

              </div>


              <div
                class="col-span-2 rounded-2xl bg-white p-5 shadow-sm"
              >
                <span class="text-xs text-slate-400">
                  Filtry
                </span>

                <p class="mt-2 text-sm font-bold text-slate-700">
                  okres • region • handlowiec • produkt
                </p>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- MOŻLIWOŚCI -->
    <!-- ================================================= -->

    <section
      class="bg-slate-950 py-24 text-white"
    >

      <div class="container mx-auto px-4">

        <div
          class="mb-16 max-w-4xl"
        >

          <span
            class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-400"
          >
            Interaktywna analiza
          </span>


          <h2
            class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
          >
            Co daje dobrze zaprojektowany dashboard?
          </h2>


          <p
            class="text-lg leading-relaxed text-slate-400 md:text-xl"
          >
            Celem nie jest umieszczenie jak największej
            liczby wykresów na jednej stronie,
            ale skrócenie drogi od danych do decyzji.
          </p>

        </div>


        <div
          class="grid gap-6 md:grid-cols-2 xl:grid-cols-3"
        >

          {
            benefits.map((item) => (

              <article
                class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-7 transition-all hover:-translate-y-1 hover:border-green-500/50 hover:bg-white/[0.08]"
              >

                <div
                  class="mb-7 flex h-14 w-14 items-center justify-center rounded-2xl bg-green-500/10 text-green-400"
                >
                  <i
                    class={`${item.icon} text-xl`}
                    aria-hidden="true"
                  ></i>
                </div>


                <h3
                  class="mb-4 text-2xl font-black"
                >
                  {item.title}
                </h3>


                <p
                  class="text-sm leading-relaxed text-slate-400"
                >
                  {item.description}
                </p>

              </article>

            ))
          }

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- OBSZARY -->
    <!-- ================================================= -->

    <section
      class="bg-white py-24 text-slate-950"
    >

      <div class="container mx-auto px-4">

        <div
          class="mb-16 max-w-4xl"
        >

          <span
            class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
          >
            Dashboardy dla różnych działów
          </span>


          <h2
            class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
          >
            Jakie KPI możemy pokazać w Power BI?
          </h2>


          <p
            class="text-lg leading-relaxed text-slate-600 md:text-xl"
          >
            Wskaźniki zawsze dobieramy do konkretnego procesu
            i danych dostępnych w firmie.
          </p>

        </div>


        <div
          class="grid gap-6 md:grid-cols-2 xl:grid-cols-3"
        >

          {
            areas.map((area) => (

              <article
                class="rounded-[2rem] border border-slate-200 bg-slate-50 p-7"
              >

                <h3
                  class="mb-6 text-2xl font-black text-slate-950"
                >
                  {area.title}
                </h3>


                <ul
                  class="space-y-3"
                >

                  {
                    area.items.map((item) => (

                      <li
                        class="flex items-start gap-3 text-sm leading-relaxed text-slate-600"
                      >
                        <span
                          class="mt-1 font-black text-green-600"
                        >
                          ✓
                        </span>

                        {item}
                      </li>

                    ))
                  }

                </ul>

              </article>

            ))
          }

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- HIERARCHIA -->
    <!-- ================================================= -->

    <section
      class="bg-slate-50 py-24 text-slate-950"
    >

      <div
        class="container mx-auto px-4"
      >

        <div
          class="grid gap-16 lg:grid-cols-2 lg:items-center"
        >

          <div>

            <span
              class="mb-4 inline-block text-xs font-black uppercase tracking-[0.22em] text-green-600"
            >
              Projektowanie dashboardu
            </span>


            <h2
              class="mb-6 text-4xl font-black tracking-tighter md:text-6xl"
            >
              Od KPI do szczegółowej transakcji.
            </h2>


            <p
              class="mb-6 text-lg leading-relaxed text-slate-600"
            >
              Zarząd może potrzebować jednego wskaźnika,
              kierownik informacji o konkretnym regionie,
              a analityk szczegółowych danych o transakcjach.
            </p>


            <p
              class="text-lg leading-relaxed text-slate-600"
            >
              Dlatego projektujemy dashboard tak,
              aby użytkownik mógł rozpocząć od obrazu ogólnego,
              a później przejść do potrzebnego poziomu szczegółowości.
            </p>

          </div>


          <div
            class="space-y-4"
          >

            <div
              class="rounded-2xl bg-slate-950 p-6 text-white"
            >
              <span
                class="text-xs font-black uppercase tracking-wider text-green-400"
              >
                Poziom 1
              </span>

              <h3 class="mt-2 text-xl font-black">
                KPI
              </h3>

              <p class="mt-2 text-sm text-slate-400">
                Czy wynik jest zgodny z planem?
              </p>
            </div>


            <div
              class="ml-6 rounded-2xl border border-slate-200 bg-white p-6"
            >
              <span
                class="text-xs font-black uppercase tracking-wider text-green-600"
              >
                Poziom 2
              </span>

              <h3 class="mt-2 text-xl font-black">
                Analiza
              </h3>

              <p class="mt-2 text-sm text-slate-600">
                Który region, produkt lub klient odpowiada za zmianę?
              </p>
            </div>


            <div
              class="ml-12 rounded-2xl border border-slate-200 bg-white p-6"
            >
              <span
                class="text-xs font-black uppercase tracking-wider text-green-600"
              >
                Poziom 3
              </span>

              <h3 class="mt-2 text-xl font-black">
                Szczegóły
              </h3>

              <p class="mt-2 text-sm text-slate-600">
