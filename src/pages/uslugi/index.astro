function prettifyTitle(slug: string) {
  return slug
    .replaceAll("-", " ")
    .replace(/\b\w/g, (letter) =>
      letter.toUpperCase()
    );
}


/*
|--------------------------------------------------------------------------
| AUTOMATYCZNA LISTA ISTNIEJĄCYCH USŁUG
|--------------------------------------------------------------------------
*/

const allServices: ServiceItem[] =
  Object.entries(serviceModules)

    .filter(
      ([path]) =>
        path !== "./index.astro" &&
        !path.endsWith("/index.astro")
    )

    .map(([path, module]) => {

      const slug =
        path
          .split("/")
          .pop()
          ?.replace(".astro", "") ?? "";

      const meta =
        ((module as { service?: ServiceMeta }).service ??
          {}) as ServiceMeta;

      return {
        slug,

        href:
          `/uslugi/${slug}/`,

        title:
          serviceTitleOverrides[slug] ??
          meta.title ??
          prettifyTitle(slug),

        order:
          typeof meta.order === "number"
            ? meta.order
            : 999,

        menu:
          meta.menu ?? true,

        description:
          serviceDescriptions[slug] ??
          meta.description ??
          "Opisz proces, a dobierzemy możliwie proste rozwiązanie.",

        category:
          serviceCategoryOverrides[slug] ??
          meta.category ??
          meta.group ??
          "Automatyzacja",
      };
    })

    .filter(
      (service) =>
        service.menu !== false
    )

    .sort(
      (a, b) =>
        a.order - b.order ||
        a.title.localeCompare(
          b.title,
          "pl"
        )
    );


function findService(
  ...slugs: string[]
): ServiceItem | undefined {

  return allServices.find(
    (service) =>
      slugs.includes(service.slug)
  );

}


/*
