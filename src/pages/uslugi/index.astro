---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

const pageTitle =
  "Usługi automatyzacji danych dla firm | Excel, Power BI, Python, API i KSeF";
const pageDescription =
  "Automatyzujemy pracę z danymi: arkusze Excel, Power BI, KSeF do Excela, kalkulatory ofertowe, skrypty Python, integracje API i aplikacje dla firm.";
const ogImage = "/biuro3.webp";
const currentUrl = "https://raporty24.pl/uslugi/";

type ServiceMeta = {
  title?: string;
  order?: number;
  menu?: boolean;
  category?: string;
  group?: string;
  description?: string;
};

const serviceModules = import.meta.glob("./*.astro", { eager: true });

const allServices = Object.entries(serviceModules)
  .filter(([path]) => path !== "./index.astro" && !path.endsWith("/index.astro"))
  .map(([path, module]) => {
    const slug = path.split("/").pop()?.replace(".astro", "") ?? "";
    const meta = ((module as { service?: ServiceMeta }).service ?? {}) as ServiceMeta;

    return {
      slug,
      href: `/uslugi/${slug}/`,
      title: meta.title ?? slug.replaceAll("-", " "),
      order: typeof meta.order === "number" ? meta.order : 999,
      menu: meta.menu ?? true,
      description: meta.description ?? "",
      category: meta.category ?? meta.group ?? "Pozostałe",
    };
  })
  .filter((service) => service.menu !== false)
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const featuredServices = [
  {
    title: "Arkusze Excel",
    description:
      "Arkusze Excel na zamówienie, makra VBA, Power Query, formularze, kalkulatory i automatyzacje raportów.",
    href: "/uslugi/excel-na-zamowienie/",
    icon: "fas fa-file-excel",
  },
  {
    title: "KSeF do Excela",
    description:
      "Pobieranie faktur z KSeF, eksport do Excel, CSV i XML oraz porządkowanie danych dla księgowości.",
    href: "/uslugi/ksef-do-excela/",
    icon: "fas fa-file-invoice",
  },
  {
    title: "Kalkulatory ofertowe",
    description:
      "Kalkulatory produktowe, konfiguratory, formularze zamówień B2B i automatyczne wyceny.",
    href: "/uslugi/kalkulatory-produktowe/",
    icon: "fas fa-calculator",
  },
  {
    title: "Skrypty Python",
    description:
      "Automatyzacja pracy z plikami, raportami, eksportami danych i aplikacjami desktopowymi.",
    href: "/uslugi/skrypty-python/",
    icon: "fas fa-code",
  },
  {
    title: "Integracje API",
    description:
      "Pobieranie danych z systemów, połączenia CRM, ERP, sklepów, raportów i aplikacji firmowych.",
    href: "/uslugi/integracje-api/",
    icon: "fas fa-plug",
  },
  {
    title: "Dashboardy Power BI",
    description:
      "Raporty zarządcze, KPI, sprzedaż, koszty, flota i wyniki firmy w czytelnych dashboardach.",
    href: "/uslugi/dashboardy-power-bi/",
    icon: "fas fa-chart-pie",
  },
];

const problemCards = [
  {
    title: "Za dużo ręcznej pracy w Excelu",
    description:
      "Jeśli zespół kopiuje dane, skleja raporty i poprawia pliki ręcznie, zwykle można to skrócić do kilku kliknięć.",
    icon: "fas fa-clock",
  },
  {
    title: "Dane są w wielu systemach",
    description:
      "Łączymy dane z plików, API, systemów sprzedażowych, księgowych, magazynowych i raportowych.",
    icon: "fas fa-database",
  },
  {
    title: "Wyceny i raporty mają błędy",
    description:
      "Budujemy kalkulatory, walidacje, szablony, eksporty i procesy, które ograniczają pomyłki oraz chaos w danych.",
    icon: "fas fa-check-circle",
  },
];

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Usługi Raporty24",
  itemListElement: allServices.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `https://raporty24.pl${service.href}`,
    name: service.title,
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={ogImage} url={currentUrl}>
  <div x-data="app" x-cloak>
    <Header />

    <main class="pt-20">
      <section class="relative overflow-hidden bg-slate-950 py-24 text-white lg:py-36">
        <div class="absolute inset-0 opacity-20">
          <div
            class="absolute inset-0 bg-[radial-gradient(#1e293b_1.5px,transparent_1.5px)] [background-size:32px_32px]"
          >
          </div>
        </div>

        <div class="absolute -right-24 top-0 h-96 w-96 rounded-full bg-green-600/10 blur-[120px]"></div>
        <div class="absolute -left-24 bottom-0 h-96 w-96 rounded-full bg-cyan-500/10 blur-[120px]"></div>

        <div class="container relative z-10 mx-auto px-4">
          <div class="max-w-5xl">
            <span
              class="mb-8 inline-block rounded-full border border-green-500/20 bg-green-500/10 px-4 py-2 text-[10px] font-black uppercase tracking-[0.3em] text-green-400"
            >
              Katalog usług
            </span>

            <h1 class="mb-8 text-5xl font-black uppercase leading-[0.95] tracking-tighter md:text-8xl">
              Automatyzacja danych
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-green-600">
                dla firm.
              </span>
            </h1>

            <p class="mb-12 max-w-3xl text-xl font-medium leading-relaxed text-slate-400 md:text-2xl">
              Tworzymy narzędzia w Excelu, Power BI, Pythonie i API: automatyzacje raportów,
              KSeF do Excela, kalkulatory ofertowe, integracje i aplikacje desktopowe.
            </p>

            <div class="flex flex-col gap-4 sm:flex-row">
              <a
                href="#najczesciej"
                class="inline-flex items-center justify-center gap-3 rounded-2xl bg-green-600 px-8 py-5 text-sm font-black uppercase tracking-widest text-white transition-all hover:-translate-y-1 hover:bg-green-500"
              >
                Zobacz usługi
                <i class="fas fa-arrow-right text-xs"></i>
              </a>

              <a
                href="#kontakt"
                class="inline-flex items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/10 px-8 py-5 text-sm font-black uppercase tracking-widest text-white transition-all hover:-translate-y-1 hover:bg-white hover:text-slate-950"
              >
                Zapytaj o wycenę
              </a>
            </div>
          </div>
        </div>
      </section>

      <section id="najczesciej" class="bg-white py-24 text-slate-950">
        <div class="container mx-auto px-4">
          <div class="mb-16 max-w-4xl">
            <span class="mb-4 inline-block text-xs font-black uppercase tracking-[0.25em] text-green-600">
              Najczęściej wybierane
            </span>

            <h2 class="mb-6 text-4xl font-black uppercase tracking-tighter md:text-6xl">
              Usługi, które zdejmują ręczną pracę z firmy
            </h2>

            <p class="text-lg font-medium leading-relaxed text-slate-600 md:text-xl">
              Zaczynamy od konkretnego problemu: raporty, pliki, dane z systemów, faktury,
              wyceny, dashboardy albo powtarzalny proces, który zabiera czas zespołowi.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {
              featuredServices.map((service) => (
                <a
                  href={service.href}
                  class="group flex min-h-[310px] flex-col rounded-[2.5rem] border border-slate-100 bg-slate-50 p-8 transition-all hover:-translate-y-1 hover:border-green-500/40 hover:bg-white hover:shadow-2xl"
                >
                  <div class="mb-7 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-950 text-green-400 transition-all group-hover:bg-green-600 group-hover:text-white">
                    <i class={`${service.icon} text-xl`}></i>
                  </div>

                  <h3 class="mb-4 text-2xl font-black uppercase leading-tight tracking-tight text-slate-950">
                    {service.title}
                  </h3>

                  <p class="mb-8 flex-1 text-sm font-medium leading-relaxed text-slate-600">
                    {service.description}
                  </p>

                  <span class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-slate-950 transition-colors group-hover:text-green-600">
                    Zobacz szczegóły
                    <i class="fas fa-chevron-right text-[10px]"></i>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-slate-950 py-24 text-white">
        <div class="container mx-auto px-4">
          <div class="mb-16 max-w-4xl">
            <span class="mb-4 inline-block text-xs font-black uppercase tracking-[0.25em] text-green-400">
              Kiedy warto się odezwać?
            </span>

            <h2 class="mb-6 text-4xl font-black uppercase tracking-tighter md:text-6xl">
              Gdy dane blokują pracę zamiast ją przyspieszać
            </h2>

            <p class="text-lg font-medium leading-relaxed text-slate-400 md:text-xl">
              Nie trzeba od razu budować dużego systemu. Czasem wystarczy dobry arkusz,
              skrypt, integracja albo mała aplikacja, która porządkuje jeden ważny proces.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {
              problemCards.map((item) => (
                <article class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-8 transition-all hover:-translate-y-1 hover:border-green-500/50 hover:bg-white/[0.08]">
                  <div class="mb-7 flex h-14 w-14 items-center justify-center rounded-2xl bg-green-500/10 text-green-400">
                    <i class={`${item.icon} text-xl`}></i>
                  </div>

                  <h3 class="mb-4 text-2xl font-black uppercase leading-tight tracking-tight text-white">
                    {item.title}
                  </h3>

                  <p class="text-sm font-medium leading-relaxed text-slate-400">
                    {item.description}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="wszystkie" class="bg-white py-24 text-slate-950">
        <div class="container mx-auto px-4">
          <div class="mb-16 max-w-4xl">
            <span class="mb-4 inline-block text-xs font-black uppercase tracking-[0.25em] text-green-600">
              Pełna lista
            </span>

            <h2 class="mb-6 text-4xl font-black uppercase tracking-tighter md:text-6xl">
              Wszystkie usługi
            </h2>

            <p class="text-lg font-medium leading-relaxed text-slate-600 md:text-xl">
              Poniżej znajdziesz pełny katalog podstron usługowych. Każda z nich opisuje
              konkretny typ wdrożenia, przykłady zastosowań i sposób pracy.
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {
              allServices.map((service) => (
                <a
                  href={service.href}
                  class="group flex min-h-[210px] flex-col rounded-2xl border border-slate-100 bg-slate-50 p-6 transition-all hover:-translate-y-1 hover:border-green-500/40 hover:bg-white hover:shadow-xl"
                >
                  <div class="mb-3 text-[10px] font-black uppercase tracking-[0.25em] text-green-600">
                    {service.category}
                  </div>

                  <h3 class="mb-3 text-lg font-black uppercase leading-tight tracking-tight text-slate-950 group-hover:text-green-700">
                    {service.title}
                  </h3>

                  <p class="flex-1 text-xs font-medium leading-relaxed text-slate-500">
                    {service.description ||
                      "Szczegółowy zakres prac oraz przykłady zastosowań dla firm."}
                  </p>

                  <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-[10px] font-black uppercase tracking-[0.2em] text-green-600">
                    Szczegóły
                    <i class="fas fa-arrow-right text-[10px] transition-transform group-hover:translate-x-1"></i>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-slate-50 py-24 text-slate-950">
        <div class="container mx-auto px-4">
          <div class="rounded-[3rem] bg-slate-950 p-8 text-white md:p-14 lg:p-16">
            <div class="grid gap-10 lg:grid-cols-[1.4fr_0.8fr] lg:items-center">
              <div>
                <span class="mb-4 inline-block text-xs font-black uppercase tracking-[0.25em] text-green-400">
                  Nie wiesz, którą usługę wybrać?
                </span>

                <h2 class="mb-6 text-3xl font-black uppercase tracking-tighter md:text-5xl">
                  Opisz proces, a podpowiemy najlepsze rozwiązanie.
                </h2>

                <p class="max-w-3xl text-lg font-medium leading-relaxed text-slate-400">
                  Możesz wysłać opis problemu, screen arkusza, przykładowy raport albo listę
                  kroków, które dziś robicie ręcznie. Na tej podstawie ocenimy, czy lepszy
                  będzie Excel, Power BI, Python, API, KSeF, aplikacja desktopowa czy prostsze rozwiązanie.
                </p>
              </div>

              <div class="flex flex-col gap-4">
                <a
                  href="#kontakt"
                  class="inline-flex items-center justify-center gap-3 rounded-2xl bg-green-600 px-8 py-5 text-center text-sm font-black uppercase tracking-widest text-white transition-all hover:-translate-y-1 hover:bg-green-500"
                >
                  Zapytaj o wycenę
                  <i class="fas fa-arrow-right text-xs"></i>
                </a>

                <a
                  href="/realizacje/"
                  class="inline-flex items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/10 px-8 py-5 text-center text-sm font-black uppercase tracking-widest text-white transition-all hover:-translate-y-1 hover:bg-white hover:text-slate-950"
                >
                  Zobacz realizacje
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <Contact />
    </main>

    <Footer />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
</style>